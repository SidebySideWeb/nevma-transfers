{
  "name": "tem-platform",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test && node --test \"scripts/*.test.mjs\"",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:live": "node scripts/check-live-demo.mjs",
    "check:live:dry": "node scripts/check-live-demo.mjs --dry-run",
    "format": "prettier --write .",
    "db:types": "node scripts/db-types.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
