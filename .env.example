# TEM Protection - environment variables.
# Copy to .env (apps/web, apps/admin, apps/studio each read their own .env; see docs/ARCHITECTURE.md).
# Never commit real values. Never print them in logs or chat.

# --- Supabase (Postgres + Auth) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only (apps/web). Never in apps/admin browser code, never PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sanity (content only) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Read-only token if the dataset is private. Server/build only.
SANITY_READ_TOKEN=
# apps/studio uses these two names:
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# --- Viva (apps/web only) ---
# Smart Checkout API (OAuth2 client credentials): create orders, retrieve transactions.
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
# Payment source with the success URL /booking/confirmed and failure URL /booking/not-completed.
VIVA_SOURCE_CODE=
# Basic-auth credentials: webhook URL verification key and refunds.
VIVA_MERCHANT_ID=
VIVA_API_KEY=
# demo | live
VIVA_ENV=demo

# --- Email and spam protection ---
RESEND_API_KEY=
# For example "TEM Protection <bookings@your-domain>". Domain must be verified in Resend.
RESEND_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# --- Admin -> web signed calls (refunds). Same value in apps/web and apps/admin. ---
ADMIN_TO_WEB_SIGNING_SECRET=

# --- Vercel Cron (apps/web /api/cron/*). Long random string. ---
CRON_SECRET=

# --- Launch switch. false hides "Book now" and closes /api/holds (503) until the Viva live account is approved. ---
PUBLIC_BOOKING_OPEN=false

# --- Site ---
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_ADMIN_URL=http://localhost:4322
