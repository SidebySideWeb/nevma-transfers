# Elite Protection - environment variables.
# Copy to .env (apps/web, apps/admin, apps/studio each read their own .env; see docs/ARCHITECTURE.md).
# Never commit real values. Never print them in logs or chat.

# --- Supabase (Postgres + Auth) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only (apps/web). Never in apps/admin browser code, never PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sanity (content only) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Read-only token if the dataset is private. Server/build only.
SANITY_READ_TOKEN=
# Kit 2: Editor robot token for form submissions. apps/web server only.
SANITY_WRITE_TOKEN=
# Kit 2: Studio host for links in office emails, for example https://tem-protection.sanity.studio
PUBLIC_STUDIO_URL=
# Admin fleet class page: Open in Sanity Studio (falls back to PUBLIC_STUDIO_URL)
PUBLIC_SANITY_STUDIO_URL=
# apps/studio uses these two names:
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# --- Viva (apps/web only) ---
# Smart Checkout API (OAuth2 client credentials): create orders, retrieve transactions.
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
# Payment source with the success URL /booking/confirmed and failure URL /booking/not-completed.
VIVA_SOURCE_CODE=
# Basic-auth credentials: webhook URL verification key and refunds.
VIVA_MERCHANT_ID=
VIVA_API_KEY=
# demo | live
VIVA_ENV=demo

# --- Email and spam protection ---
RESEND_API_KEY=
# For example "Elite Protection <bookings@your-domain>". Domain must be verified in Resend.
RESEND_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
# Injected into HTML by the server (not PUBLIC_ — avoids bundling into the client env).
TURNSTILE_SITE_KEY=

# --- Admin -> web signed calls (refunds). Same value in apps/web and apps/admin. ---
ADMIN_TO_WEB_SIGNING_SECRET=

# --- Vercel Cron (apps/web /api/cron/*). Long random string. ---
CRON_SECRET=

# --- Kit 2: tem-web deploy hook, called by apps/admin (server) after price changes so "From" prices stay current. ---
TEM_WEB_DEPLOY_HOOK_URL=

# --- Launch switch. false hides "Book now" and closes /api/holds (503) until the Viva live account is approved. ---
PUBLIC_BOOKING_OPEN=false

# --- Feature switches (@tem/features, docs/FEATURES.md, docs/BOOKING-V2-PLAN.md §2).
# Exact string "true" turns a switch on; missing or any other value means off. ---

# Pricing
PRICING_MODE=zones
# zones | distance | hybrid. Default zones (today's behaviour). Unknown values fall back to zones.
FEATURE_DISTANCE_PRICING=false
# Needs GOOGLE_MAPS_SERVER_KEY + QUOTE_SIGNING_SECRET. Enables distance/hybrid pricing and Pricing v2 admin.
FEATURE_DEMAND_PRICING=false
# Needs distance pricing. Optional demand factor with a cap.
SERVICE_AREA=attica
# Polygon name under packages/geo/areas/ (B2). Default attica.

# Booking flow
FEATURE_PLACES=false
# Formal switch for address autocomplete (also needs GOOGLE_PLACES_API_KEY / PUBLIC_ADDRESS_AUTOCOMPLETE).
FEATURE_RETURN_TRIP=false
# Linked outbound + return bookings, optional return discount.
FEATURE_FLIGHT_TRACKING=false
# Needs FLIGHT_PROVIDER (manual needs no key; aerodatabox/flightaware need FLIGHT_PROVIDER_KEY).
FEATURE_CORPORATE=false
# Company accounts, negotiated prices, pay on account.
FEATURE_DRIVERS=false
# Drivers / dispatch (docs/DRIVERS.md). Drivers/Reports nav, /api/driver/v1, trip status, statements.

# Contact
FEATURE_WHATSAPP=false
# Site/email WhatsApp CTAs. Needs WHATSAPP_NUMBER as international digits only.
WHATSAPP_NUMBER=

# Keys (server only; never PUBLIC_)
GOOGLE_MAPS_SERVER_KEY=
# Google Routes (and related Maps) for distance pricing. Never log.
QUOTE_SIGNING_SECRET=
# HMAC for fixed quotes (B3). Never log.
FLIGHT_PROVIDER=
# aerodatabox | flightaware | manual
FLIGHT_PROVIDER_KEY=
# Required for aerodatabox / flightaware. Not needed for manual.

# Drivers’ web app (only when FEATURE_DRIVERS=true)
DRIVER_APP_ORIGIN=http://localhost:5173
DRIVER_EARNINGS_VISIBLE=false
DRIVER_APP_URL=http://localhost:5173

# --- Address autocomplete (Google Places API (New)), docs/ADDRESS-AUTOCOMPLETE.md ---
# Server only (apps/web and apps/admin). Never PUBLIC_, never in browser code, never logged.
GOOGLE_PLACES_API_KEY=
PUBLIC_ADDRESS_AUTOCOMPLETE=false
PLACES_BIAS_LAT=37.9838
PLACES_BIAS_LNG=23.7275
PLACES_BIAS_RADIUS_M=50000

# --- Site ---
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_ADMIN_URL=http://localhost:4322
# Optional. When set on a Vercel deployment, HTTP Basic Auth locks tem-web and tem-admin (username ignored).
# Leave empty for an open site. Preview-only is typical; do not set on Production unless intentional.
# Set the same value on both Vercel projects (or only the one you want locked).
SITE_PASSWORD=
