---
import { actions } from 'astro:actions';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/admin.css';
import Banner from '../components/Banner.astro';
import { buildBanner } from '../lib/banner';
import { driversEnabled } from '../lib/drivers';
import { countNeedsVehicle } from '../lib/nav-count';
import {
  hasPricesChanged,
  rebuildCooldownRemainingMs,
} from '../lib/price-update-cookies';
import { createSupabaseServerClient } from '../lib/supabase';

interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  title: string;
  current?: string;
  staffEmail?: string;
  crumbs?: Crumb[];
  htmlTitle?: string;
}

const {
  title,
  current = 'bookings',
  staffEmail,
  crumbs = [],
  htmlTitle = `${title} - Elite Protection Admin`,
} = Astro.props;

const supabase = createSupabaseServerClient(Astro.cookies);
const [banner, needsVehicle] = await Promise.all([
  buildBanner(supabase),
  countNeedsVehicle(supabase),
]);
const bannerText = banner.text;
const bannerHref = banner.href;

const pricesChanged = hasPricesChanged(Astro.cookies);
const cooldownMs = rebuildCooldownRemainingMs(Astro.cookies);
const rebuildDisabled = cooldownMs > 0;
const cooldownSeconds = Math.ceil(cooldownMs / 1000);
const rebuildError =
  Astro.getActionResult?.(actions.requestWebsiteRebuild)?.error?.message ?? null;

const showDrivers = driversEnabled();

type NavItem = { href: string; id: string; label: string; count?: number };
type NavGroup = { id: string; label: string; items: NavItem[] };

const operationsItems: NavItem[] = [
  ...(showDrivers ? [{ href: '/today', id: 'today', label: 'Today' }] : []),
  { href: '/bookings', id: 'bookings', label: 'Bookings', count: needsVehicle },
  { href: '/calendar', id: 'calendar', label: 'Fleet calendar' },
  { href: '/customers', id: 'customers', label: 'Customers' },
  { href: '/blocked-slots', id: 'blocked-slots', label: 'Blocked slots' },
];

const groups: NavGroup[] = [
  { id: 'operations', label: 'Operations', items: operationsItems },
  ...(showDrivers
    ? [
        {
          id: 'drivers',
          label: 'Drivers',
          items: [
            { href: '/drivers', id: 'drivers', label: 'Drivers' },
            { href: '/reports', id: 'reports', label: 'Reports' },
          ],
        },
      ]
    : []),
  {
    id: 'pricing',
    label: 'Pricing',
    items: [
      { href: '/prices', id: 'prices', label: 'Zone prices' },
      { href: '/hourly-rates', id: 'hourly-rates', label: 'Hourly rates' },
      { href: '/extras', id: 'extras', label: 'Extras' },
    ],
  },
  {
    id: 'setup',
    label: 'Setup',
    items: [
      { href: '/fleet', id: 'fleet', label: 'Fleet' },
      { href: '/zones', id: 'zones', label: 'Zones' },
      { href: '/settings', id: 'settings', label: 'Settings' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{htmlTitle}</title>
    <link rel="preload" href="/fonts/jost-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/playfair-display-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="ep-admin">
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="sidebar">
        <div class="nav-toggle">
          <a class="brand" href="/bookings">
            <span class="brand-mark" aria-hidden="true">EP</span>
            <span class="brand-name">Elite Protection<small>Office</small></span>
          </a>
          <button
            class="menu-btn"
            type="button"
            id="menu-btn"
            aria-expanded="false"
            aria-controls="adminnav"
          >
            Menu
          </button>
        </div>
        <nav class="navlist" id="adminnav" aria-label="Admin">
          {
            groups.map((g) => (
              <>
                <p class="nav-label" id={`g-${g.id}`}>
                  {g.label}
                </p>
                <ul class="nav-group" aria-labelledby={`g-${g.id}`}>
                  {g.items.map((item) => (
                    <li>
                      <a href={item.href} aria-current={current === item.id ? 'page' : undefined}>
                        <span>{item.label}</span>
                        {item.count != null && item.count > 0 ? (
                          <span class="nav-count" aria-label={`${item.count} need a vehicle`}>
                            {item.count}
                          </span>
                        ) : null}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ))
          }
        </nav>
        <div class="sidebar-foot">
          {staffEmail && <span class="who">{staffEmail}</span>}
          <form method="POST" action="/logout">
            <button class="btn btn-quiet btn-sm" type="submit">Sign out</button>
          </form>
        </div>
      </header>
      <main class="main" id="main">
        {
          bannerText && (
            <Banner tone="warning" tag="Checks">
              {bannerText}
              <a class="btn btn-secondary btn-sm" slot="action" href={bannerHref}>
                Review
              </a>
            </Banner>
          )
        }
        {
          (pricesChanged || rebuildDisabled || rebuildError) && (
            <Banner tone="info" tag="Website" role="status">
              {
                pricesChanged
                  ? 'Prices changed: update the website'
                  : 'Update the website'
              }
              {
                rebuildError ? (
                  <span class="muted"> — {rebuildError}</span>
                ) : rebuildDisabled ? (
                  <span class="muted">
                    {' '}
                    — Rebuild requested. You can request again in {cooldownSeconds}s.
                  </span>
                ) : null
              }
              <form method="POST" action={actions.requestWebsiteRebuild} slot="action">
                <button
                  class="btn btn-secondary btn-sm"
                  type="submit"
                  disabled={rebuildDisabled}
                >
                  Update the website
                </button>
              </form>
            </Banner>
          )
        }
        <div class="page-head">
          <div>
            {
              crumbs.length > 0 && (
                <p class="crumbs">
                  {crumbs.map((c, i) => (
                    <>
                      {i > 0 && ' / '}
                      {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
                    </>
                  ))}
                </p>
              )
            }
            <h1 class="title">{title}</h1>
          </div>
          <div class="page-actions">
            <slot name="actions" />
          </div>
        </div>
        <slot />
      </main>
    </div>
    <script is:inline>
      (function () {
        const btn = document.getElementById('menu-btn');
        const nav = document.getElementById('adminnav');
        if (!btn || !nav) return;
        btn.addEventListener('click', function () {
          const open = nav.classList.toggle('open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      })();
    </script>
    <script>
      import '../scripts/enhance-selects';
    </script>
  </body>
</html>
