---
import { actions } from 'astro:actions';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/admin.css';
import Banner from '../components/Banner.astro';
import ChecksBanner from '../components/ChecksBanner.astro';
import PageHeader from '../components/PageHeader.astro';
import { buildBanner } from '../lib/banner';
import { buildAdminNav } from '../lib/nav';
import { countNeedsVehicle } from '../lib/nav-count';
import {
  hasPricesChanged,
  rebuildCooldownRemainingMs,
} from '../lib/price-update-cookies';
import { createSupabaseServerClient } from '../lib/supabase';

interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  title: string;
  subtitle?: string;
  current?: string;
  staffEmail?: string;
  crumbs?: Crumb[];
  htmlTitle?: string;
}

const {
  title,
  subtitle,
  current = 'bookings',
  staffEmail,
  crumbs = [],
  htmlTitle = `${title} - Elite Protection Admin`,
} = Astro.props;

const supabase = createSupabaseServerClient(Astro.cookies);
const [banner, needsVehicle] = await Promise.all([
  buildBanner(supabase),
  countNeedsVehicle(supabase),
]);

const pricesChanged = hasPricesChanged(Astro.cookies);
const cooldownMs = rebuildCooldownRemainingMs(Astro.cookies);
const rebuildDisabled = cooldownMs > 0;
const cooldownSeconds = Math.ceil(cooldownMs / 1000);
const rebuildError =
  Astro.getActionResult?.(actions.requestWebsiteRebuild)?.error?.message ?? null;

const groups = buildAdminNav({ needsVehicle });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{htmlTitle}</title>
    <link rel="preload" href="/fonts/jost-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/playfair-display-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="ep-admin">
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="sidebar" id="admin-sidebar">
        <div class="nav-toggle">
          <a class="brand" href="/today">
            <span class="brand-mark" aria-hidden="true">EP</span>
            <span class="brand-name">Elite Protection<small>Office</small></span>
          </a>
          <button
            class="menu-btn"
            type="button"
            id="menu-btn"
            aria-expanded="false"
            aria-controls="adminnav-drawer"
          >
            Menu
          </button>
        </div>
        <div
          class="nav-backdrop"
          id="nav-backdrop"
          hidden
          tabindex="-1"
          aria-hidden="true"
        ></div>
        <div class="nav-drawer" id="adminnav-drawer">
          <nav class="navlist" id="adminnav" aria-label="Admin">
            {
              groups.map((g) => (
                <>
                  <p class="nav-label" id={`g-${g.id}`}>
                    {g.label}
                  </p>
                  <ul class="nav-group" aria-labelledby={`g-${g.id}`}>
                    {g.items.map((item) => (
                      <li>
                        <a href={item.href} aria-current={current === item.id ? 'page' : undefined}>
                          <span>{item.label}</span>
                          {item.count != null && item.count > 0 ? (
                            <span class="nav-count" aria-label={`${item.count} need a vehicle`}>
                              {item.count}
                            </span>
                          ) : null}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ))
            }
          </nav>
          <div class="sidebar-foot">
            {staffEmail && (
              <span class="who" title={staffEmail}>
                {staffEmail}
              </span>
            )}
            <form method="POST" action="/logout">
              <button class="btn btn-quiet btn-sm" type="submit">Sign out</button>
            </form>
          </div>
        </div>
      </header>
      <main class="main" id="main">
        <ChecksBanner banner={banner} />
        {
          (pricesChanged || rebuildDisabled || rebuildError) && (
            <Banner tone="info" tag="Website" role="status">
              {
                pricesChanged
                  ? 'Prices changed: update the website'
                  : 'Update the website'
              }
              {
                rebuildError ? (
                  <span class="muted"> — {rebuildError}</span>
                ) : rebuildDisabled ? (
                  <span class="muted">
                    {' '}
                    — Rebuild requested. You can request again in {cooldownSeconds}s.
                  </span>
                ) : null
              }
              <form method="POST" action={actions.requestWebsiteRebuild} slot="action">
                <button
                  class="btn btn-secondary btn-sm"
                  type="submit"
                  disabled={rebuildDisabled}
                >
                  Update the website
                </button>
              </form>
            </Banner>
          )
        }
        <PageHeader title={title} subtitle={subtitle} crumbs={crumbs}>
          <slot name="actions" slot="actions" />
        </PageHeader>
        <slot />
      </main>
    </div>
    <script is:inline>
      (function () {
        const btn = document.getElementById('menu-btn');
        const drawer = document.getElementById('adminnav-drawer');
        const backdrop = document.getElementById('nav-backdrop');
        const sidebar = document.getElementById('admin-sidebar');
        if (!btn || !drawer) return;

        function setOpen(open) {
          drawer.classList.toggle('open', open);
          if (sidebar) sidebar.classList.toggle('nav-open', open);
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (backdrop) {
            backdrop.hidden = !open;
            backdrop.setAttribute('aria-hidden', open ? 'false' : 'true');
          }
          document.documentElement.classList.toggle('nav-drawer-open', open);
          if (open) {
            const first = drawer.querySelector('a, button');
            if (first) first.focus();
          } else {
            btn.focus();
          }
        }

        btn.addEventListener('click', function () {
          setOpen(!drawer.classList.contains('open'));
        });
        if (backdrop) {
          backdrop.addEventListener('click', function () {
            setOpen(false);
          });
        }
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && drawer.classList.contains('open')) {
            e.preventDefault();
            setOpen(false);
          }
        });
        drawer.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', function () {
            if (window.matchMedia('(max-width: 767px)').matches) setOpen(false);
          });
        });
      })();
    </script>
    <script>
      import '../scripts/enhance-selects';
      import '../scripts/live-filters';
      import '../scripts/dialogs';
    </script>
  </body>
</html>
