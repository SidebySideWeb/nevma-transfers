---
import PaymentBadge from './PaymentBadge.astro';
import { statusClass, statusWord, type BookingStatus } from './status';

interface Props {
  status: BookingStatus | string;
  /** Payment statuses: unpaid → Pending, paid, refunded, failed. */
  kind?: 'booking' | 'payment';
}

const { status: raw, kind = 'booking' } = Astro.props;
---

{
  kind === 'payment' ? (
    <PaymentBadge status={raw} />
  ) : (
    <span
      class={`badge ${statusClass(
        (['pending', 'confirmed', 'assigned', 'completed', 'cancelled', 'expired'].includes(raw)
          ? raw
          : 'pending') as BookingStatus,
      )}`}
    >
      {statusWord(
        (['pending', 'confirmed', 'assigned', 'completed', 'cancelled', 'expired'].includes(raw)
          ? raw
          : 'pending') as BookingStatus,
      )}
    </span>
  )
}
