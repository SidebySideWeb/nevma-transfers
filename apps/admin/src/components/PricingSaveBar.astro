---
interface Props {
  formId: string;
  dirtyLabel?: string;
}
const { formId, dirtyLabel = 'Unsaved changes' } = Astro.props;
---

<div class="pricing-save" id="pricing-save-bar" hidden data-form={formId}>
  <span id="pricing-dirty-count">{dirtyLabel}</span>
  <div class="pricing-save-actions">
    <button class="btn btn-secondary" type="button" id="pricing-discard">Discard</button>
    <button class="btn" type="submit" form={formId} id="pricing-save">Save</button>
  </div>
</div>

<style is:global>
  .pricing-save {
    position: sticky;
    bottom: 1rem;
    z-index: 20;
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-accent);
    background: var(--color-surface);
    box-shadow: var(--shadow-2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .pricing-save-actions {
    display: flex;
    gap: 0.5rem;
  }
</style>

<script is:inline>
  (function () {
    const bar = document.getElementById('pricing-save-bar');
    if (!bar) return;
    const formId = bar.getAttribute('data-form');
    const form = formId ? document.getElementById(formId) : null;
    if (!form) return;
    const discard = document.getElementById('pricing-discard');
    // Rates / hourly pages keep editable values in unnamed inputs and pack them into
    // rowsJson on submit — FormData alone never sees those edits.
    const fieldValue = (el) => {
      if (el instanceof HTMLInputElement) {
        if (el.type === 'checkbox' || el.type === 'radio') return el.checked ? '1' : '0';
        return el.value;
      }
      if (el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement) return el.value;
      return '';
    };
    const snapshotFields = () => {
      /** @type {Map<string, string>} */
      const map = new Map();
      form.querySelectorAll('input, select, textarea').forEach((el, i) => {
        if (!(el instanceof HTMLElement) || el.disabled) return;
        if (el instanceof HTMLInputElement && (el.type === 'hidden' || el.type === 'submit' || el.type === 'button'))
          return;
        const key = el.getAttribute('name') || el.id || `i${i}`;
        map.set(key, fieldValue(el));
      });
      return map;
    };
    let initial = snapshotFields();
    const snap = () => {
      const now = snapshotFields();
      if (now.size !== initial.size) return true;
      for (const [k, v] of now) {
        if (initial.get(k) !== v) return true;
      }
      return false;
    };
    const refresh = () => {
      bar.hidden = !snap();
    };
    form.addEventListener('input', refresh);
    form.addEventListener('change', refresh);
    discard?.addEventListener('click', () => {
      form.reset();
      // reset() is sync for values; re-snapshot so the bar hides.
      initial = snapshotFields();
      refresh();
    });
    window.addEventListener('beforeunload', (e) => {
      if (!bar.hidden) {
        e.preventDefault();
        e.returnValue = '';
      }
    });
    refresh();
  })();
</script>