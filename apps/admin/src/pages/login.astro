---
export const prerender = false;

import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/admin.css';
import { createSupabaseServerClient } from '../lib/supabase';
import { assertLoginRateLimit } from '../lib/login-rate-limit';
import { getStaffSession, signOut } from '../lib/auth';
import { driversEnabled } from '../lib/drivers';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
Astro.response.headers.set('X-Frame-Options', 'DENY');

const existing = await getStaffSession(Astro.cookies);
if (existing) {
  return Astro.redirect(driversEnabled() ? '/today' : '/bookings');
}

let formError: string | null = null;
if (Astro.url.searchParams.get('error') === 'auth') {
  formError = 'Sign in failed. Check your email and password.';
}

if (Astro.request.method === 'POST') {
  const ip = Astro.clientAddress || 'unknown';
  if (!assertLoginRateLimit(ip)) {
    formError = 'Too many attempts. Try again in a minute.';
  } else {
    const data = await Astro.request.formData();
    const email = String(data.get('email') || '');
    const password = String(data.get('password') || '');
    const supabase = createSupabaseServerClient(Astro.cookies);
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) {
      formError = 'Sign in failed. Check your email and password.';
    } else {
      const staff = await getStaffSession(Astro.cookies);
      if (staff) {
        return Astro.redirect(driversEnabled() ? '/today' : '/bookings');
      }
      if (driversEnabled()) {
        const {
          data: { user },
        } = await supabase.auth.getUser();
        if (user) {
          const { data: driver } = await supabase
            .from('drivers')
            .select('id')
            .eq('user_id', user.id)
            .eq('active', true)
            .maybeSingle();
          if (driver) return Astro.redirect('/driver-welcome');
        }
      }
      await signOut(Astro.cookies);
      formError = 'Sign in failed. Check your email and password.';
    }
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sign in - Elite Protection Admin</title>
    <link rel="preload" href="/fonts/jost-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/playfair-display-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="ep-admin">
    <main class="login">
      <div class="login-card">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">EP</span>
          <span class="brand-name">Elite Protection<small>Office</small></span>
        </div>
        <h1 tabindex="-1">Sign in</h1>
        <p class="muted" style="margin:0 0 1.5rem">For Elite Protection staff only.</p>
        {
          formError && (
            <div class="banner banner-danger" role="alert">
              <p>{formError}</p>
            </div>
          )
        }
        <form method="post" class="stack-sm">
          <div class="field">
            <label for="email">Email</label>
            <input
              id="email"
              class="input"
              type="email"
              name="email"
              required
              autocomplete="username"
              aria-invalid={formError ? 'true' : undefined}
            />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input
              id="password"
              class="input"
              type="password"
              name="password"
              required
              autocomplete="current-password"
              aria-invalid={formError ? 'true' : undefined}
            />
          </div>
          <button class="btn" type="submit" style="width:100%;margin-top:.5rem">Sign in</button>
        </form>
        <p class="help" style="margin-top:1.25rem">
          Forgot your password? Ask the office manager to send a reset link.
        </p>
      </div>
    </main>
  </body>
</html>
