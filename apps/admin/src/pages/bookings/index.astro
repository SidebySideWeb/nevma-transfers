---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import Banner from '../../components/Banner.astro';
import ClassName from '../../components/ClassName.astro';
import DataTable from '../../components/DataTable.astro';
import DateField from '../../components/DateField.astro';
import EmptyState from '../../components/EmptyState.astro';
import Money from '../../components/Money.astro';
import Select from '../../components/Select.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { athensDay } from '../../lib/athens-day';
import {
  applyBookingsTab,
  BOOKINGS_TAB_LABEL,
  BOOKINGS_TABS,
  logListError,
  parseBookingsTab,
  resolveListLoad,
  type BookingsTab,
} from '../../lib/bookings-list';
import { createSupabaseServerClient } from '../../lib/supabase';
import { formatAthensShort } from '../../lib/time';

const staff = Astro.locals.staff!;
const supabase = createSupabaseServerClient(Astro.cookies);
const q = Astro.url.searchParams;

const tab = parseBookingsTab(q);
const from = q.get('from') || '';
const to = q.get('to') || '';
const type = q.get('type') || '';
const vipOnly = q.get('vip') === '1';
const hasReturn = q.get('return') === '1';
const invoice = q.get('invoice') || '';
const source = q.get('source') === 'online' || q.get('source') === 'office' ? q.get('source')! : '';
const page = Math.max(1, Number(q.get('page') || 1));
const pageSize = 50;
const nowIso = new Date().toISOString();
const invoices = ['not_required', 'requested', 'issued'] as const;

const selectCols = `
    reference, pickup_at, booking_type, duration_minutes, price_cents, status, payment_status,
    customer_name, trip_group_id, leg, pickup_shift_min, original_pickup_at, flight_status,
    from_zone:zones!bookings_from_zone_id_fkey(name),
    to_zone:zones!bookings_to_zone_id_fkey(name),
    class:vehicle_classes!bookings_class_id_fkey(key, name)
  `;

function baseListQuery() {
  return supabase.from('bookings').select(selectCols);
}

function baseCountQuery() {
  return supabase.from('bookings').select('id', { count: 'exact', head: true });
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any
function withExtraFilters(query: any) {
  let qy = query;
  if (from) qy = qy.gte('pickup_at', `${from}T00:00:00+02:00`);
  if (to) qy = qy.lte('pickup_at', `${to}T23:59:59+02:00`);
  if (type === 'transfer' || type === 'hourly') qy = qy.eq('booking_type', type);
  if (vipOnly) qy = qy.eq('vip_security', true);
  if (hasReturn) qy = qy.not('trip_group_id', 'is', null);
  if ((invoices as readonly string[]).includes(invoice)) {
    qy = qy.eq('invoice_status', invoice as (typeof invoices)[number]);
  }
  if (source === 'online' || source === 'office') qy = qy.eq('source', source);
  return qy;
}

const applied = applyBookingsTab(withExtraFilters(baseListQuery()), tab, nowIso);
const { data: rows, error } = await applied.query
  .order('pickup_at', { ascending: applied.ascending })
  .range((page - 1) * pageSize, page * pageSize - 1);

type BookingRow = {
  reference: string;
  pickup_at: string;
  booking_type: string;
  duration_minutes: number | null;
  price_cents: number;
  status: string;
  payment_status: string;
  customer_name: string;
  trip_group_id: string | null;
  leg: number | null;
  pickup_shift_min: number | null;
  original_pickup_at: string | null;
  flight_status: string | null;
  from_zone: { name?: string } | null;
  to_zone: { name?: string } | null;
  class: { key?: string; name?: string } | null;
};

function athensHmOnly(iso: string): string {
  return new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Athens',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).format(new Date(iso));
}

const load = resolveListLoad('bookings', rows as BookingRow[] | null, error);
if (!load.ok) logListError('bookings_list', error!.message);
const bookings: BookingRow[] = load.ok ? load.rows : [];
const listError = load.ok ? null : load.message;

async function countFor(t: BookingsTab): Promise<number> {
  const { query } = applyBookingsTab(withExtraFilters(baseCountQuery()), t, nowIso);
  const { count, error: countError } = await query;
  if (countError) {
    logListError('bookings_count', countError.message);
    return 0;
  }
  return count ?? 0;
}

const tabCounts = Object.fromEntries(
  await Promise.all(BOOKINGS_TABS.map(async (t) => [t, await countFor(t)] as const)),
) as Record<BookingsTab, number>;

const chips: { label: string; clear: string }[] = [];
if (from || to) {
  chips.push({
    label: [from || '…', to || '…'].join(' – '),
    clear: new URLSearchParams(
      [...q.entries()].filter(([k]) => k !== 'from' && k !== 'to'),
    ).toString(),
  });
}
if (vipOnly) {
  chips.push({
    label: 'VIP security only',
    clear: new URLSearchParams([...q.entries()].filter(([k]) => k !== 'vip')).toString(),
  });
}
if (hasReturn) {
  chips.push({
    label: 'Has return',
    clear: new URLSearchParams([...q.entries()].filter(([k]) => k !== 'return')).toString(),
  });
}
if (type) {
  chips.push({
    label: type === 'hourly' ? 'Hourly' : 'Transfer',
    clear: new URLSearchParams([...q.entries()].filter(([k]) => k !== 'type')).toString(),
  });
}
if (source) {
  chips.push({
    label: source === 'office' ? 'Office bookings' : 'Online bookings',
    clear: new URLSearchParams([...q.entries()].filter(([k]) => k !== 'source')).toString(),
  });
}
if (invoice) {
  chips.push({
    label: `Invoice ${invoice}`,
    clear: new URLSearchParams([...q.entries()].filter(([k]) => k !== 'invoice')).toString(),
  });
}

type Row = (typeof bookings)[number];
const groups: { key: string; label: string; rows: Row[] }[] = [];
for (const b of bookings) {
  const day = athensDay(b.pickup_at);
  const last = groups[groups.length - 1];
  if (!last || last.key !== day.key) {
    groups.push({ key: day.key, label: day.label, rows: [b] });
  } else {
    last.rows.push(b);
  }
}

function qs(overrides: Record<string, string | null>): string {
  const p = new URLSearchParams(q);
  for (const [k, v] of Object.entries(overrides)) {
    if (v === null) p.delete(k);
    else p.set(k, v);
  }
  // Prefer tab=; drop legacy keys so links stay clean.
  p.delete('status');
  p.delete('needs_vehicle');
  p.delete('page');
  const s = p.toString();
  return s ? `?${s}` : '?';
}
---

<AdminLayout title="Bookings" current="bookings" staffEmail={staff.email}>
  <div class="row" slot="actions">
    <a class="btn btn-secondary" href="/calendar">Fleet calendar</a>
    <a class="btn btn-secondary" href="/blocked-slots">Block a vehicle</a>
    <a class="btn" href="/bookings/new">New booking</a>
  </div>

  <nav class="tabs" aria-label="Quick views">
    {
      BOOKINGS_TABS.map((t) => (
        <a href={qs({ tab: t })} aria-current={tab === t ? 'page' : undefined}>
          {BOOKINGS_TAB_LABEL[t]} <span class="count">{tabCounts[t]}</span>
        </a>
      ))
    }
  </nav>

  <form class="filters" aria-label="Filters" method="get" data-live>
    <input type="hidden" name="tab" value={tab} />
    <div class="field">
      <label for="fr">From</label>
      <DateField id="fr" name="from" value={from} />
    </div>
    <div class="field">
      <label for="tt">To</label>
      <DateField id="tt" name="to" value={to} />
    </div>
    <div class="field">
      <label for="ty">Type</label>
      <Select
        id="ty"
        name="type"
        options={[
          { value: '', label: 'All types', selected: !type },
          { value: 'transfer', label: 'Transfer', selected: type === 'transfer' },
          { value: 'hourly', label: 'Hourly', selected: type === 'hourly' },
        ]}
      />
    </div>
    <div class="field">
      <label for="so">Source</label>
      <Select
        id="so"
        name="source"
        options={[
          { value: '', label: 'All', selected: !source },
          { value: 'online', label: 'Online', selected: source === 'online' },
          { value: 'office', label: 'Office', selected: source === 'office' },
        ]}
      />
    </div>
    <div class="field">
      <label for="iv">Invoice</label>
      <Select
        id="iv"
        name="invoice"
        options={[
          { value: '', label: 'Any', selected: !invoice },
          { value: 'requested', label: 'Requested', selected: invoice === 'requested' },
          { value: 'issued', label: 'Issued', selected: invoice === 'issued' },
        ]}
      />
    </div>
    <label class="check">
      <input type="checkbox" name="vip" value="1" checked={vipOnly} /> VIP security only
    </label>
    <label class="check">
      <input type="checkbox" name="return" value="1" checked={hasReturn} /> Has return
    </label>
    <div class="actions">
      <a class="btn btn-quiet btn-sm" href="/bookings">Clear</a>
    </div>
  </form>

  {
    chips.length > 0 && (
      <ul class="chips" aria-label="Active filters">
        {chips.map((c) => (
          <li class="chip">
            {c.label}{' '}
            <a href={c.clear ? `?${c.clear}` : '/bookings'} aria-label={`Remove filter: ${c.label}`}>
              ×
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    listError ? (
      <Banner tone="danger" role="alert">
        {listError}
      </Banner>
    ) : bookings.length === 0 ? (
      <EmptyState title="No bookings" actionHref="/bookings/new" actionLabel="New booking">
        No bookings match these filters.
      </EmptyState>
    ) : (
      <DataTable label="Bookings, sorted by pick-up time" cards>
        <caption class="sr-only">Bookings, sorted by pick-up time</caption>
        <thead>
          <tr>
            <th scope="col">Reference</th>
            <th scope="col" aria-sort={applied.ascending ? 'ascending' : 'descending'}>
              Pick-up
            </th>
            <th scope="col">Route</th>
            <th scope="col">Class</th>
            <th scope="col">Customer</th>
            <th scope="col" class="num">
              Total
            </th>
            <th scope="col">Payment</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {groups.map((g) => (
            <>
              <tr class="day-row">
                <td colspan="8">
                  {g.label} · {g.rows.length} booking{g.rows.length === 1 ? '' : 's'}
                </td>
              </tr>
              {g.rows.map((b) => {
                const fromName = (b.from_zone as { name?: string } | null)?.name;
                const toName = (b.to_zone as { name?: string } | null)?.name;
                const className = (b.class as { name?: string } | null)?.name;
                const trip =
                  b.booking_type === 'hourly'
                    ? `${fromName ?? '—'} · ${Math.round((b.duration_minutes || 0) / 60)} h`
                    : `${fromName ?? '—'} → ${toName ?? '—'}`;
                const sub = `${b.booking_type === 'hourly' ? 'Hourly' : 'Transfer'}`;
                return (
                  <tr
                    class:list={[
                      'is-link',
                      { 'is-muted': b.status === 'cancelled' || b.status === 'expired' },
                    ]}
                    data-href={`/bookings/${b.reference}`}
                    tabindex="0"
                  >
                    <td class="card-title" data-label="Reference">
                      <a class="ref" href={`/bookings/${b.reference}`}>
                        {b.reference}
                      </a>
                      {b.trip_group_id ? (
                        <span class="return-mark" title="Return trip" aria-label="Return trip">
                          {' '}
                          ⇄
                        </span>
                      ) : null}
                    </td>
                    <td data-label="Pick-up">
                      {formatAthensShort(b.pickup_at).replace(/ (?=\d{2}:\d{2}$)/, ' · ')}
                      {
                        (b.pickup_shift_min ?? 0) > 0 && b.original_pickup_at ? (
                          <span class="sub">
                            <span class="badge s-pending">+{b.pickup_shift_min} min</span>
                            {' '}
                            Pick-up moved {athensHmOnly(b.original_pickup_at)} →{' '}
                            {athensHmOnly(b.pickup_at)}
                          </span>
                        ) : null
                      }
                    </td>
                    <td data-label="Route">
                      {trip}
                      <span class="sub">{sub}</span>
                    </td>
                    <td data-label="Class">
                      <ClassName name={className} />
                    </td>
                    <td data-label="Customer">{b.customer_name}</td>
                    <td class="num" data-label="Total">
                      <Money cents={b.price_cents} />
                    </td>
                    <td data-label="Payment">
                      <StatusBadge kind="payment" status={b.payment_status} />
                    </td>
                    <td data-label="Status">
                      <StatusBadge status={b.status} />
                    </td>
                  </tr>
                );
              })}
            </>
          ))}
        </tbody>
      </DataTable>
    )
  }

  {
    !listError && (
      <div class="pager">
        <span>
          Showing {(page - 1) * pageSize + 1}–{(page - 1) * pageSize + bookings.length}
          {bookings.length >= pageSize ? '+' : ''} · {pageSize} per page
        </span>
        <div class="row">
          {page > 1 ? (
            <a
              class="btn btn-secondary btn-sm"
              href={`?${new URLSearchParams({ ...Object.fromEntries(q), page: String(page - 1) })}`}
            >
              Previous
            </a>
          ) : (
            <span class="btn btn-secondary btn-sm" aria-disabled="true">
              Previous
            </span>
          )}
          {bookings.length >= pageSize ? (
            <a
              class="btn btn-secondary btn-sm"
              href={`?${new URLSearchParams({ ...Object.fromEntries(q), page: String(page + 1) })}`}
            >
              Next
            </a>
          ) : (
            <span class="btn btn-secondary btn-sm" aria-disabled="true">
              Next
            </span>
          )}
        </div>
      </div>
    )
  }
</AdminLayout>
