---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import DataTable from '../../components/DataTable.astro';
import EmptyState from '../../components/EmptyState.astro';
import Flag from '../../components/Flag.astro';
import Select from '../../components/Select.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { athensDay, athensTime } from '../../lib/athens-day';
import { formatEuro } from '../../lib/money';
import { createSupabaseServerClient } from '../../lib/supabase';

const staff = Astro.locals.staff!;
const supabase = createSupabaseServerClient(Astro.cookies);
const q = Astro.url.searchParams;

const status = q.get('status') || 'active';
const from = q.get('from') || '';
const to = q.get('to') || '';
const type = q.get('type') || '';
const vipOnly = q.get('vip') === '1';
const invoice = q.get('invoice') || '';
const source = q.get('source') === 'online' || q.get('source') === 'office' ? q.get('source')! : '';
const needsVehicle = q.get('needs_vehicle') === '1';
const page = Math.max(1, Number(q.get('page') || 1));
const pageSize = 50;

let query = supabase
  .from('bookings')
  .select(
    `
    reference, pickup_at, booking_type, duration_minutes, price_cents, status, payment_status,
    vip_security, invoice_status, customer_name, vehicle_id, source,
    from_zone:zones!bookings_from_zone_id_fkey(name),
    to_zone:zones!bookings_to_zone_id_fkey(name),
    class:vehicle_classes!bookings_class_id_fkey(key),
    vehicle:vehicles!bookings_vehicle_id_fkey(label)
  `,
  )
  .order('pickup_at', { ascending: true })
  .range((page - 1) * pageSize, page * pageSize - 1);

const statuses = ['pending', 'confirmed', 'assigned', 'completed', 'cancelled', 'expired'] as const;
const invoices = ['not_required', 'requested', 'issued'] as const;

if (status === 'active') {
  query = query.in('status', ['pending', 'confirmed', 'assigned']);
} else if ((statuses as readonly string[]).includes(status)) {
  query = query.eq('status', status as (typeof statuses)[number]);
}
if (from) query = query.gte('pickup_at', `${from}T00:00:00+02:00`);
if (to) query = query.lte('pickup_at', `${to}T23:59:59+02:00`);
if (type === 'transfer' || type === 'hourly') query = query.eq('booking_type', type);
if (vipOnly) query = query.eq('vip_security', true);
if ((invoices as readonly string[]).includes(invoice)) {
  query = query.eq('invoice_status', invoice as (typeof invoices)[number]);
}
if (source === 'online' || source === 'office') query = query.eq('source', source);
if (needsVehicle) {
  query = query.eq('status', 'confirmed').is('vehicle_id', null);
}

const { data: rows, error } = await query;
if (error) {
  console.error(JSON.stringify({ level: 'error', code: 'bookings_list', message: error.message }));
}
const bookings = rows ?? [];

const now = new Date();
const week = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
const [{ count: weekCount }, { count: needCount }, { count: vipCount }, { count: invCount }] =
  await Promise.all([
    supabase
      .from('bookings')
      .select('id', { count: 'exact', head: true })
      .in('status', ['pending', 'confirmed', 'assigned'])
      .gte('pickup_at', now.toISOString())
      .lte('pickup_at', week.toISOString()),
    supabase
      .from('bookings')
      .select('id', { count: 'exact', head: true })
      .eq('status', 'confirmed')
      .is('vehicle_id', null)
      .gte('pickup_at', now.toISOString())
      .lte('pickup_at', week.toISOString()),
    supabase
      .from('bookings')
      .select('id', { count: 'exact', head: true })
      .eq('vip_security', true)
      .in('status', ['pending', 'confirmed', 'assigned'])
      .gte('pickup_at', now.toISOString())
      .lte('pickup_at', week.toISOString()),
    supabase
      .from('bookings')
      .select('id', { count: 'exact', head: true })
      .eq('invoice_status', 'requested')
      .gte('pickup_at', now.toISOString())
      .lte('pickup_at', week.toISOString()),
  ]);

const chips: { label: string; clear: string }[] = [];
if (from || to) {
  chips.push({
    label: [from || '…', to || '…'].join(' – '),
    clear: new URLSearchParams(
      [...q.entries()].filter(([k]) => k !== 'from' && k !== 'to'),
    ).toString(),
  });
}
if (vipOnly) {
  chips.push({
    label: 'VIP security only',
    clear: new URLSearchParams([...q.entries()].filter(([k]) => k !== 'vip')).toString(),
  });
}
if (type) {
  chips.push({
    label: type === 'hourly' ? 'Hourly' : 'Transfer',
    clear: new URLSearchParams([...q.entries()].filter(([k]) => k !== 'type')).toString(),
  });
}
if (source) {
  chips.push({
    label: source === 'office' ? 'Office bookings' : 'Online bookings',
    clear: new URLSearchParams([...q.entries()].filter(([k]) => k !== 'source')).toString(),
  });
}
if (invoice) {
  chips.push({
    label: `Invoice ${invoice}`,
    clear: new URLSearchParams([...q.entries()].filter(([k]) => k !== 'invoice')).toString(),
  });
}

type Row = (typeof bookings)[number];
const groups: { key: string; label: string; rows: Row[] }[] = [];
for (const b of bookings) {
  const day = athensDay(b.pickup_at);
  const last = groups[groups.length - 1];
  if (!last || last.key !== day.key) {
    groups.push({ key: day.key, label: day.label, rows: [b] });
  } else {
    last.rows.push(b);
  }
}

function qs(overrides: Record<string, string | null>): string {
  const p = new URLSearchParams(q);
  for (const [k, v] of Object.entries(overrides)) {
    if (v === null) p.delete(k);
    else p.set(k, v);
  }
  p.delete('page');
  const s = p.toString();
  return s ? `?${s}` : '?';
}
---

<AdminLayout title="Bookings" current="bookings" staffEmail={staff.email}>
  <div class="row" slot="actions">
    <a class="btn btn-secondary" href="/calendar">Fleet calendar</a>
    <a class="btn btn-secondary" href="/blocked-slots">Block a vehicle</a>
    <a class="btn" href="/bookings/new">New booking</a>
  </div>

  <dl class="stats" aria-label="Next 7 days">
    <div class="stat">
      <dt>Bookings</dt>
      <dd>{weekCount ?? 0}<small>next 7 days</small></dd>
    </div>
    <div class="stat">
      <dt>Need a vehicle</dt>
      <dd>{needCount ?? 0}<small>confirmed, unassigned</small></dd>
    </div>
    <div class="stat">
      <dt>VIP security</dt>
      <dd>{vipCount ?? 0}<small>notes to confirm</small></dd>
    </div>
    <div class="stat">
      <dt>Invoices requested</dt>
      <dd>{invCount ?? 0}<small>not issued</small></dd>
    </div>
  </dl>

  <nav class="tabs" aria-label="Quick views" style="margin-top:1.25rem">
    <a href={qs({ status: 'active', needs_vehicle: null })} aria-current={status === 'active' && !needsVehicle ? 'page' : undefined}>
      Upcoming <span class="count">{weekCount ?? 0}</span>
    </a>
    <a
      href={qs({ status: 'confirmed', needs_vehicle: '1' })}
      aria-current={needsVehicle ? 'page' : undefined}
    >
      Need a vehicle <span class="count">{needCount ?? 0}</span>
    </a>
    <a href={qs({ status: 'pending', needs_vehicle: null })} aria-current={status === 'pending' ? 'page' : undefined}>
      Pending payment
    </a>
    <a href={qs({ status: 'completed', needs_vehicle: null })} aria-current={status === 'completed' ? 'page' : undefined}>
      Past
    </a>
    <a href={qs({ status: 'cancelled', needs_vehicle: null })} aria-current={status === 'cancelled' ? 'page' : undefined}>
      Cancelled
    </a>
  </nav>

  <form class="filters" aria-label="Filters" method="get">
    <div class="field">
      <label for="fr">From</label>
      <input id="fr" class="input" type="date" name="from" value={from} />
    </div>
    <div class="field">
      <label for="tt">To</label>
      <input id="tt" class="input" type="date" name="to" value={to} />
    </div>
    <div class="field">
      <label for="ty">Type</label>
      <Select
        id="ty"
        name="type"
        options={[
          { value: '', label: 'All types', selected: !type },
          { value: 'transfer', label: 'Transfer', selected: type === 'transfer' },
          { value: 'hourly', label: 'Hourly', selected: type === 'hourly' },
        ]}
      />
    </div>
    <div class="field">
      <label for="so">Source</label>
      <Select
        id="so"
        name="source"
        options={[
          { value: '', label: 'All', selected: !source },
          { value: 'online', label: 'Online', selected: source === 'online' },
          { value: 'office', label: 'Office', selected: source === 'office' },
        ]}
      />
    </div>
    <div class="field">
      <label for="iv">Invoice</label>
      <Select
        id="iv"
        name="invoice"
        options={[
          { value: '', label: 'Any', selected: !invoice },
          { value: 'requested', label: 'Requested', selected: invoice === 'requested' },
          { value: 'issued', label: 'Issued', selected: invoice === 'issued' },
        ]}
      />
    </div>
    <input type="hidden" name="status" value={status} />
    {needsVehicle && <input type="hidden" name="needs_vehicle" value="1" />}
    <label class="check">
      <input type="checkbox" name="vip" value="1" checked={vipOnly} /> VIP security only
    </label>
    <div class="actions">
      <button class="btn btn-sm" type="submit">Apply</button>
      <a class="btn btn-quiet btn-sm" href="/bookings">Clear</a>
    </div>
  </form>

  {
    chips.length > 0 && (
      <ul class="chips" aria-label="Active filters">
        {chips.map((c) => (
          <li class="chip">
            {c.label}{' '}
            <a href={c.clear ? `?${c.clear}` : '/bookings'} aria-label={`Remove filter: ${c.label}`}>
              ×
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    bookings.length === 0 ? (
      <EmptyState title="No bookings">No bookings match these filters.</EmptyState>
    ) : (
      <DataTable label="Bookings, sorted by pick-up time" cards>
        <caption class="sr-only">Bookings, sorted by pick-up time</caption>
        <thead>
          <tr>
            <th scope="col">Reference</th>
            <th scope="col" aria-sort="ascending">
              Pick-up
            </th>
            <th scope="col">Trip</th>
            <th scope="col">Class</th>
            <th scope="col">Vehicle</th>
            <th scope="col">Customer</th>
            <th scope="col" class="num">
              Total
            </th>
            <th scope="col">Status</th>
            <th scope="col">Payment</th>
            <th scope="col">Flags</th>
          </tr>
        </thead>
        <tbody>
          {groups.map((g) => (
            <>
              <tr class="day-row">
                <td colspan="10">
                  {g.label} · {g.rows.length} booking{g.rows.length === 1 ? '' : 's'}
                </td>
              </tr>
              {g.rows.map((b) => {
                const fromName = (b.from_zone as { name?: string } | null)?.name;
                const toName = (b.to_zone as { name?: string } | null)?.name;
                const classKey = (b.class as { key?: string } | null)?.key ?? '-';
                const vehicleLabel = (b.vehicle as { label?: string } | null)?.label;
                const trip =
                  b.booking_type === 'hourly'
                    ? `${fromName ?? '-'} · ${Math.round((b.duration_minutes || 0) / 60)} h`
                    : `${fromName ?? '-'} → ${toName ?? '-'}`;
                const sub = `${b.booking_type === 'hourly' ? 'Hourly' : 'Transfer'}`;
                const showAssign = b.status === 'confirmed' && !b.vehicle_id;
                return (
                  <tr
                    class:list={[
                      { 'is-flag': b.vip_security },
                      { 'is-muted': b.status === 'cancelled' || b.status === 'expired' },
                    ]}
                  >
                    <td class="card-title" data-label="Reference">
                      <a class="ref" href={`/bookings/${b.reference}`}>
                        {b.reference}
                      </a>
                    </td>
                    <td data-label="Pick-up">{athensTime(b.pickup_at)}</td>
                    <td data-label="Trip">
                      {trip}
                      <span class="sub">{sub}</span>
                    </td>
                    <td data-label="Class">{classKey}</td>
                    <td data-label="Vehicle">
                      {showAssign ? (
                        <a href={`/bookings/${b.reference}#assign`}>Assign</a>
                      ) : (
                        vehicleLabel ?? '-'
                      )}
                    </td>
                    <td data-label="Customer">{b.customer_name}</td>
                    <td class="num" data-label="Total">
                      {formatEuro(b.price_cents)}
                    </td>
                    <td data-label="Status">
                      <StatusBadge status={b.status} />
                    </td>
                    <td data-label="Payment">{b.payment_status}</td>
                    <td
                      data-label="Flags"
                      data-hide-phone={
                        !(b.source === 'office' || b.vip_security || b.invoice_status === 'requested' || b.invoice_status === 'issued') ||
                        undefined
                      }
                    >
                      {b.source === 'office' && <Flag kind="office" />}{' '}
                      {b.vip_security && <Flag kind="vip" />}{' '}
                      {(b.invoice_status === 'requested' || b.invoice_status === 'issued') && (
                        <Flag kind="invoice" />
                      )}{' '}
                      {b.booking_type === 'hourly' && <Flag kind="hourly" />}
                    </td>
                  </tr>
                );
              })}
            </>
          ))}
        </tbody>
      </DataTable>
    )
  }

  <div class="pager">
    <span>
      Showing {(page - 1) * pageSize + 1}–{(page - 1) * pageSize + bookings.length}
      {bookings.length >= pageSize ? '+' : ''} · {pageSize} per page
    </span>
    <div class="row">
      {
        page > 1 ? (
          <a
            class="btn btn-secondary btn-sm"
            href={`?${new URLSearchParams({ ...Object.fromEntries(q), page: String(page - 1) })}`}
          >
            Previous
          </a>
        ) : (
          <span class="btn btn-secondary btn-sm" aria-disabled="true">
            Previous
          </span>
        )
      }
      {
        bookings.length >= pageSize ? (
          <a
            class="btn btn-secondary btn-sm"
            href={`?${new URLSearchParams({ ...Object.fromEntries(q), page: String(page + 1) })}`}
          >
            Next
          </a>
        ) : (
          <span class="btn btn-secondary btn-sm" aria-disabled="true">
            Next
          </span>
        )
      }
    </div>
  </div>
</AdminLayout>
