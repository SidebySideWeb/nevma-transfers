---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatEuro } from '../../lib/money';
import { createSupabaseServerClient } from '../../lib/supabase';
import { formatAthensShort } from '../../lib/time';

const staff = Astro.locals.staff!;
const supabase = createSupabaseServerClient(Astro.cookies);
const q = Astro.url.searchParams;

const status = q.get('status') || 'active';
const from = q.get('from') || '';
const to = q.get('to') || '';
const type = q.get('type') || '';
const vipOnly = q.get('vip') === '1';
const invoice = q.get('invoice') || '';
const page = Math.max(1, Number(q.get('page') || 1));
const pageSize = 50;

let query = supabase
  .from('bookings')
  .select(
    `
    reference, pickup_at, booking_type, duration_minutes, price_cents, status, payment_status,
    vip_security, invoice_status, customer_name,
    from_zone:zones!bookings_from_zone_id_fkey(name),
    to_zone:zones!bookings_to_zone_id_fkey(name),
    class:vehicle_classes!bookings_class_id_fkey(key),
    vehicle:vehicles!bookings_vehicle_id_fkey(label)
  `,
  )
  .order('pickup_at', { ascending: true })
  .range((page - 1) * pageSize, page * pageSize - 1);

const statuses = ['pending', 'confirmed', 'assigned', 'completed', 'cancelled', 'expired'] as const;
const invoices = ['not_required', 'requested', 'issued'] as const;

if (status === 'active') {
  query = query.in('status', ['pending', 'confirmed', 'assigned']);
} else if ((statuses as readonly string[]).includes(status)) {
  query = query.eq('status', status as (typeof statuses)[number]);
}
if (from) query = query.gte('pickup_at', `${from}T00:00:00+02:00`);
if (to) query = query.lte('pickup_at', `${to}T23:59:59+02:00`);
if (type === 'transfer' || type === 'hourly') query = query.eq('booking_type', type);
if (vipOnly) query = query.eq('vip_security', true);
if ((invoices as readonly string[]).includes(invoice)) {
  query = query.eq('invoice_status', invoice as (typeof invoices)[number]);
}

const { data: rows, error } = await query;
if (error) {
  console.error(JSON.stringify({ level: 'error', code: 'bookings_list', message: error.message }));
}
const bookings = rows ?? [];
---

<AdminLayout title="Bookings — TEM Admin" current="bookings" staffEmail={staff.email}>
  <div class="row between">
    <h1>Bookings</h1>
  </div>
  <form class="toolbar" aria-label="Filters" method="get">
    <div class="field">
      <label for="st">Status</label>
      <select id="st" class="input" name="status">
        <option value="active" selected={status === 'active'}>All active</option>
        <option value="pending" selected={status === 'pending'}>Pending</option>
        <option value="confirmed" selected={status === 'confirmed'}>Confirmed</option>
        <option value="assigned" selected={status === 'assigned'}>Assigned</option>
        <option value="completed" selected={status === 'completed'}>Completed</option>
        <option value="cancelled" selected={status === 'cancelled'}>Cancelled</option>
        <option value="expired" selected={status === 'expired'}>Expired</option>
      </select>
    </div>
    <div class="field">
      <label for="fr">From</label>
      <input id="fr" class="input" type="date" name="from" value={from} />
    </div>
    <div class="field">
      <label for="tt">To</label>
      <input id="tt" class="input" type="date" name="to" value={to} />
    </div>
    <div class="field">
      <label for="ty">Type</label>
      <select id="ty" class="input" name="type">
        <option value="" selected={!type}>All</option>
        <option value="transfer" selected={type === 'transfer'}>Transfer</option>
        <option value="hourly" selected={type === 'hourly'}>Hourly</option>
      </select>
    </div>
    <label class="check">
      <input type="checkbox" name="vip" value="1" checked={vipOnly} /> VIP security only
    </label>
    <div class="field">
      <label for="iv">Invoice</label>
      <select id="iv" class="input" name="invoice">
        <option value="" selected={!invoice}>All</option>
        <option value="requested" selected={invoice === 'requested'}>Requested</option>
        <option value="issued" selected={invoice === 'issued'}>Issued</option>
      </select>
    </div>
    <button class="btn" type="submit">Apply</button>
  </form>

  <div class="table-wrap" role="region" tabindex="0" aria-label="Scrollable table">
    <table>
      <caption class="sr-only">Bookings, sorted by pick-up time</caption>
      <thead>
        <tr>
          <th scope="col">Reference</th>
          <th scope="col">Pick-up</th>
          <th scope="col">Type</th>
          <th scope="col">Trip</th>
          <th scope="col">Class</th>
          <th scope="col">Vehicle</th>
          <th scope="col">Customer</th>
          <th scope="col" class="num">Total</th>
          <th scope="col">Status</th>
          <th scope="col">Payment</th>
          <th scope="col">Flags</th>
        </tr>
      </thead>
      <tbody>
        {
          bookings.length === 0 ? (
            <tr>
              <td colspan="11">No bookings match these filters.</td>
            </tr>
          ) : (
            bookings.map((b) => {
              const fromName = (b.from_zone as { name?: string } | null)?.name;
              const toName = (b.to_zone as { name?: string } | null)?.name;
              const classKey = (b.class as { key?: string } | null)?.key ?? '—';
              const vehicleLabel = (b.vehicle as { label?: string } | null)?.label ?? '—';
              const trip =
                b.booking_type === 'hourly'
                  ? `${fromName ?? '—'} · ${Math.round((b.duration_minutes || 0) / 60)} h`
                  : `${fromName ?? '—'} → ${toName ?? '—'}`;
              const statusClass =
                b.status === 'confirmed'
                  ? 'badge-success'
                  : b.status === 'pending'
                    ? 'badge-warning'
                    : b.status === 'cancelled'
                      ? 'badge-danger'
                      : '';
              return (
                <tr>
                  <td>
                    <a href={`/bookings/${b.reference}`}>{b.reference}</a>
                  </td>
                  <td>{formatAthensShort(b.pickup_at)}</td>
                  <td>{b.booking_type === 'hourly' ? 'Hourly' : 'Transfer'}</td>
                  <td>{trip}</td>
                  <td>{classKey}</td>
                  <td>{vehicleLabel}</td>
                  <td>{b.customer_name}</td>
                  <td class="num">{formatEuro(b.price_cents)}</td>
                  <td>
                    <span class:list={['badge', statusClass]}>{b.status}</span>
                  </td>
                  <td>{b.payment_status}</td>
                  <td>
                    {b.vip_security && <span class="badge badge-accent">VIP security</span>}{' '}
                    {b.invoice_status === 'requested' || b.invoice_status === 'issued' ? (
                      <span class="badge">Invoice</span>
                    ) : null}
                  </td>
                </tr>
              );
            })
          )
        }
      </tbody>
    </table>
  </div>
  {
    bookings.length >= pageSize && (
      <p>
        <a href={`?${new URLSearchParams({ ...Object.fromEntries(q), page: String(page + 1) })}`}>
          Next page
        </a>
      </p>
    )
  }
</AdminLayout>
