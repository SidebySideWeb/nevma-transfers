---
export const prerender = false;

import { actions } from 'astro:actions';
import AdminLayout from '../../layouts/AdminLayout.astro';
import AutoBadge from '../../components/AutoBadge.astro';
import Banner from '../../components/Banner.astro';
import ClassName from '../../components/ClassName.astro';
import EmptyState from '../../components/EmptyState.astro';
import Flag from '../../components/Flag.astro';
import Phone from '../../components/Phone.astro';
import Select from '../../components/Select.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Toast from '../../components/Toast.astro';
import { confirmActionLabel } from '../../components/confirm-label';
import { formatEuro } from '../../lib/money';
import { displayVehicleLabel } from '../../lib/vehicle-label';

function formatVatRate(bp: number): string {
  return String(Number((bp / 100).toFixed(2)));
}
import { mapsDirectionsUrl } from '@tem/places';
import { driversEnabled } from '../../lib/drivers';
import { classifyDriverOffer, type DriverBookingSlice } from '../../lib/free-drivers';
import { parseTstzRange, rangesOverlap } from '../../lib/range';
import { createSupabaseServerClient } from '../../lib/supabase';
import { formatAthens, formatAthensShort } from '../../lib/time';
import { tripStatusWord } from '../../lib/trip-status';

const staff = Astro.locals.staff!;
const reference = Astro.params.reference!;
const supabase = createSupabaseServerClient(Astro.cookies);

const { data: booking, error } = await supabase
  .from('bookings')
  .select(
    `
    *,
    from_zone:zones!bookings_from_zone_id_fkey(name),
    to_zone:zones!bookings_to_zone_id_fkey(name),
    class:vehicle_classes!bookings_class_id_fkey(id, key, name, buffer_minutes),
    vehicle:vehicles!bookings_vehicle_id_fkey(id, label)
  `,
  )
  .eq('reference', reference)
  .maybeSingle();

const found = Boolean(booking) && !error;
if (!found) {
  Astro.response.status = 404;
}

function actionErr(
  result: { error?: { message?: string } | Error } | undefined,
): string | null {
  if (!result || !('error' in result) || !result.error) return null;
  const e = result.error;
  return typeof e === 'object' && e && 'message' in e ? String(e.message) : String(e);
}

let extras: {
  price_cents: number;
  quantity: number;
  extras: { code?: string; name?: string } | null;
}[] = [];
let payments: {
  created_at: string;
  kind: string;
  amount_cents: number;
  status: string;
  created_by: string | null;
  method: string;
}[] = [];
let paid = 0;
let offlinePaid = false;
let addedBy = '';
let canRecordOffline = false;
const toast = Astro.url.searchParams.get('toast');
const toastCapped = Astro.url.searchParams.get('capped') === '1';
const METHOD_LABEL: Record<string, string> = {
  viva: 'Viva',
  cash: 'Cash',
  bank_transfer: 'Bank transfer',
  on_account: 'On account',
};
let refundable = 0;
let classVehicles: { id: string; label: string; busy: boolean }[] = [];
let driverOffers: { value: string; label: string; meta?: string; selected?: boolean; disabled?: boolean }[] = [];
let bookingEvents: {
  kind: string;
  at: string;
  source: string;
  note: string | null;
  driver: { full_name?: string } | null;
}[] = [];
let fromName: string | undefined;
let toName: string | undefined;
let className: string | undefined;
let vehicleError: string | null = null;
let tripError: string | null = null;
let pageError: string | null = null;
let refundConfirm = '';
let cancelConfirm = '';
const showDrivers = driversEnabled();

if (found && booking) {
  const extrasRes = await supabase
    .from('booking_extras')
    .select('price_cents, quantity, extras(code, name)')
    .eq('booking_id', booking.id);
  extras = (extrasRes.data ?? []) as typeof extras;

  const paymentsRes = await supabase
    .from('payments')
    .select('created_at, kind, amount_cents, status, created_by, method')
    .eq('booking_id', booking.id)
    .order('created_at', { ascending: true });
  payments = paymentsRes.data ?? [];
  offlinePaid = payments.some(
    (p) => p.kind === 'payment' && p.status === 'succeeded' && p.method !== 'viva',
  );
  if (booking.source === 'office') {
    const { data: creator } = booking.created_by
      ? await supabase.from('staff').select('email').eq('user_id', booking.created_by).maybeSingle()
      : { data: null };
    addedBy = `Added by ${creator?.email || 'staff'}${
      booking.payment_method ? ` · ${METHOD_LABEL[booking.payment_method] ?? booking.payment_method}` : ''
    }`;
  }

  paid = payments
    .filter((p) => p.kind === 'payment' && p.status === 'succeeded')
    .reduce((s, p) => s + p.amount_cents, 0);
  const refunded = payments
    .filter((p) => p.kind === 'refund' && p.status === 'succeeded')
    .reduce((s, p) => s + p.amount_cents, 0);
  refundable = Math.max(0, paid - refunded);

  const ownRange = parseTstzRange(booking.blocked_range);
  const classId = (booking.class as { id: string } | null)?.id;
  if (classId) {
    const { data: vehicles } = await supabase
      .from('vehicles')
      .select('id, label')
      .eq('class_id', classId)
      .eq('status', 'active')
      .order('label');

    const busy = new Set<string>();
    if (ownRange) {
      const { data: busyBookings } = await supabase
        .from('bookings')
        .select('id, vehicle_id, blocked_range, status')
        .eq('class_id', classId)
        .not('vehicle_id', 'is', null)
        .in('status', ['pending', 'confirmed', 'assigned']);

      const { data: blocks } = await supabase.from('blocked_slots').select('vehicle_id, range');

      for (const b of busyBookings ?? []) {
        if (b.id === booking.id || !b.vehicle_id) continue;
        const r = parseTstzRange(b.blocked_range);
        if (r && rangesOverlap(ownRange, r)) busy.add(b.vehicle_id);
      }
      for (const s of blocks ?? []) {
        const r = parseTstzRange(s.range);
        if (r && rangesOverlap(ownRange, r)) busy.add(s.vehicle_id);
      }
    }

    classVehicles = (vehicles ?? []).map((v) => ({
      id: v.id,
      label: busy.has(v.id) && v.id !== booking.vehicle_id
        ? `${displayVehicleLabel(v.label)} (busy)`
        : displayVehicleLabel(v.label),
      busy: busy.has(v.id) && v.id !== booking.vehicle_id,
    }));
  }

  if (showDrivers && ownRange) {
    const [{ data: drivers }, { data: shifts }, { data: driverBookings }, { data: events }] =
      await Promise.all([
        supabase
          .from('drivers')
          .select('id, full_name, licence_expires_on')
          .eq('active', true)
          .order('full_name'),
        supabase.from('driver_shifts').select('driver_id').is('ended_at', null),
        supabase
          .from('bookings')
          .select('id, driver_id, reference, status, blocked_range')
          .not('driver_id', 'is', null)
          .in('status', ['pending', 'confirmed', 'assigned']),
        supabase
          .from('booking_events')
          .select('kind, at, source, note, driver:drivers(full_name)')
          .eq('booking_id', booking.id)
          .order('at', { ascending: true }),
      ]);
    const onShift = new Set((shifts ?? []).map((s) => s.driver_id));
    const slices: DriverBookingSlice[] = [];
    for (const b of driverBookings ?? []) {
      if (!b.driver_id) continue;
      const r = parseTstzRange(b.blocked_range);
      if (!r) continue;
      slices.push({
        id: b.id,
        driverId: b.driver_id,
        reference: b.reference,
        status: b.status,
        startMs: r.start.getTime(),
        endMs: r.end.getTime(),
      });
    }
    driverOffers = (drivers ?? []).map((d) => {
      const offer = classifyDriverOffer({
        driverId: d.id,
        fullName: d.full_name,
        onShift: onShift.has(d.id),
        licenceExpiresOn: d.licence_expires_on,
        tripStartMs: ownRange.start.getTime(),
        tripEndMs: ownRange.end.getTime(),
        bookings: slices,
        excludeBookingId: booking.id,
      });
      return {
        value: offer.id,
        label: offer.label,
        meta: offer.meta,
        disabled: offer.disabled,
        selected: booking.driver_id === d.id,
      };
    });
    bookingEvents = (events ?? []) as typeof bookingEvents;
  }

  fromName = (booking.from_zone as { name?: string } | null)?.name;
  toName = (booking.to_zone as { name?: string } | null)?.name;
  className = (booking.class as { name?: string } | null)?.name;

  vehicleError = actionErr(Astro.getActionResult?.(actions.assignVehicle));
  tripError = actionErr(Astro.getActionResult?.(actions.setTripStatus));
  pageError =
    actionErr(Astro.getActionResult?.(actions.saveNotesInvoice)) ||
    actionErr(Astro.getActionResult?.(actions.refundBooking)) ||
    actionErr(Astro.getActionResult?.(actions.recordOfflinePayment)) ||
    actionErr(Astro.getActionResult?.(actions.cancelBooking));

  canRecordOffline =
    booking.payment_status === 'unpaid' &&
    !!booking.payment_method &&
    booking.payment_method !== 'viva' &&
    ['confirmed', 'assigned', 'completed'].includes(booking.status);

  refundConfirm = confirmActionLabel('Refund', refundable);
  cancelConfirm = confirmActionLabel(
    paid > 0 ? 'Cancel and refund' : 'Cancel',
    paid > 0 ? paid : 0,
  );
}
---

{
  !found || !booking ? (
    <AdminLayout
      title="Booking not found"
      current="bookings"
      staffEmail={staff.email}
      crumbs={[{ href: '/bookings', label: 'Bookings' }, { label: reference }]}
    >
      <EmptyState title="Booking not found">
        No booking with reference <strong>{reference}</strong>. It may have expired or the link is
        wrong. <a href="/bookings">Back to bookings</a>
      </EmptyState>
    </AdminLayout>
  ) : (
    <>
      <AdminLayout
        title={reference}
        subtitle={`${formatAthensShort(booking.pickup_at).replace(/ (?=\d{2}:\d{2}$)/, ' · ')} · ${
          booking.booking_type === 'hourly'
            ? `${fromName ?? '—'} · ${Math.round((booking.duration_minutes || 0) / 60)} h`
            : `${fromName ?? '—'} → ${toName ?? '—'}`
        }`}
        current="bookings"
        staffEmail={staff.email}
        crumbs={[{ href: '/bookings', label: 'Bookings' }, { label: reference }]}
      >
        <div class="row" slot="actions">
          <StatusBadge status={booking.status} />
          <StatusBadge kind="payment" status={booking.payment_status} />
          {booking.source === 'office' && <Flag kind="office" />}
          {booking.vip_security && <Flag kind="vip" />}
          {booking.booking_type === 'hourly' && <Flag kind="hourly" />}
        </div>

        {
          toast === 'created' && (
            <Toast>
              Booking {reference} created.
              {toastCapped &&
                " The payment link hold was shortened to Viva's maximum order time."}
            </Toast>
          )
        }

        {pageError && (
          <Banner tone="danger" role="alert">
            {pageError}
          </Banner>
        )}

        <div class="cols cols-main booking-detail">
          <div class="stack">
            <section class="panel panel-trip" aria-labelledby="t-h">
              <div class="panel-head">
                <h2 id="t-h">Trip</h2>
              </div>
              <div class="panel-body stack-sm">
                <dl class="facts">
                  <dt>Type</dt>
                  <dd>{booking.booking_type === 'hourly' ? 'Hourly' : 'Transfer'}</dd>
                  <dt>Pick-up</dt>
                  <dd>{formatAthens(booking.pickup_at)} (Athens)</dd>
                  <dt>From</dt>
                  <dd>
                    {fromName ?? '—'}
                    {booking.pickup_address ? ` · ${booking.pickup_address}` : ''}
                    {
                      booking.pickup_address && (
                        <a
                          class="map-link"
                          href={mapsDirectionsUrl({
                            address: booking.pickup_address,
                            placeId: booking.pickup_place_id,
                            lat: booking.pickup_lat,
                            lng: booking.pickup_lng,
                          })}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <span aria-hidden="true">⌖</span>
                          <span class="sr-only">Open pick-up address in Google Maps</span>
                        </a>
                      )
                    }
                  </dd>
                  {booking.booking_type === 'transfer' && (
                    <>
                      <dt>To</dt>
                      <dd>
                        {toName ?? '—'}
                        {booking.dropoff_address ? ` · ${booking.dropoff_address}` : ''}
                        {
                          booking.dropoff_address && (
                            <a
                              class="map-link"
                              href={mapsDirectionsUrl({
                                address: booking.dropoff_address,
                                placeId: booking.dropoff_place_id,
                                lat: booking.dropoff_lat,
                                lng: booking.dropoff_lng,
                              })}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              <span aria-hidden="true">⌖</span>
                              <span class="sr-only">Open drop-off address in Google Maps</span>
                            </a>
                          )
                        }
                      </dd>
                    </>
                  )}
                  {booking.booking_type === 'hourly' && (
                    <>
                      <dt>Hours</dt>
                      <dd>{Math.round((booking.duration_minutes || 0) / 60)}</dd>
                    </>
                  )}
                  <dt>Flight</dt>
                  <dd>{booking.flight_number || '—'}</dd>
                  <dt>Passengers</dt>
                  <dd>
                    {booking.passengers} · {booking.luggage} bags
                  </dd>
                  <dt>Class</dt>
                  <dd>
                    <ClassName name={className} />
                  </dd>
                </dl>
              </div>
            </section>

            <section class="panel panel-assign" aria-labelledby="a-h" id="assign">
              <div class="panel-head">
                <h2 id="a-h">Assignment</h2>
              </div>
              <div class="panel-body stack-sm">
                <form
                  method="POST"
                  action={actions.assignVehicle}
                  class="stack-sm"
                  aria-label="Assign vehicle"
                >
                  <input type="hidden" name="reference" value={reference} />
                  <div class="field">
                    <label for="veh">
                      Vehicle{' '}
                      <AutoBadge show={Boolean(booking.vehicle_auto_assigned && booking.vehicle_id)} />
                    </label>
                    <Select
                      id="veh"
                      name="vehicleId"
                      aria-invalid={vehicleError ? 'true' : undefined}
                      aria-describedby={vehicleError ? 'veh-err' : undefined}
                      options={[
                        {
                          value: '',
                          label: '- Not assigned -',
                          selected: !booking.vehicle_id,
                        },
                        ...classVehicles.map((v) => ({
                          value: v.id,
                          label: displayVehicleLabel(v.label),
                          selected: booking.vehicle_id === v.id,
                          meta: v.busy ? 'busy' : undefined,
                        })),
                      ]}
                    />
                    {vehicleError && (
                      <p class="error-text" id="veh-err" role="alert">
                        {vehicleError}
                      </p>
                    )}
                  </div>
                  {
                    showDrivers && (
                      <div class="field">
                        <label for="drv">Driver</label>
                        <Select
                          id="drv"
                          name="driverId"
                          aria-invalid={vehicleError ? 'true' : undefined}
                          aria-describedby={vehicleError ? 'veh-err' : undefined}
                          options={[
                            {
                              value: '',
                              label: '- Not assigned -',
                              selected: !booking.driver_id,
                            },
                            ...driverOffers,
                          ]}
                        />
                      </div>
                    )
                  }
                  <div class="row">
                    <button class="btn" type="submit">
                      Save assignment
                    </button>
                  </div>
                </form>
                {
                  showDrivers &&
                    ['confirmed', 'assigned', 'completed'].includes(booking.status) && (
                      <form method="POST" action={actions.setTripStatus} class="stack-sm">
                        <input type="hidden" name="reference" value={reference} />
                        <div class="field">
                          <span class="label">Trip status</span>
                          <div class="seg trip-status" aria-label="Trip status">
                            {[
                              ['scheduled', 'Scheduled'],
                              ['on_way', 'On the way'],
                              ['on_board', 'Picked up'],
                              ['completed', 'Completed'],
                            ].map(([value, label]) => (
                              <button
                                type="submit"
                                name="status"
                                value={value}
                                aria-current={booking.trip_status === value ? 'step' : undefined}
                              >
                                {label}
                              </button>
                            ))}
                          </div>
                          <div class="row" style="margin-top:.5rem">
                            <button
                              class="btn btn-quiet btn-sm"
                              type="submit"
                              name="status"
                              value="no_show"
                              aria-current={booking.trip_status === 'no_show' ? 'true' : undefined}
                            >
                              No-show
                            </button>
                          </div>
                          {tripError && (
                            <p class="error-text" id="trip-err" role="alert">
                              {tripError}
                            </p>
                          )}
                        </div>
                      </form>
                    )
                }
                {booking.status === 'assigned' && (
                  <form method="POST" action={actions.markCompleted}>
                    <input type="hidden" name="reference" value={reference} />
                    <button class="btn btn-quiet" type="submit">
                      Mark completed
                    </button>
                  </form>
                )}
              </div>
            </section>

            {
              showDrivers && (
                <section class="panel panel-timeline" aria-labelledby="trip-tl-h">
                  <div class="panel-head">
                    <h2 id="trip-tl-h">Trip timeline</h2>
                  </div>
                  <div class="panel-body">
                    {bookingEvents.length === 0 ? (
                      <EmptyState title="No trip events">No driver or trip events yet.</EmptyState>
                    ) : (
                      <ol class="timeline">
                        {bookingEvents.map((ev) => {
                          const name =
                            (ev.driver as { full_name?: string } | null)?.full_name ?? '';
                          let label = ev.kind;
                          if (ev.kind === 'driver_assigned') {
                            label = name ? `Driver assigned · ${name}` : 'Driver assigned';
                          } else if (ev.kind === 'driver_removed') {
                            label = name ? `Driver removed · ${name}` : 'Driver removed';
                          } else {
                            label = tripStatusWord(ev.kind);
                          }
                          const note = ev.note ? ` — ${ev.note}` : '';
                          return (
                            <li class="done">
                              <time datetime={ev.at}>{formatAthensShort(ev.at)}</time>
                              {label}
                              <span class="muted small"> · {ev.source}{note}</span>
                            </li>
                          );
                        })}
                      </ol>
                    )}
                  </div>
                </section>
              )
            }
          </div>

          <div class="stack col-sticky">
            <section class="panel panel-pay" aria-labelledby="p-h">
              <div class="panel-head">
                <h2 id="p-h">Payment</h2>
              </div>
              <div class="panel-body stack-sm">
                {addedBy && <p class="muted small" id="added-by">{addedBy}</p>}
                {
                  booking.price_override_reason && (
                    <p class="muted small">
                      Price differs from the list ({formatEuro(booking.list_price_cents ?? 0)}):{' '}
                      {booking.price_override_reason}
                    </p>
                  )
                }
                <dl class="totals">
                  <div>
                    <dt>Vehicle</dt>
                    <dd>{formatEuro(booking.base_price_cents)}</dd>
                  </div>
                  {extras.map((e) => {
                    const ex = e.extras as { name?: string } | null;
                    return (
                      <div>
                        <dt>{ex?.name ?? 'Extra'}</dt>
                        <dd>{formatEuro(e.price_cents * e.quantity)}</dd>
                      </div>
                    );
                  })}
                  <div>
                    <dt>Price before VAT</dt>
                    <dd>{formatEuro(booking.price_cents - (booking.vat_cents ?? 0))}</dd>
                  </div>
                  <div>
                    <dt>{`VAT ${formatVatRate(booking.vat_rate_bp ?? 0)}%`}</dt>
                    <dd>{formatEuro(booking.vat_cents ?? 0)}</dd>
                  </div>
                  <div class="grand">
                    <dt>Total</dt>
                    <dd>{formatEuro(booking.price_cents)}</dd>
                  </div>
                </dl>
                <p class="refundable-line muted small">
                  Refundable {formatEuro(refundable)}
                </p>
                <p id="payment-status">
                  <StatusBadge kind="payment" status={booking.payment_status} />
                </p>
                <div class="row">
                  {
                    canRecordOffline && (
                      <button class="btn" type="button" id="open-offline">
                        Record offline payment…
                      </button>
                    )
                  }
                  <button
                    class="btn btn-secondary"
                    type="button"
                    id="open-refund"
                    disabled={refundable <= 0}
                  >
                    Refund…
                  </button>
                  <button
                    class="btn btn-danger"
                    type="button"
                    id="open-cancel"
                    disabled={booking.status === 'cancelled' || booking.status === 'completed'}
                  >
                    Cancel booking…
                  </button>
                </div>
              </div>
            </section>

            <section class="panel panel-pay-hist" aria-labelledby="pay-h">
              <div class="panel-head">
                <h2 id="pay-h">Payment history</h2>
              </div>
              <div class="panel-body">
                {payments.length === 0 ? (
                  <EmptyState title="No payments">No payments yet.</EmptyState>
                ) : (
                  <ol class="payment-history">
                    {payments.map((p) => (
                      <li>
                        <time datetime={p.created_at}>{formatAthensShort(p.created_at)}</time>
                        <span aria-hidden="true">·</span>
                        <strong>{formatEuro(p.amount_cents)}</strong>
                        <span aria-hidden="true">·</span>
                        <span>{METHOD_LABEL[p.method] ?? p.method}</span>
                        <span aria-hidden="true">·</span>
                        <span>{p.status}</span>
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            </section>

            <section class="panel panel-customer" aria-labelledby="c-h">
              <div class="panel-head">
                <h2 id="c-h">Customer</h2>
              </div>
              <div class="panel-body">
                <dl class="facts">
                  <dt>Name</dt>
                  <dd>
                    {booking.customer_id ? (
                      <a href={`/customers/${booking.customer_id}`}>{booking.customer_name}</a>
                    ) : (
                      booking.customer_name
                    )}
                  </dd>
                  <dt>Email</dt>
                  <dd>{booking.customer_email || '—'}</dd>
                  <dt>Phone</dt>
                  <dd>{booking.customer_phone ? <Phone value={booking.customer_phone} /> : '—'}</dd>
                  <dt>Notes</dt>
                  <dd>{booking.notes || '—'}</dd>
                  {booking.vip_security && (
                    <>
                      <dt>VIP security</dt>
                      <dd>Yes</dd>
                    </>
                  )}
                </dl>
              </div>
            </section>

            <section class="panel panel-office" aria-labelledby="office-h">
              <div class="panel-head">
                <h2 id="office-h">Office notes &amp; invoice</h2>
              </div>
              <div class="panel-body">
                <form method="POST" action={actions.saveNotesInvoice} class="stack-sm">
                  <input type="hidden" name="reference" value={reference} />
                  {booking.vip_security && <p class="eyebrow">VIP security</p>}
                  <div class="field">
                    <label for="sec">Security notes (agents or partner)</label>
                    <textarea id="sec" class="input" name="securityNotes" rows="3">
                      {booking.security_notes ?? ''}
                    </textarea>
                  </div>
                  <p class="eyebrow">Invoice</p>
                  {booking.invoice_company && (
                    <p class="muted small">
                      {booking.invoice_company}
                      {booking.invoice_vat ? ` · VAT ${booking.invoice_vat}` : ''}
                      {booking.invoice_tax_office
                        ? ` · Tax office ${booking.invoice_tax_office}`
                        : ''}
                      {booking.invoice_address ? ` · ${booking.invoice_address}` : ''}
                    </p>
                  )}
                  <div class="grid-fields">
                    <div class="field">
                      <label for="ist">Invoice status</label>
                      <Select
                        id="ist"
                        name="invoiceStatus"
                        options={[
                          {
                            value: 'not_required',
                            label: 'Not required',
                            selected: booking.invoice_status === 'not_required',
                          },
                          {
                            value: 'requested',
                            label: 'Requested',
                            selected: booking.invoice_status === 'requested',
                          },
                          {
                            value: 'issued',
                            label: 'Issued',
                            selected: booking.invoice_status === 'issued',
                          },
                        ]}
                      />
                    </div>
                    <div class="field">
                      <label for="inr">Invoice number</label>
                      <input
                        id="inr"
                        class="input"
                        name="invoiceNumber"
                        value={booking.invoice_number ?? ''}
                      />
                    </div>
                  </div>
                  <button class="btn btn-secondary" type="submit">
                    Save notes and invoice
                  </button>
                </form>
              </div>
            </section>
          </div>
        </div>
      </AdminLayout>

      <dialog class="dialog" id="refund-dialog" aria-labelledby="refund-h">
        <form method="POST" action={actions.refundBooking} id="refund-form">
          <div class="dialog-head">
            <p class="eyebrow">{reference}</p>
            <h2 id="refund-h">Refund a payment</h2>
          </div>
          <div class="dialog-body">
            <dl class="restate">
              <dt>Customer</dt>
              <dd>{booking.customer_name}</dd>
              <dt>Refundable</dt>
              <dd class="amount">{formatEuro(refundable)}</dd>
            </dl>
            <input type="hidden" name="reference" value={reference} />
            <input type="hidden" name="idempotencyKey" id="refund-idem" value="" />
            <div class="field">
              <label for="amt">Amount to refund</label>
              <div class="input-money">
                <input
                  id="amt"
                  class="input"
                  name="amountEuros"
                  required
                  inputmode="decimal"
                  value={(refundable / 100).toFixed(2)}
                  aria-describedby="amt-help"
                />
              </div>
              <p class="help" id="amt-help">
                Up to {formatEuro(refundable)}.{' '}
                {offlinePaid
                  ? 'This was paid offline: the refund is recorded here without Viva. Hand the money back yourself.'
                  : 'Viva returns it to the same card in 3–5 working days.'}
              </p>
            </div>
            <div class="field">
              <label for="rr">Reason (staff only)</label>
              <input id="rr" class="input" name="reason" required value="Customer refund" />
            </div>
          </div>
          <div class="dialog-foot">
            <button class="btn btn-quiet" type="button" id="close-refund">
              Back
            </button>
            <button class="btn" type="submit" id="confirm-refund">
              {refundConfirm}
            </button>
          </div>
        </form>
      </dialog>

      {
        canRecordOffline && (
          <dialog class="dialog" id="offline-dialog" aria-labelledby="offline-h">
            <form method="POST" action={actions.recordOfflinePayment} id="offline-form">
              <div class="dialog-head">
                <p class="eyebrow">
                  {reference}
                  {booking.source === 'office' ? ' · added by the office' : ''}
                </p>
                <h2 id="offline-h">Record an offline payment</h2>
              </div>
              <div class="dialog-body">
                <dl class="restate">
                  <dt>Customer</dt>
                  <dd>{booking.customer_name}</dd>
                  <dt>To collect</dt>
                  <dd class="amount">{formatEuro(booking.price_cents)}</dd>
                </dl>
                <input type="hidden" name="reference" value={reference} />
                <input type="hidden" name="idempotencyKey" id="offline-idem" value="" />
                <div class="grid-fields">
                  <div class="field">
                    <label for="om">Method</label>
                    <Select
                      id="om"
                      name="method"
                      options={[
                        { value: 'cash', label: 'Cash', selected: booking.payment_method === 'cash' },
                        {
                          value: 'bank_transfer',
                          label: 'Bank transfer',
                          selected: booking.payment_method === 'bank_transfer',
                        },
                        {
                          value: 'on_account',
                          label: 'On account (invoice)',
                          selected: booking.payment_method === 'on_account',
                        },
                      ]}
                    />
                  </div>
                  <div class="field">
                    <label for="oa">Amount</label>
                    <div class="input-money">
                      <input
                        id="oa"
                        class="input"
                        name="amountEuros"
                        inputmode="decimal"
                        value={(booking.price_cents / 100).toFixed(2)}
                      />
                    </div>
                  </div>
                </div>
                <div class="field">
                  <label for="on">Note (staff only)</label>
                  <input id="on" class="input" name="note" />
                </div>
                <p class="help">
                  No money moves through Viva. Refunds of offline payments are recorded the same way.
                </p>
              </div>
              <div class="dialog-foot">
                <button class="btn btn-quiet" type="button" id="close-offline">
                  Back
                </button>
                <button class="btn" type="submit" id="confirm-offline">
                  Record {formatEuro(booking.price_cents)}
                </button>
              </div>
            </form>
          </dialog>
        )
      }

      <dialog class="dialog" id="cancel-dialog" aria-labelledby="cancel-h">
        <form method="POST" action={actions.cancelBooking} id="cancel-form">
          <div class="dialog-head">
            <p class="eyebrow">{reference}</p>
            <h2 id="cancel-h">Cancel this booking?</h2>
          </div>
          <div class="dialog-body">
            <dl class="restate">
              <dt>Customer</dt>
              <dd>{booking.customer_name}</dd>
              <dt>Pick-up</dt>
              <dd>{formatAthens(booking.pickup_at)}</dd>
              <dt>Refund</dt>
              <dd class="amount">{formatEuro(paid)}</dd>
            </dl>
            <input type="hidden" name="reference" value={reference} />
            <input type="hidden" name="idempotencyKey" id="cancel-idem" value="" />
            <div class="field">
              <label for="cr">Reason</label>
              <input id="cr" class="input" name="reason" required value="Office cancellation" />
            </div>
            <div class="field">
              <label for="rf">Refund</label>
              <Select
                id="rf"
                name="refund"
                options={[
                  { value: 'full', label: 'Full refund', selected: true },
                  { value: 'none', label: 'No refund' },
                ]}
              />
            </div>
          </div>
          <div class="dialog-foot">
            <button class="btn btn-quiet" type="button" id="close-cancel">
              Keep booking
            </button>
            <button class="btn btn-danger-solid" type="submit" id="confirm-cancel">
              {paid > 0 ? cancelConfirm : 'Cancel booking'}
            </button>
          </div>
        </form>
      </dialog>

      <script>
        import { enhanceAllSelects } from '../../components/enhance-select';
        enhanceAllSelects();

        const refundDlg = document.getElementById('refund-dialog') as HTMLDialogElement | null;
        const cancelDlg = document.getElementById('cancel-dialog') as HTMLDialogElement | null;
        document.getElementById('open-refund')?.addEventListener('click', () => {
          const el = document.getElementById('refund-idem') as HTMLInputElement | null;
          if (el) el.value = crypto.randomUUID();
          refundDlg?.showModal();
          document.getElementById('amt')?.focus();
        });
        document.getElementById('close-refund')?.addEventListener('click', () => refundDlg?.close());
        document.getElementById('open-cancel')?.addEventListener('click', () => {
          const el = document.getElementById('cancel-idem') as HTMLInputElement | null;
          if (el) el.value = crypto.randomUUID();
          cancelDlg?.showModal();
          document.getElementById('cr')?.focus();
        });
        document.getElementById('close-cancel')?.addEventListener('click', () => cancelDlg?.close());

        const offlineDlg = document.getElementById('offline-dialog') as HTMLDialogElement | null;
        document.getElementById('open-offline')?.addEventListener('click', () => {
          const el = document.getElementById('offline-idem') as HTMLInputElement | null;
          if (el) el.value = crypto.randomUUID();
          offlineDlg?.showModal();
          document.querySelector<HTMLElement>('#offline-dialog .ep-select-btn')?.focus();
        });
        document.getElementById('close-offline')?.addEventListener('click', () => offlineDlg?.close());

        // Toasts fade after 6 s (design: role="status", never for errors that need action).
        document.querySelectorAll<HTMLElement>('.toast[role="status"]').forEach((t) => {
          setTimeout(() => t.remove(), 6000);
        });
      </script>
    </>
  )
}
