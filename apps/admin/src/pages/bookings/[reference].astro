---
export const prerender = false;

import { actions } from 'astro:actions';
import AdminLayout from '../../layouts/AdminLayout.astro';
import Banner from '../../components/Banner.astro';
import DataTable from '../../components/DataTable.astro';
import EmptyState from '../../components/EmptyState.astro';
import Flag from '../../components/Flag.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { confirmActionLabel } from '../../components/confirm-label';
import { formatEuro } from '../../lib/money';
import { parseTstzRange, rangesOverlap } from '../../lib/range';
import { createSupabaseServerClient } from '../../lib/supabase';
import { formatAthens, formatAthensShort } from '../../lib/time';

const staff = Astro.locals.staff!;
const reference = Astro.params.reference!;
const supabase = createSupabaseServerClient(Astro.cookies);

const { data: booking, error } = await supabase
  .from('bookings')
  .select(
    `
    *,
    from_zone:zones!bookings_from_zone_id_fkey(name),
    to_zone:zones!bookings_to_zone_id_fkey(name),
    class:vehicle_classes!bookings_class_id_fkey(id, key, buffer_minutes),
    vehicle:vehicles!bookings_vehicle_id_fkey(id, label)
  `,
  )
  .eq('reference', reference)
  .maybeSingle();

const found = Boolean(booking) && !error;
if (!found) {
  Astro.response.status = 404;
}

function actionErr(
  result: { error?: { message?: string } | Error } | undefined,
): string | null {
  if (!result || !('error' in result) || !result.error) return null;
  const e = result.error;
  return typeof e === 'object' && e && 'message' in e ? String(e.message) : String(e);
}

let extras: {
  price_cents: number;
  quantity: number;
  extras: { code?: string; name?: string } | null;
}[] = [];
let payments: {
  created_at: string;
  kind: string;
  amount_cents: number;
  status: string;
  created_by: string | null;
}[] = [];
let paid = 0;
let refundable = 0;
let classVehicles: { id: string; label: string; busy: boolean }[] = [];
let fromName: string | undefined;
let toName: string | undefined;
let classKey = '—';
let vehicleError: string | null = null;
let pageError: string | null = null;
let refundConfirm = '';
let cancelConfirm = '';

if (found && booking) {
  const extrasRes = await supabase
    .from('booking_extras')
    .select('price_cents, quantity, extras(code, name)')
    .eq('booking_id', booking.id);
  extras = (extrasRes.data ?? []) as typeof extras;

  const paymentsRes = await supabase
    .from('payments')
    .select('created_at, kind, amount_cents, status, created_by')
    .eq('booking_id', booking.id)
    .order('created_at', { ascending: true });
  payments = paymentsRes.data ?? [];

  paid = payments
    .filter((p) => p.kind === 'payment' && p.status === 'succeeded')
    .reduce((s, p) => s + p.amount_cents, 0);
  const refunded = payments
    .filter((p) => p.kind === 'refund' && p.status === 'succeeded')
    .reduce((s, p) => s + p.amount_cents, 0);
  refundable = Math.max(0, paid - refunded);

  const ownRange = parseTstzRange(booking.blocked_range);
  const classId = (booking.class as { id: string } | null)?.id;
  if (classId) {
    const { data: vehicles } = await supabase
      .from('vehicles')
      .select('id, label')
      .eq('class_id', classId)
      .eq('status', 'active')
      .order('label');

    const busy = new Set<string>();
    if (ownRange) {
      const { data: busyBookings } = await supabase
        .from('bookings')
        .select('id, vehicle_id, blocked_range, status')
        .eq('class_id', classId)
        .not('vehicle_id', 'is', null)
        .in('status', ['pending', 'confirmed', 'assigned']);

      const { data: blocks } = await supabase.from('blocked_slots').select('vehicle_id, range');

      for (const b of busyBookings ?? []) {
        if (b.id === booking.id || !b.vehicle_id) continue;
        const r = parseTstzRange(b.blocked_range);
        if (r && rangesOverlap(ownRange, r)) busy.add(b.vehicle_id);
      }
      for (const s of blocks ?? []) {
        const r = parseTstzRange(s.range);
        if (r && rangesOverlap(ownRange, r)) busy.add(s.vehicle_id);
      }
    }

    classVehicles = (vehicles ?? []).map((v) => ({
      id: v.id,
      label: busy.has(v.id) && v.id !== booking.vehicle_id ? `${v.label} (busy)` : v.label,
      busy: busy.has(v.id) && v.id !== booking.vehicle_id,
    }));
  }

  fromName = (booking.from_zone as { name?: string } | null)?.name;
  toName = (booking.to_zone as { name?: string } | null)?.name;
  classKey = (booking.class as { key?: string } | null)?.key ?? '—';

  vehicleError = actionErr(Astro.getActionResult?.(actions.assignVehicle));
  pageError =
    actionErr(Astro.getActionResult?.(actions.saveNotesInvoice)) ||
    actionErr(Astro.getActionResult?.(actions.refundBooking)) ||
    actionErr(Astro.getActionResult?.(actions.cancelBooking));

  refundConfirm = confirmActionLabel('Refund', refundable);
  cancelConfirm = confirmActionLabel(
    paid > 0 ? 'Cancel and refund' : 'Cancel',
    paid > 0 ? paid : 0,
  );
}
---

{
  !found || !booking ? (
    <AdminLayout
      title="Booking not found"
      current="bookings"
      staffEmail={staff.email}
      crumbs={[{ href: '/bookings', label: 'Bookings' }, { label: reference }]}
    >
      <EmptyState title="Booking not found">
        No booking with reference <strong>{reference}</strong>. It may have expired or the link is
        wrong. <a href="/bookings">Back to bookings</a>
      </EmptyState>
    </AdminLayout>
  ) : (
    <>
      <AdminLayout
        title={reference}
        current="bookings"
        staffEmail={staff.email}
        crumbs={[{ href: '/bookings', label: 'Bookings' }, { label: reference }]}
      >
        <div class="row" slot="actions">
          <StatusBadge status={booking.status} />
          {booking.vip_security && <Flag kind="vip" />}
          {booking.booking_type === 'hourly' && <Flag kind="hourly" />}
        </div>

        {pageError && (
          <Banner tone="danger" role="alert">
            {pageError}
          </Banner>
        )}

        <div class="cols cols-main">
          <div class="stack">
            <section class="panel" aria-labelledby="t-h" id="assign">
              <div class="panel-head">
                <h2 id="t-h">Trip</h2>
              </div>
              <div class="panel-body stack-sm">
                <dl class="facts">
                  <dt>Type</dt>
                  <dd>{booking.booking_type === 'hourly' ? 'Hourly' : 'Transfer'}</dd>
                  <dt>Pick-up</dt>
                  <dd>{formatAthens(booking.pickup_at)} (Athens)</dd>
                  <dt>From</dt>
                  <dd>
                    {fromName ?? '—'}
                    {booking.pickup_address ? ` · ${booking.pickup_address}` : ''}
                  </dd>
                  {booking.booking_type === 'transfer' && (
                    <>
                      <dt>To</dt>
                      <dd>
                        {toName ?? '—'}
                        {booking.dropoff_address ? ` · ${booking.dropoff_address}` : ''}
                      </dd>
                    </>
                  )}
                  {booking.booking_type === 'hourly' && (
                    <>
                      <dt>Hours</dt>
                      <dd>{Math.round((booking.duration_minutes || 0) / 60)}</dd>
                    </>
                  )}
                  <dt>Flight</dt>
                  <dd>{booking.flight_number || '—'}</dd>
                  <dt>Passengers</dt>
                  <dd>
                    {booking.passengers} · {booking.luggage} bags
                  </dd>
                  <dt>Class</dt>
                  <dd>{classKey}</dd>
                </dl>

                <form
                  method="POST"
                  action={actions.assignVehicle}
                  class="stack-sm"
                  aria-label="Assign vehicle"
                >
                  <input type="hidden" name="reference" value={reference} />
                  <div class="field">
                    <label for="veh">Vehicle</label>
                    <select
                      id="veh"
                      class="input"
                      name="vehicleId"
                      aria-invalid={vehicleError ? 'true' : undefined}
                      aria-describedby={vehicleError ? 'veh-err' : undefined}
                    >
                      <option value="">— Not assigned —</option>
                      {classVehicles.map((v) => (
                        <option value={v.id} selected={booking.vehicle_id === v.id}>
                          {v.label}
                        </option>
                      ))}
                    </select>
                    {vehicleError && (
                      <p class="error-text" id="veh-err" role="alert">
                        {vehicleError}
                      </p>
                    )}
                  </div>
                  <div class="row">
                    <button class="btn" type="submit">
                      Assign
                    </button>
                  </div>
                </form>
                {booking.status === 'assigned' && (
                  <form method="POST" action={actions.markCompleted}>
                    <input type="hidden" name="reference" value={reference} />
                    <button class="btn btn-quiet" type="submit">
                      Mark completed
                    </button>
                  </form>
                )}
              </div>
            </section>

            <section class="panel" aria-labelledby="c-h">
              <div class="panel-head">
                <h2 id="c-h">Customer</h2>
              </div>
              <div class="panel-body stack-sm">
                <dl class="facts">
                  <dt>Name</dt>
                  <dd>{booking.customer_name}</dd>
                  <dt>Email</dt>
                  <dd>{booking.customer_email}</dd>
                  <dt>Phone</dt>
                  <dd>{booking.customer_phone}</dd>
                  <dt>Notes</dt>
                  <dd>{booking.notes || '—'}</dd>
                </dl>
                <form method="POST" action={actions.saveNotesInvoice} class="stack-sm">
                  <input type="hidden" name="reference" value={reference} />
                  <p class="eyebrow">VIP security</p>
                  <div class="field">
                    <label for="sec">Security notes (agents or partner)</label>
                    <textarea id="sec" class="input" name="securityNotes" rows="3">
                      {booking.security_notes ?? ''}
                    </textarea>
                  </div>
                  <p class="eyebrow">Invoice</p>
                  {booking.invoice_company && (
                    <p class="muted small">
                      {booking.invoice_company}
                      {booking.invoice_vat ? ` · VAT ${booking.invoice_vat}` : ''}
                      {booking.invoice_tax_office
                        ? ` · Tax office ${booking.invoice_tax_office}`
                        : ''}
                      {booking.invoice_address ? ` · ${booking.invoice_address}` : ''}
                    </p>
                  )}
                  <div class="grid-fields">
                    <div class="field">
                      <label for="ist">Invoice status</label>
                      <select id="ist" class="input" name="invoiceStatus">
                        <option
                          value="not_required"
                          selected={booking.invoice_status === 'not_required'}
                        >
                          Not required
                        </option>
                        <option value="requested" selected={booking.invoice_status === 'requested'}>
                          Requested
                        </option>
                        <option value="issued" selected={booking.invoice_status === 'issued'}>
                          Issued
                        </option>
                      </select>
                    </div>
                    <div class="field">
                      <label for="inr">Invoice number</label>
                      <input
                        id="inr"
                        class="input"
                        name="invoiceNumber"
                        value={booking.invoice_number ?? ''}
                      />
                    </div>
                  </div>
                  <button class="btn btn-secondary" type="submit">
                    Save notes and invoice
                  </button>
                </form>
              </div>
            </section>
          </div>

          <div class="stack">
            <section class="panel" aria-labelledby="p-h">
              <div class="panel-head">
                <h2 id="p-h">Payment</h2>
              </div>
              <div class="panel-body stack-sm">
                <dl class="totals">
                  <div>
                    <dt>Vehicle</dt>
                    <dd>{formatEuro(booking.base_price_cents)}</dd>
                  </div>
                  {extras.map((e) => {
                    const ex = e.extras as { name?: string } | null;
                    return (
                      <div>
                        <dt>{ex?.name ?? 'Extra'}</dt>
                        <dd>{formatEuro(e.price_cents * e.quantity)}</dd>
                      </div>
                    );
                  })}
                  <div class="grand">
                    <dt>Total</dt>
                    <dd>{formatEuro(booking.price_cents)}</dd>
                  </div>
                  <div>
                    <dt>Refundable</dt>
                    <dd>{formatEuro(refundable)}</dd>
                  </div>
                </dl>
                <div class="row">
                  <button
                    class="btn btn-secondary"
                    type="button"
                    id="open-refund"
                    disabled={refundable <= 0}
                  >
                    Refund…
                  </button>
                  <button
                    class="btn btn-danger"
                    type="button"
                    id="open-cancel"
                    disabled={booking.status === 'cancelled' || booking.status === 'completed'}
                  >
                    Cancel booking…
                  </button>
                </div>
              </div>
            </section>

            <section class="panel" aria-labelledby="pay-h">
              <div class="panel-head">
                <h2 id="pay-h">Payment history</h2>
              </div>
              <div class="panel-body">
                {payments.length === 0 ? (
                  <EmptyState title="No payments">No payments yet.</EmptyState>
                ) : (
                  <DataTable label="Payment history" cards>
                    <thead>
                      <tr>
                        <th scope="col">When</th>
                        <th scope="col">Kind</th>
                        <th scope="col" class="num">
                          Amount
                        </th>
                        <th scope="col">Status</th>
                        <th scope="col">By</th>
                      </tr>
                    </thead>
                    <tbody>
                      {payments.map((p) => (
                        <tr>
                          <td data-label="When">{formatAthensShort(p.created_at)}</td>
                          <td data-label="Kind">{p.kind}</td>
                          <td class="num" data-label="Amount">
                            {formatEuro(p.amount_cents)}
                          </td>
                          <td data-label="Status">{p.status}</td>
                          <td data-label="By">{p.created_by ? 'Staff' : 'Viva'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </DataTable>
                )}
              </div>
            </section>
          </div>
        </div>
      </AdminLayout>

      <dialog class="dialog" id="refund-dialog" aria-labelledby="refund-h">
        <form method="POST" action={actions.refundBooking} id="refund-form">
          <div class="dialog-head">
            <p class="eyebrow">{reference}</p>
            <h2 id="refund-h">Refund a payment</h2>
          </div>
          <div class="dialog-body">
            <dl class="restate">
              <dt>Customer</dt>
              <dd>{booking.customer_name}</dd>
              <dt>Refundable</dt>
              <dd class="amount">{formatEuro(refundable)}</dd>
            </dl>
            <input type="hidden" name="reference" value={reference} />
            <input type="hidden" name="idempotencyKey" id="refund-idem" value="" />
            <div class="field">
              <label for="amt">Amount to refund</label>
              <div class="input-money">
                <input
                  id="amt"
                  class="input"
                  name="amountEuros"
                  required
                  inputmode="decimal"
                  value={(refundable / 100).toFixed(2)}
                  aria-describedby="amt-help"
                />
              </div>
              <p class="help" id="amt-help">
                Up to {formatEuro(refundable)}.
              </p>
            </div>
            <div class="field">
              <label for="rr">Reason (staff only)</label>
              <input id="rr" class="input" name="reason" required value="Customer refund" />
            </div>
          </div>
          <div class="dialog-foot">
            <button class="btn btn-quiet" type="button" id="close-refund">
              Back
            </button>
            <button class="btn" type="submit" id="confirm-refund">
              {refundConfirm}
            </button>
          </div>
        </form>
      </dialog>

      <dialog class="dialog" id="cancel-dialog" aria-labelledby="cancel-h">
        <form method="POST" action={actions.cancelBooking} id="cancel-form">
          <div class="dialog-head">
            <p class="eyebrow">{reference}</p>
            <h2 id="cancel-h">Cancel this booking?</h2>
          </div>
          <div class="dialog-body">
            <dl class="restate">
              <dt>Customer</dt>
              <dd>{booking.customer_name}</dd>
              <dt>Pick-up</dt>
              <dd>{formatAthens(booking.pickup_at)}</dd>
              <dt>Refund</dt>
              <dd class="amount">{formatEuro(paid)}</dd>
            </dl>
            <input type="hidden" name="reference" value={reference} />
            <input type="hidden" name="idempotencyKey" id="cancel-idem" value="" />
            <div class="field">
              <label for="cr">Reason</label>
              <input id="cr" class="input" name="reason" required value="Office cancellation" />
            </div>
            <div class="field">
              <label for="rf">Refund</label>
              <select id="rf" class="input" name="refund">
                <option value="full">Full refund</option>
                <option value="none">No refund</option>
              </select>
            </div>
          </div>
          <div class="dialog-foot">
            <button class="btn btn-quiet" type="button" id="close-cancel">
              Keep booking
            </button>
            <button class="btn btn-danger-solid" type="submit" id="confirm-cancel">
              {paid > 0 ? cancelConfirm : 'Cancel booking'}
            </button>
          </div>
        </form>
      </dialog>

      <script>
        const refundDlg = document.getElementById('refund-dialog') as HTMLDialogElement | null;
        const cancelDlg = document.getElementById('cancel-dialog') as HTMLDialogElement | null;
        document.getElementById('open-refund')?.addEventListener('click', () => {
          const el = document.getElementById('refund-idem') as HTMLInputElement | null;
          if (el) el.value = crypto.randomUUID();
          refundDlg?.showModal();
          document.getElementById('amt')?.focus();
        });
        document.getElementById('close-refund')?.addEventListener('click', () => refundDlg?.close());
        document.getElementById('open-cancel')?.addEventListener('click', () => {
          const el = document.getElementById('cancel-idem') as HTMLInputElement | null;
          if (el) el.value = crypto.randomUUID();
          cancelDlg?.showModal();
          document.getElementById('cr')?.focus();
        });
        document.getElementById('close-cancel')?.addEventListener('click', () => cancelDlg?.close());
      </script>
    </>
  )
}
