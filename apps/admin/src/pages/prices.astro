---
export const prerender = false;

import { actions } from 'astro:actions';
import AdminLayout from '../layouts/AdminLayout.astro';
import Banner from '../components/Banner.astro';
import ConfirmDot from '../components/ConfirmDot.astro';
import Select from '../components/Select.astro';
import { logListError, resolveListLoad } from '../lib/bookings-list';
import { centsToEuroInput } from '../lib/money';
import { features } from '@tem/features';
import { createSupabaseServerClient } from '../lib/supabase';

const staff = Astro.locals.staff!;
const supabase = createSupabaseServerClient(Astro.cookies);
const distanceOn = features().distancePricing;
const pageTitle = distanceOn ? 'Fixed routes' : 'Zone prices';
const classKey = Astro.url.searchParams.get('class') || '';

function actionErr(result: { error?: { message?: string } | Error } | undefined): string | null {
  if (!result || !('error' in result) || !result.error) return null;
  const e = result.error;
  return typeof e === 'object' && e && 'message' in e ? String(e.message) : String(e);
}
const clearError =
  actionErr(Astro.getActionResult?.(actions.clearDemo)) ||
  actionErr(Astro.getActionResult?.(actions.clearDemoAll));

const classesRes = await supabase
  .from('vehicle_classes')
  .select('id, key, name')
  .eq('active', true)
  .order('sort_order');
const classesLoad = resolveListLoad('vehicle classes', classesRes.data, classesRes.error);
if (classesRes.error) logListError('prices_classes', classesRes.error.message);
const classes = classesLoad.ok ? classesLoad.rows : [];
const selected = classes.find((c) => c.key === classKey) ?? classes[0] ?? null;

const zonesRes = await supabase
  .from('zones')
  .select('id, code, name')
  .eq('active', true)
  .order('sort_order');
const zonesLoad = resolveListLoad('zones', zonesRes.data, zonesRes.error);
if (zonesRes.error) logListError('prices_zones', zonesRes.error.message);

const pricesRes = selected
  ? await supabase
      .from('zone_prices')
      .select('from_zone_id, to_zone_id, price_cents, is_demo')
      .eq('class_id', selected.id)
  : {
      data: [] as {
        from_zone_id: string;
        to_zone_id: string;
        price_cents: number;
        is_demo: boolean;
      }[],
      error: null,
    };
if (pricesRes.error) logListError('prices_zone_prices', pricesRes.error.message);
const pricesLoad = resolveListLoad('zone prices', pricesRes.data, pricesRes.error);

const priceMap = new Map(
  (pricesLoad.ok ? pricesLoad.rows : []).map((p) => [
    `${p.from_zone_id}:${p.to_zone_id}`,
    { cents: p.price_cents, isDemo: p.is_demo },
  ]),
);

type RouteRow = {
  from_zone_id: string;
  to_zone_id: string;
  duration_minutes: number;
  featured: boolean;
  featured_order: number;
  from_zone: { name: string; display_place_id: string | null } | null;
  to_zone: { name: string; display_place_id: string | null } | null;
};

const routesRes = await supabase.from('zone_routes').select(
  'from_zone_id, to_zone_id, duration_minutes, featured, featured_order, from_zone:zones!zone_routes_from_zone_id_fkey(name, display_place_id), to_zone:zones!zone_routes_to_zone_id_fkey(name, display_place_id)',
);
if (routesRes.error) logListError('prices_routes', routesRes.error.message);
const routes = (routesRes.error ? [] : (routesRes.data ?? [])) as RouteRow[];
const zones = zonesLoad.ok ? zonesLoad.rows : [];
const featuredErr = actionErr(Astro.getActionResult?.(actions.saveFeaturedRoutes));

const listError =
  (!classesLoad.ok && classesLoad.message) ||
  (!zonesLoad.ok && zonesLoad.message) ||
  (!pricesLoad.ok && pricesLoad.message) ||
  (routesRes.error ? `Could not load routes: ${routesRes.error.message}` : null);

const hasUnconfirmed = [...priceMap.values()].some((c) => c.isDemo);
const shortName = (name: string) =>
  name
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .replace(/\s+(Airport|Port|Area|Zone)$/i, '');
---

<AdminLayout title={pageTitle} current="prices" staffEmail={staff.email}>
  {
    hasUnconfirmed && selected && (
      <form method="POST" action={actions.clearDemoAll} slot="actions">
        <input type="hidden" name="scope" value="zone_prices" />
        <input type="hidden" name="classId" value={selected.id} />
        <button class="btn btn-secondary" type="submit">Confirm all</button>
      </form>
    )
  }
  {
    (listError || clearError) && (
      <Banner tone="danger" role="alert">
        {listError || clearError}
      </Banner>
    )
  }
  <p class="muted">
    Prices in euros. Changes apply to new bookings only. An empty cell means no online price.
    {
      distanceOn && (
        <> In hybrid mode these prices win over the distance price.</>
      )
    }
  </p>

  <form method="get" class="filters">
    <div class="field">
      <label for="cls">Vehicle class</label>
      <Select
        id="cls"
        name="class"
        autoSubmit
        options={classes.map((c) => ({
          value: c.key,
          label: c.name || '—',
          selected: selected?.id === c.id,
        }))}
      />
    </div>
  </form>

  {
    selected && (
      <form method="POST" action={actions.saveZonePrices} class="stack" id="prices-form">
        <input type="hidden" name="classId" value={selected.id} />
        <input type="hidden" name="cellsJson" id="cellsJson" value="{}" />
        <div class="table-wrap" role="region" tabindex="0" aria-label="Zone price matrix">
          <table class="table matrix">
            <thead>
              <tr>
                <th scope="col">From \ To</th>
                {zones.map((z) => (
                  <th scope="col" title={z.name}>{shortName(z.name)}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {zones.map((fromZ) => (
                <tr>
                  <th scope="row" title={fromZ.name}>{shortName(fromZ.name)}</th>
                  {zones.map((toZ) => {
                    if (fromZ.id === toZ.id) return <td>-</td>;
                    const cell = priceMap.get(`${fromZ.id}:${toZ.id}`);
                    const cellId = `${fromZ.id}:${toZ.id}:${selected.id}`;
                    return (
                      <td class:list={[{ 'is-dashed': cell?.isDemo }]}>
                        {
                          cell != null && (
                            <ConfirmDot confirmed={!cell.isDemo} />
                          )
                        }
                        <div class="input-money">
                          <input
                            class="input price-cell"
                            data-key={`${fromZ.id}:${toZ.id}`}
                            aria-label={`${fromZ.name} to ${toZ.name}`}
                            value={cell != null ? centsToEuroInput(cell.cents) : ''}
                            inputmode="decimal"
                          />
                        </div>
                        {
                          cell?.isDemo && (
                            <button
                              class="btn btn-secondary btn-sm"
                              type="submit"
                              formaction={actions.clearDemo}
                              name="clear"
                              value={`zone_prices|${cellId}`}
                              formnovalidate
                            >
                              Mark confirmed
                            </button>
                          )
                        }
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="save-bar" id="price-save-bar" hidden>
          <strong><span id="price-change-count">0</span> unsaved changes</strong>
          <span aria-hidden="true">·</span>
          <button class="btn btn-quiet btn-sm" type="button" id="discard-prices">Discard</button>
          <span aria-hidden="true">·</span>
          <button class="btn btn-sm" type="submit" id="save-prices">Save</button>
        </div>
      </form>
    )
  }

  <section class="stack" aria-labelledby="r-h">
    <h2 id="r-h">Popular routes (booking widget)</h2>
    <p class="muted">
      Show up to 8 routes in the search widget. Both zones need a widget address (Zones → Edit).
    </p>
    {
      featuredErr && (
        <Banner tone="danger" role="alert">
          {featuredErr}
        </Banner>
      )
    }
    <form method="POST" action={actions.saveFeaturedRoutes} class="stack" id="featured-form">
      <input type="hidden" name="rowsJson" id="featuredRowsJson" value="[]" />
      <div class="table-wrap" role="region" tabindex="0" aria-label="Popular routes">
        <table class="table table-cards">
          <thead>
            <tr>
              <th scope="col">Route</th>
              <th scope="col" class="num">Minutes</th>
              <th scope="col">Show</th>
              <th scope="col" class="num">Order</th>
            </tr>
          </thead>
          <tbody>
            {
              routes.map((r) => {
                const from = r.from_zone?.name?.trim() || '—';
                const to = r.to_zone?.name?.trim() || '—';
                const ready = Boolean(r.from_zone?.display_place_id && r.to_zone?.display_place_id);
                return (
                  <tr
                    data-featured-row
                    data-from={r.from_zone_id}
                    data-to={r.to_zone_id}
                  >
                    <td data-label="Route">
                      {from} <span class="muted" aria-hidden="true">→</span> {to}
                      {!ready && (
                        <p class="help">Add the widget address to both zones to show this route</p>
                      )}
                    </td>
                    <td class="num" data-label="Minutes">
                      {r.duration_minutes}
                    </td>
                    <td data-label="Show">
                      <label class="switch">
                        <input
                          type="checkbox"
                          data-featured
                          checked={r.featured || undefined}
                          disabled={!ready || undefined}
                        />
                        <span class="sr-only">Show in popular routes</span>
                      </label>
                    </td>
                    <td class="num" data-label="Order">
                      <input
                        class="input"
                        type="number"
                        data-featured-order
                        value={r.featured_order ?? 100}
                        style="width:5rem"
                        disabled={!ready || undefined}
                      />
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <button class="btn" type="submit">Save popular routes</button>
    </form>
  </section>
</AdminLayout>

<script>
  const form = document.getElementById('prices-form') as HTMLFormElement | null;
  const hidden = document.getElementById('cellsJson') as HTMLInputElement | null;
  const bar = document.getElementById('price-save-bar');
  const count = document.getElementById('price-change-count');
  const cells = [...document.querySelectorAll<HTMLInputElement>('.price-cell')];
  function refresh() {
    let changed = 0;
    cells.forEach((el) => {
      const dirty = el.value !== el.defaultValue;
      el.closest('td')?.classList.toggle('changed', dirty);
      if (dirty) changed += 1;
    });
    if (count) count.textContent = String(changed);
    if (bar) bar.hidden = changed === 0;
  }
  cells.forEach((el) => el.addEventListener('input', refresh));
  document.getElementById('discard-prices')?.addEventListener('click', () => {
    cells.forEach((el) => (el.value = el.defaultValue));
    refresh();
  });
  form?.addEventListener('submit', () => {
    const values: Record<string, string> = {};
    document.querySelectorAll<HTMLInputElement>('.price-cell').forEach((el) => {
      const key = el.dataset.key;
      if (key) values[key] = el.value;
    });
    if (hidden) hidden.value = JSON.stringify(values);
  });

  document.getElementById('featured-form')?.addEventListener('submit', () => {
    const rows = [...document.querySelectorAll<HTMLElement>('[data-featured-row]')].map((tr) => ({
      fromId: tr.dataset.from,
      toId: tr.dataset.to,
      featured: Boolean(tr.querySelector<HTMLInputElement>('[data-featured]')?.checked),
      order: Number(tr.querySelector<HTMLInputElement>('[data-featured-order]')?.value || 100),
    }));
    const out = document.getElementById('featuredRowsJson') as HTMLInputElement | null;
    if (out) out.value = JSON.stringify(rows);
  });
</script>

<style>
  .matrix .input-money { width: 7rem; }
  .matrix .input-money .input { width: 100%; }
  .matrix th:first-child { position: sticky; left: 0; z-index: 3; background: var(--color-surface-2); }
  .save-bar {
    position: sticky;
    bottom: 1rem;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: .5rem;
    padding: .75rem 1rem;
    border: 1px solid var(--color-accent);
    background: var(--color-surface);
    box-shadow: var(--shadow-2);
  }
  .save-bar[hidden] { display: none; }
</style>
