---
export const prerender = false;

import { actions } from 'astro:actions';
import AdminLayout from '../layouts/AdminLayout.astro';
import ClassName from '../components/ClassName.astro';
import ConfirmDot from '../components/ConfirmDot.astro';
import { centsToEuroInput } from '../lib/money';
import { createSupabaseServerClient } from '../lib/supabase';

const staff = Astro.locals.staff!;
const supabase = createSupabaseServerClient(Astro.cookies);

function actionErr(result: { error?: { message?: string } | Error } | undefined): string | null {
  if (!result || !('error' in result) || !result.error) return null;
  const e = result.error;
  return typeof e === 'object' && e && 'message' in e ? String(e.message) : String(e);
}
const pageErrorAll =
  actionErr(Astro.getActionResult?.(actions.saveHourlyRates)) ||
  actionErr(Astro.getActionResult?.(actions.clearDemo)) ||
  actionErr(Astro.getActionResult?.(actions.clearDemoAll));

const { data: classes } = await supabase
  .from('vehicle_classes')
  .select('id, key, name, active, hourly_rates(price_per_hour_cents, min_hours, max_hours, is_demo)')
  .order('sort_order');

const classRows = classes ?? [];
const hasUnconfirmed = classRows.some((c) => {
  const rate = Array.isArray(c.hourly_rates) ? c.hourly_rates[0] : c.hourly_rates;
  return Boolean(rate && 'is_demo' in rate && rate.is_demo);
});
---

<AdminLayout title="Hourly rates" current="hourly-rates" staffEmail={staff.email}>
  {
    hasUnconfirmed && (
      <form method="POST" action={actions.clearDemoAll} slot="actions">
        <input type="hidden" name="scope" value="hourly_rates" />
        <button class="btn btn-secondary" type="submit">Confirm all</button>
      </form>
    )
  }
  {
    pageErrorAll && (
      <div class="banner banner-danger" role="alert">
        <p>{pageErrorAll}</p>
      </div>
    )
  }
  <form method="POST" action={actions.saveHourlyRates} class="stack" id="hourly-rates-form">
    <input type="hidden" name="rowsJson" id="rowsJson" value="[]" />
    <div class="table-wrap" role="region" tabindex="0" aria-label="Data table">
      <table class="table table-cards">
        <thead>
          <tr>
            <th scope="col">Class</th>
            <th scope="col" class="num">Rate per hour (€)</th>
            <th scope="col" class="num">Min hours</th>
            <th scope="col" class="num">Max hours</th>
            <th scope="col" class="actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          {
            classRows.map((c) => {
              const rate = Array.isArray(c.hourly_rates) ? c.hourly_rates[0] : c.hourly_rates;
              const isDemo = Boolean(rate && 'is_demo' in rate && rate.is_demo);
              return (
                <tr data-class-id={c.id} class:list={[{ 'is-flag': isDemo }]}>
                  <th scope="row">
                    <ConfirmDot confirmed={!isDemo} />
                    <ClassName name={c.name} />
                    {!c.active && <span class="badge s-completed">Off</span>}
                  </th>
                  <td class="num">
                    <input
                      class="input rate"
                      aria-label={`${c.name || 'Class'} rate`}
                      value={rate ? centsToEuroInput(rate.price_per_hour_cents) : ''}
                    />
                  </td>
                  <td class="num">
                    <input class="input min" aria-label={`${c.name || 'Class'} min hours`} value={rate?.min_hours ?? 3} />
                  </td>
                  <td class="num">
                    <input class="input max" aria-label={`${c.name || 'Class'} max hours`} value={rate?.max_hours ?? 12} />
                  </td>
                  <td class="actions">
                    {
                      isDemo && (
                        <button
                          class="btn btn-secondary btn-sm"
                          type="submit"
                          formaction={actions.clearDemo}
                          name="clear"
                          value={`hourly_rates|${c.id}`}
                          formnovalidate
                        >
                          Mark confirmed
                        </button>
                      )
                    }
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <button class="btn" type="submit">Save hourly rates</button>
  </form>
</AdminLayout>

<script is:inline>
  document.getElementById('hourly-rates-form')?.addEventListener('submit', (ev) => {
    if (ev.submitter && ev.submitter.getAttribute('formaction')) return;
    const rows = [];
    document.querySelectorAll('tbody tr[data-class-id]').forEach((tr) => {
      rows.push({
        classId: tr.getAttribute('data-class-id'),
        rateEuros: tr.querySelector('.rate').value,
        minHours: String(tr.querySelector('.min').value),
        maxHours: String(tr.querySelector('.max').value),
      });
    });
    document.getElementById('rowsJson').value = JSON.stringify(rows);
  });
</script>
