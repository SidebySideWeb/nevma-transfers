---
export const prerender = false;

import { actions } from 'astro:actions';
import AdminLayout from '../layouts/AdminLayout.astro';
import {
  autoAssignSettingValue,
  parseAutoAssignSetting,
} from '../components/auto-badge';
import { createSupabaseServerClient } from '../lib/supabase';

const staff = Astro.locals.staff!;
const supabase = createSupabaseServerClient(Astro.cookies);
const { data: settings } = await supabase.from('settings').select('*').order('key');

function valueForInput(value: unknown): string {
  return JSON.stringify(value);
}

const autoKey = 'auto_assign_single_vehicle';
---

<AdminLayout title="Settings" current="settings" staffEmail={staff.email}>
  <p class="muted">Saving a value clears the DEMO flag for that row. Enter JSON (e.g. 20 or "Europe/Athens").</p>
  <div class="stack">
    {
      (settings ?? []).map((s) => {
        if (s.key === autoKey) {
          const on = parseAutoAssignSetting(s.value);
          return (
            <form
              method="POST"
              action={actions.saveSetting}
              class:list={['panel', 'stack', { demo: s.is_demo }]}
              data-auto-assign-form
            >
              <div class="row" style="justify-content:space-between">
                <strong>Assign the vehicle automatically when a class has one vehicle</strong>
                {s.is_demo ? <span class="badge s-pending">DEMO</span> : null}
              </div>
              {s.description ? <p class="muted">{s.description}</p> : null}
              <input type="hidden" name="key" value={s.key} />
              <input type="hidden" name="value" value={autoAssignSettingValue(on)} data-auto-assign-value />
              <label class="switch">
                <input
                  type="checkbox"
                  checked={on || undefined}
                  data-auto-assign-switch
                />
                On
              </label>
              <div class="row" style="gap:0.5rem">
                <button class="btn btn-quiet" type="submit">Save</button>
                {
                  s.is_demo ? (
                    <button
                      class="btn btn-secondary btn-sm"
                      type="submit"
                      formaction={actions.clearDemo}
                      name="clear"
                      value={`settings|${s.key}`}
                      formnovalidate
                    >
                      Confirmed
                    </button>
                  ) : null
                }
              </div>
            </form>
          );
        }
        return (
          <form
            method="POST"
            action={actions.saveSetting}
            class:list={['panel', 'stack', { demo: s.is_demo }]}
          >
            <div class="row" style="justify-content:space-between">
              <strong>{s.key}</strong>
              {s.is_demo ? <span class="badge s-pending">DEMO</span> : null}
            </div>
            {s.description ? <p class="muted">{s.description}</p> : null}
            <input type="hidden" name="key" value={s.key} />
            <div class="field">
              <label for={`v-${s.key}`}>Value</label>
              <input class="input" id={`v-${s.key}`} name="value" value={valueForInput(s.value)} />
            </div>
            <div class="row" style="gap:0.5rem">
              <button class="btn btn-quiet" type="submit">Save</button>
              {
                s.is_demo ? (
                  <button
                    class="btn btn-secondary btn-sm"
                    type="submit"
                    formaction={actions.clearDemo}
                    name="clear"
                    value={`settings|${s.key}`}
                    formnovalidate
                  >
                    Confirmed
                  </button>
                ) : null
              }
            </div>
          </form>
        );
      })
    }
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('[data-auto-assign-form]').forEach((form) => {
    const sw = form.querySelector('[data-auto-assign-switch]');
    const val = form.querySelector('[data-auto-assign-value]');
    if (!(sw instanceof HTMLInputElement) || !(val instanceof HTMLInputElement)) return;
    sw.addEventListener('change', () => {
      val.value = sw.checked ? 'true' : 'false';
    });
  });
</script>

<style>
  .panel.demo {
    border-color: var(--color-warning, #c9a227);
    background: color-mix(in srgb, var(--color-warning, #c9a227) 8%, transparent);
  }
</style>
