---
export const prerender = false;

import { actions } from 'astro:actions';
import AdminLayout from '../layouts/AdminLayout.astro';
import Flag from '../components/Flag.astro';
import { centsToEuroInput } from '../lib/money';
import { createSupabaseServerClient } from '../lib/supabase';

const BUILTIN = new Set(['vip-security', 'night-surcharge']);

const staff = Astro.locals.staff!;
const supabase = createSupabaseServerClient(Astro.cookies);

function actionErr(result: { error?: { message?: string } | Error } | undefined): string | null {
  if (!result || !('error' in result) || !result.error) return null;
  const e = result.error;
  return typeof e === 'object' && e && 'message' in e ? String(e.message) : String(e);
}

const pageError =
  actionErr(Astro.getActionResult?.(actions.saveExtras)) ||
  actionErr(Astro.getActionResult?.(actions.addExtra)) ||
  actionErr(Astro.getActionResult?.(actions.deleteExtra)) ||
  actionErr(Astro.getActionResult?.(actions.clearDemo));

const [{ data: extras }, { data: usedExtras }] = await Promise.all([
  supabase.from('extras').select('*').order('code'),
  supabase.from('booking_extras').select('extra_id'),
]);
const usedIds = new Set((usedExtras ?? []).map((r) => r.extra_id));
---

<AdminLayout title="Extras" current="extras" staffEmail={staff.email}>
  {
    pageError && (
      <div class="banner banner-danger" role="alert">
        <p>{pageError}</p>
      </div>
    )
  }

  <div class="page-head" style="padding:0 0 1rem;display:flex;justify-content:flex-end">
    <button class="btn btn-secondary" type="button" data-open="add-extra">Add extra</button>
  </div>

  <form method="POST" action={actions.saveExtras} class="stack">
    <input type="hidden" name="rowsJson" id="rowsJson" value="[]" />
    <div class="table-wrap" role="region" tabindex="0" aria-labelledby="ex-cap">
      <table class="table table-cards">
        <caption id="ex-cap" class="sr-only">Extras</caption>
        <thead>
          <tr>
            <th scope="col">Extra</th>
            <th scope="col">Code</th>
            <th scope="col" class="num">Price (€)</th>
            <th scope="col">Booking types</th>
            <th scope="col" class="num">Max qty</th>
            <th scope="col">Online</th>
            <th scope="col" class="actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          {
            (extras ?? []).map((e) => {
              const builtin = BUILTIN.has(e.code);
              const canDelete = !builtin && !usedIds.has(e.id);
              const applies = e.applies_to ?? ['transfer', 'hourly'];
              return (
                <tr data-id={e.id} class:list={[{ 'is-flag': builtin || e.is_demo }]}>
                  <td class="card-title" data-label="Extra">
                    <input class="input name" aria-label={`${e.code} name`} value={e.name} />
                    {builtin && <span class="badge plain">Built in</span>}
                    {e.is_demo && <Flag kind="demo" />}
                  </td>
                  <td data-label="Code" class="mono">
                    {e.code}
                  </td>
                  <td class="num" data-label="Price">
                    <div class="input-money">
                      <input
                        class="input price"
                        aria-label={`${e.code} price`}
                        value={centsToEuroInput(e.price_cents)}
                        inputmode="decimal"
                      />
                    </div>
                  </td>
                  <td data-label="Booking types">
                    <label class="check">
                      <input
                        type="checkbox"
                        class="applies-transfer"
                        checked={applies.includes('transfer')}
                        aria-label={`${e.code} transfer`}
                      />
                      Transfer
                    </label>
                    <label class="check">
                      <input
                        type="checkbox"
                        class="applies-hourly"
                        checked={applies.includes('hourly')}
                        aria-label={`${e.code} by the hour`}
                      />
                      By the hour
                    </label>
                  </td>
                  <td class="num" data-label="Max qty">
                    <input
                      class="input max-qty"
                      type="number"
                      min="1"
                      max="10"
                      value={e.max_quantity ?? 1}
                      aria-label={`${e.code} max quantity`}
                      style="width:4.5rem"
                    />
                  </td>
                  <td data-label="Online">
                    <label class="switch">
                      <input
                        type="checkbox"
                        class="active"
                        checked={e.active}
                        aria-label={`${e.code} online`}
                      />
                    </label>
                  </td>
                  <td class="actions" data-label="">
                    {
                      e.is_demo && (
                        <button
                          class="btn btn-secondary btn-sm"
                          type="submit"
                          formaction={actions.clearDemo}
                          name="clear"
                          value={`extras|${e.id}`}
                          formnovalidate
                        >
                          Confirmed
                        </button>
                      )
                    }
                    {
                      canDelete ? (
                        <button
                          class="btn btn-danger-solid btn-sm"
                          type="submit"
                          formaction={actions.deleteExtra}
                          name="id"
                          value={e.id}
                          formnovalidate
                        >
                          Delete
                        </button>
                      ) : builtin ? (
                        <span class="muted small">Built in</span>
                      ) : (
                        <span class="muted small">In use</span>
                      )
                    }
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <div class="row" style="margin-top:1rem;justify-content:flex-end">
      <button class="btn" type="submit">Save extras</button>
    </div>
  </form>
</AdminLayout>

<dialog class="dialog" id="add-extra" aria-labelledby="d-ax">
  <form method="POST" action={actions.addExtra}>
    <div class="dialog-head">
      <p class="eyebrow">Extras</p>
      <h2 id="d-ax">Add an extra</h2>
    </div>
    <div class="dialog-body stack-sm">
      <div class="grid-fields">
        <div class="field">
          <label for="ax-name">Name</label>
          <input id="ax-name" class="input" name="name" required />
        </div>
        <div class="field">
          <label for="ax-code">Code</label>
          <input
            id="ax-code"
            class="input mono"
            name="code"
            required
            pattern="^[a-z0-9]+(-[a-z0-9]+)*$"
          />
        </div>
      </div>
      <div class="field">
        <label for="ax-pr">Price</label>
        <div class="input-money">
          <input id="ax-pr" class="input" name="priceEuros" value="0.00" inputmode="decimal" required />
        </div>
      </div>
      <div class="grid-fields">
        <label class="check">
          <input type="checkbox" name="appliesTransfer" value="true" checked />
          Transfer
        </label>
        <label class="check">
          <input type="checkbox" name="appliesHourly" value="true" checked />
          By the hour
        </label>
        <div class="field">
          <label for="ax-mq">Max quantity</label>
          <input id="ax-mq" class="input" name="maxQuantity" type="number" min="1" max="10" value="1" />
        </div>
      </div>
      <p class="help">
        The customer-facing text comes from Sanity (UI strings). VIP security and Night surcharge are built in: they can
        be priced and switched off, not deleted.
      </p>
    </div>
    <div class="dialog-foot">
      <button class="btn btn-quiet" type="button" data-close="add-extra">Back</button>
      <button class="btn" type="submit">Add extra</button>
    </div>
  </form>
</dialog>

<script is:inline>
  document.querySelector('form')?.addEventListener('submit', (ev) => {
    const submitter = ev.submitter;
    if (submitter && submitter.getAttribute('formaction')) return;
    const rows = [];
    document.querySelectorAll('tbody tr[data-id]').forEach((tr) => {
      rows.push({
        id: tr.getAttribute('data-id'),
        name: tr.querySelector('.name').value,
        priceEuros: tr.querySelector('.price').value,
        active: tr.querySelector('.active').checked ? 'true' : 'false',
        appliesTransfer: tr.querySelector('.applies-transfer').checked ? 'true' : 'false',
        appliesHourly: tr.querySelector('.applies-hourly').checked ? 'true' : 'false',
        maxQuantity: tr.querySelector('.max-qty').value,
      });
    });
    document.getElementById('rowsJson').value = JSON.stringify(rows);
  });

  document.querySelectorAll('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.getElementById(btn.getAttribute('data-open'))?.showModal();
    });
  });
  document.querySelectorAll('[data-close]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.getElementById(btn.getAttribute('data-close'))?.close();
    });
  });
</script>
