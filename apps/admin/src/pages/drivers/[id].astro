<dialog class="dialog" id="statement-dialog" aria-labelledby="dd-st">
  <form method="POST" action={actions.buildDriverStatement}>
    <input type="hidden" name="driverId" value={driver.id} />
    <div class="dialog-head">
      <p class="eyebrow">{driver.full_name}</p>
      <h2 id="dd-st">New statement</h2>
    </div>
    <div class="dialog-body stack-sm">
      <fieldset class="seg" style="border:0;padding:0;margin:0">
        <legend class="sr-only">Period</legend>
        <input type="radio" name="periodKind" id="st-w" value="week" />
        <label for="st-w">Week</label>
        <input type="radio" name="periodKind" id="st-m" value="month" checked />
        <label for="st-m">Month</label>
        <input type="radio" name="periodKind" id="st-q" value="quarter" />
        <label for="st-q">3 months</label>
        <input type="radio" name="periodKind" id="st-c" value="custom" />
        <label for="st-c">Custom</label>
      </fieldset>
      <p class="help">Presets end yesterday ({yesterday}).</p>
      <div class="grid-fields">
        <div class="field">
          <label for="st-from">From</label>
          <input id="st-from" class="input" type="date" name="from" />
        </div>
        <div class="field">
          <label for="st-to">To</label>
          <input id="st-to" class="input" type="date" name="to" />
        </div>
      </div>
    </div>
    <div class="dialog-foot">
      <button class="btn btn-quiet" type="button" data-close="statement-dialog">Back</button>
      <button class="btn" type="submit">Build statement</button>
    </div>
  </form>
</dialog>

<script>
  const openShift = location.hash === '#shift-dialog' || new URLSearchParams(location.search).has('shift');
  const dlg = document.getElementById('shift-dialog');
  if (openShift && dlg instanceof HTMLDialogElement) dlg.showModal();
  if (location.hash === '#statements') {
    document.getElementById('statements')?.scrollIntoView();
  }
  document.querySelectorAll('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-open');
      const d = id && document.getElementById(id);
      if (d instanceof HTMLDialogElement) d.showModal();
    });
  });
  document.querySelectorAll('[data-close]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-close');
      const d = id && document.getElementById(id);
      if (d instanceof HTMLDialogElement) d.close();
    });
  });
</script>
