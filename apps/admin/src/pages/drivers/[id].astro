      </div>
      <div class="grid-fields">
        <div class="field">
          <label for="aj-a">Amount</label>
          <div class="input-money"><input id="aj-a" class="input" name="amountEuros" required inputmode="decimal" /></div>
        </div>
        <div class="field">
          <label for="aj-b">Booking (optional)</label>
          <input id="aj-b" class="input mono" name="bookingReference" />
