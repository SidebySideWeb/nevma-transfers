---
export const prerender = false;

import { actions } from 'astro:actions';
import AdminLayout from '../layouts/AdminLayout.astro';
import Flag from '../components/Flag.astro';
import Select from '../components/Select.astro';
import ShowDemoOffline from '../components/ShowDemoOffline.astro';
import { isDemoOrOffline, withDemoOfflineLast } from '../lib/demo-offline';
import { createSupabaseServerClient } from '../lib/supabase';

const ZONE_KINDS = [
  { value: 'airport', label: 'Airport' },
  { value: 'city', label: 'City' },
  { value: 'port', label: 'Port' },
  { value: 'area', label: 'Area' },
  { value: 'other', label: 'Other' },
] as const;

const DISPLAY_KINDS = [
  { value: '', label: '—' },
  { value: 'airport', label: 'Airport' },
  { value: 'port', label: 'Port' },
  { value: 'station', label: 'Station' },
  { value: 'hotel', label: 'Hotel' },
  { value: 'area', label: 'Area' },
] as const;

const staff = Astro.locals.staff!;
const supabase = createSupabaseServerClient(Astro.cookies);

function actionErr(result: { error?: { message?: string } | Error } | undefined): string | null {
  if (!result || !('error' in result) || !result.error) return null;
  const e = result.error;
  return typeof e === 'object' && e && 'message' in e ? String(e.message) : String(e);
}

const pageError =
  actionErr(Astro.getActionResult?.(actions.addZone)) ||
  actionErr(Astro.getActionResult?.(actions.saveZone)) ||
  actionErr(Astro.getActionResult?.(actions.deleteZone)) ||
  actionErr(Astro.getActionResult?.(actions.clearDemo));

const [{ data: zones }, { data: routes }, { data: bookings }] = await Promise.all([
  supabase.from('zones').select('*').order('sort_order'),
  supabase.from('zone_routes').select('from_zone_id, to_zone_id'),
  supabase.from('bookings').select('from_zone_id, to_zone_id'),
]);

const usedIds = new Set<string>();
const routeCounts = new Map<string, number>();
for (const r of routes ?? []) {
  usedIds.add(r.from_zone_id);
  usedIds.add(r.to_zone_id);
  routeCounts.set(r.from_zone_id, (routeCounts.get(r.from_zone_id) ?? 0) + 1);
  routeCounts.set(r.to_zone_id, (routeCounts.get(r.to_zone_id) ?? 0) + 1);
}
for (const b of bookings ?? []) {
  if (b.from_zone_id) usedIds.add(b.from_zone_id);
  if (b.to_zone_id) usedIds.add(b.to_zone_id);
}
const bookedIds = new Set<string>();
for (const b of bookings ?? []) {
  if (b.from_zone_id) bookedIds.add(b.from_zone_id);
  if (b.to_zone_id) bookedIds.add(b.to_zone_id);
}
const zoneList = withDemoOfflineLast(zones ?? []);
---

<AdminLayout title="Zones" current="zones" staffEmail={staff.email}>
  <button class="btn btn-secondary" type="button" data-open="add-zone" slot="actions">
    Add zone
  </button>

  {
    pageError && (
      <div class="banner banner-danger" role="alert">
        <p>{pageError}</p>
      </div>
    )
  }

  <div class="table-wrap" role="region" tabindex="0" aria-labelledby="z-cap">
    <table class="table table-cards">
      <caption id="z-cap" class="sr-only">Zones</caption>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Key</th>
          <th scope="col">Kind</th>
          <th scope="col">Routes</th>
          <th scope="col" class="actions"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        {
          zoneList.rows.map((z) => {
            const bury = isDemoOrOffline(z);
            return (
              <tr
                class:list={[{ 'is-muted': !z.active }]}
                data-demo-offline={bury ? 'zones' : undefined}
                hidden={bury || undefined}
              >
                <td class="card-title" data-label="Name">{z.name} {z.is_demo && <Flag kind="demo" />}</td>
                <td data-label="Key" class="mono">{z.code}</td>
                <td data-label="Kind">{ZONE_KINDS.find((k) => k.value === (z.kind ?? 'area'))?.label}</td>
                <td data-label="Routes">Used by {routeCounts.get(z.id) ?? 0} routes</td>
                <td class="actions" data-label="">
                  <button class="btn btn-quiet btn-sm" type="button" data-open={`edit-${z.id}`}>Edit</button>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  <ShowDemoOffline group="zones" count={zoneList.hiddenCount} />
</AdminLayout>

{
  zoneList.rows.map((z) => {
    const codeFixed = usedIds.has(z.id);
    const canDelete = !bookedIds.has(z.id);
    return (
      <dialog class="dialog" id={`edit-${z.id}`} aria-labelledby={`edit-h-${z.id}`}>
        <form method="POST" action={actions.saveZone}>
          <input type="hidden" name="id" value={z.id} />
          <div class="dialog-head"><p class="eyebrow">Zones</p><h2 id={`edit-h-${z.id}`}>Edit {z.name}</h2></div>
          <div class="dialog-body stack-sm">
            <div class="grid-fields">
              <div class="field"><label for={`zn-${z.id}`}>Name</label><input class="input" id={`zn-${z.id}`} name="name" value={z.name} required /></div>
              <div class="field">
                <label for={`zc-${z.id}`}>Key</label>
                <input class="input mono" id={`zc-${z.id}`} name={codeFixed ? undefined : 'code'} value={z.code} readonly={codeFixed || undefined} required />
              </div>
              <div class="field"><label for={`zo-${z.id}`}>Order</label><input class="input" id={`zo-${z.id}`} name="sortOrder" type="number" value={z.sort_order} /></div>
              <div class="field"><label for={`zk-${z.id}`}>Kind</label><Select id={`zk-${z.id}`} name="kind" options={ZONE_KINDS.map((k) => ({ value: k.value, label: k.label, selected: (z.kind ?? 'area') === k.value }))} /></div>
            </div>
            <label class="switch"><input type="checkbox" name="active" value="true" checked={z.active} /> {z.active ? 'On' : 'Off'}</label>
            <fieldset class="stack-sm" style="border:0;padding:0;margin:0">
              <legend class="eyebrow">Address shown in the booking widget</legend>
              <p class="help">Filled into Pick-up / Drop-off when a popular route is chosen. Clear all fields to remove.</p>
              <div class="field">
                <label for={`zda-${z.id}`}>Address</label>
                <input
                  class="input"
                  id={`zda-${z.id}`}
                  name="displayAddress"
                  value={z.display_address ?? ''}
                  data-zone-display-addr
                  autocomplete="off"
                  placeholder="Start typing an address"
                />
              </div>
              <input type="hidden" name="displayPlaceId" id={`zdp-${z.id}`} value={z.display_place_id ?? ''} data-zone-display-place />
              <input type="hidden" name="displayLat" id={`zdlat-${z.id}`} value={z.display_lat ?? ''} data-zone-display-lat />
              <input type="hidden" name="displayLng" id={`zdlng-${z.id}`} value={z.display_lng ?? ''} data-zone-display-lng />
              <div class="field">
                <label for={`zdk-${z.id}`}>Type</label>
                <Select
                  id={`zdk-${z.id}`}
                  name="displayKind"
                  options={DISPLAY_KINDS.map((k) => ({
                    value: k.value,
                    label: k.label,
                    selected: (z.display_kind ?? '') === k.value,
                  }))}
                />
              </div>
              {z.display_address ? (
                <p class="muted small">{z.display_address} ({z.display_lat}, {z.display_lng})</p>
              ) : (
                <p class="muted small">No widget address yet.</p>
              )}
            </fieldset>
          </div>
          <div class="dialog-foot">
            {canDelete ? <button class="btn btn-quiet btn-sm btn-delete-muted" type="submit" formaction={actions.deleteZone} data-confirm={`Delete ${z.name}? This cannot be undone.`}>Delete</button> : <span class="muted small">In use by bookings</span>}
            {z.is_demo && <button class="btn btn-secondary btn-sm" type="submit" formaction={actions.clearDemo} name="clear" value={`zones|${z.id}`} formnovalidate>Mark confirmed</button>}
            <button class="btn btn-quiet" type="button" data-close={`edit-${z.id}`}>Back</button>
            <button class="btn" type="submit">Save zone</button>
          </div>
        </form>
      </dialog>
    );
  })
}

<style>
  .btn-delete-muted { color: var(--color-danger); opacity: .85; }
  .btn-delete-muted:hover { color: var(--color-danger); opacity: 1; background: var(--tint-danger); }
</style>

<dialog class="dialog" id="add-zone" aria-labelledby="d-az">
  <form method="POST" action={actions.addZone}>
    <div class="dialog-head">
      <p class="eyebrow">Zones</p>
      <h2 id="d-az">Add a zone</h2>
    </div>
    <div class="dialog-body stack-sm">
      <div class="grid-fields">
        <div class="field">
          <label for="az-name">Name</label>
          <input id="az-name" class="input" name="name" required />
        </div>
        <div class="field">
          <label for="az-code">Code</label>
          <input
            id="az-code"
            class="input mono"
            name="code"
            required
            pattern="^[a-z0-9]+(-[a-z0-9]+)*$"
          />
        </div>
        <div class="field">
          <label for="az-kind">Kind</label>
          <Select
            id="az-kind"
            name="kind"
            options={ZONE_KINDS.map((k) => ({
              value: k.value,
              label: k.label,
              selected: k.value === 'area',
            }))}
          />
        </div>
      </div>
      <p class="help">Then add its routes and durations on Zone prices; a zone without routes is not offered to customers.</p>
    </div>
    <div class="dialog-foot">
      <button class="btn btn-quiet" type="button" data-close="add-zone">Back</button>
      <button class="btn" type="submit">Add zone</button>
    </div>
  </form>
</dialog>

<script>
  import { enhanceAddressField } from '../scripts/address-autocomplete';

  document.querySelectorAll('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-open');
      const d = id && document.getElementById(id);
      if (d instanceof HTMLDialogElement) d.showModal();
    });
  });
  document.querySelectorAll('[data-close]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-close');
      const d = id && document.getElementById(id);
      if (d instanceof HTMLDialogElement) d.close();
    });
  });
  document.querySelectorAll('[data-confirm]').forEach((btn) => {
    btn.addEventListener('click', (event) => {
      const msg = btn.getAttribute('data-confirm') ?? '';
      if (!window.confirm(msg)) event.preventDefault();
    });
  });

  const placesOn = Boolean(
    import.meta.env.GOOGLE_PLACES_API_KEY ||
      import.meta.env.PUBLIC_ADDRESS_AUTOCOMPLETE === 'true',
  );
  document.querySelectorAll<HTMLInputElement>('[data-zone-display-addr]').forEach((input) => {
    const form = input.closest('form');
    if (!form) return;
    const place = form.querySelector<HTMLInputElement>('[data-zone-display-place]');
    const lat = form.querySelector<HTMLInputElement>('[data-zone-display-lat]');
    const lng = form.querySelector<HTMLInputElement>('[data-zone-display-lng]');
    enhanceAddressField(input, {
      enabled: placesOn,
      onPlace: (p) => {
        if (!place || !lat || !lng) return;
        if (!p) {
          place.value = '';
          lat.value = '';
          lng.value = '';
          return;
        }
        place.value = p.placeId;
        lat.value = String(p.lat);
        lng.value = String(p.lng);
      },
    });
    input.addEventListener('input', () => {
      if (!input.value.trim() && place && lat && lng) {
        place.value = '';
        lat.value = '';
        lng.value = '';
      }
    });
  });
</script>
