---
export const prerender = false;

import { actions } from 'astro:actions';
import AdminLayout from '../layouts/AdminLayout.astro';
import { createSupabaseServerClient } from '../lib/supabase';

const staff = Astro.locals.staff!;
const supabase = createSupabaseServerClient(Astro.cookies);
const { data: zones } = await supabase.from('zones').select('*').order('sort_order');
---

<AdminLayout title="Zones" current="zones" staffEmail={staff.email}>
  <div class="stack">
    {
      (zones ?? []).map((z) => (
        <form method="POST" action={actions.saveZone} class="panel stack zone-form">
          <input type="hidden" name="id" value={z.id} />
          <div class="grid grid-2">
            <div class="field">
              <label for={`zc-${z.id}`}>Code</label>
              <input class="input" id={`zc-${z.id}`} value={z.code} disabled />
            </div>
            <div class="field">
              <label for={`zn-${z.id}`}>Name</label>
              <input class="input" id={`zn-${z.id}`} name="name" value={z.name} required />
            </div>
            <div class="field">
              <label for={`zo-${z.id}`}>Sort order</label>
              <input class="input" id={`zo-${z.id}`} name="sortOrder" value={z.sort_order} />
            </div>
            <label class="check">
              <input type="checkbox" name="active" value="true" checked={z.active} /> Active
            </label>
          </div>
          <button class="btn btn-quiet" type="submit">Save zone</button>
        </form>
      ))
    }
  </div>
</AdminLayout>
