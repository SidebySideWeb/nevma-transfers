---
export const prerender = true;

import PublicLayout from '../../layouts/PublicLayout.astro';
import PageHero from '../../components/v2/blocks/PageHero.astro';
import FeaturedRoute from '../../components/v2/blocks/FeaturedRoute.astro';
import FaqList from '../../components/v2/blocks/FaqList.astro';
import CtaPanel from '../../components/v2/blocks/CtaPanel.astro';
import { getPublishableRoutes } from '../../lib/content/routes';
import { getSiteSettings } from '../../lib/sanity/content';
import { fromPriceForRoute, getCatalog } from '../../lib/server/catalog';
import { faqPageJsonLd, resolveSeo, serviceJsonLd } from '../../lib/seo';
import { t } from '../../lib/strings';

export async function getStaticPaths() {
  let routes: Awaited<ReturnType<typeof getPublishableRoutes>> = [];
  try {
    routes = await getPublishableRoutes();
  } catch (e) {
    console.warn(
      '[routes] getPublishableRoutes failed during getStaticPaths:',
      e instanceof Error ? e.message : e,
    );
  }
  if (!routes.length) {
    console.warn('[routes] no publishable routes — /routes/[slug] paths empty');
  }
  return routes.map((route) => ({
    params: { slug: route.slug },
    props: { route },
  }));
}

interface Props {
  route: Awaited<ReturnType<typeof getPublishableRoutes>>[number];
}

const { route } = Astro.props;
const settings = await getSiteSettings();
const cat = await getCatalog().catch(() => null);
const show = settings.showFromPrices !== false;
const siteUrl = (Astro.site?.href || import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321').replace(
  /\/$/,
  '',
);

const pricedCents = cat
  ? fromPriceForRoute(cat, route.fromZone, route.toZone)
      .map((r) => r.cents)
      .filter((c): c is number => c != null)
  : [];

const seoDoc = (route.seo ?? null) as {
  title?: string | null;
  description?: string | null;
  noindex?: boolean | null;
} | null;

const defaultTitle = `${route.title} transfer · ${settings.companyName}`;
const pageSeo = {
  title: seoDoc?.title || defaultTitle,
  description: seoDoc?.description || route.intro || undefined,
  noindex: seoDoc?.noindex ?? undefined,
};

const seo = resolveSeo({
  pageTitle: route.title,
  pageSeo,
  settings,
  pathname: `/routes/${route.slug}`,
  siteUrl,
});
if (!seoDoc?.title) seo.title = defaultTitle;

const faqItems = (route.faq ?? [])
  .filter((f): f is { question: string; answer: string } => Boolean(f?.question && f?.answer))
  .map((f) => ({ question: f.question, answer: f.answer }));

const jsonLd = [
  serviceJsonLd({
    name: route.title,
    description: pageSeo.description ?? undefined,
    url: `${siteUrl}/routes/${route.slug}`,
    providerName: settings.companyName,
    offerPricesCents: pricedCents,
    showPrice: show && pricedCents.length > 0,
  }),
  ...(faqItems.length ? [faqPageJsonLd(faqItems)] : []),
];

const heroSection = {
  _type: 'pageHero',
  layout: 'page',
  eyebrow: t('nav.services'),
  heading: { before: route.title, accent: '' },
  lead: route.intro || '',
  image: route.photo ?? null,
};

const featuredSection = {
  _type: 'featuredRoute',
  eyebrow: t('services.featured.eyebrow'),
  heading: { before: route.title, accent: '↔', after: '' },
  lead: route.intro || '',
  image: route.photo ?? null,
  note: t('fleet.note.vat'),
  noteLink: { label: 'request a quote', target: 'quote' },
  primary: { label: t('site.bookRoute'), target: 'book' },
  secondary: { label: t('services.featured.fleet'), target: 'fleet' },
  route: { fromZone: route.fromZone, toZone: route.toZone },
};

const faqSection = {
  _type: 'faqList',
  eyebrow: t('services.faq.eyebrow'),
  heading: { before: 'Questions,', accent: 'answered' },
  showPhone: true,
  lead: 'Anything else? Call us any time on',
  items: faqItems,
};

const ctaSection = {
  _type: 'ctaPanel',
  layout: 'compact',
  heading: { before: 'Something tailored', accent: 'to your itinerary?' },
  primary: { label: t('site.requestQuote'), target: 'quote' },
  secondary: { label: t('nav.book'), target: 'book' },
};
---

<PublicLayout designPage="04-services" seo={seo} jsonLd={jsonLd}>
  <PageHero section={heroSection} pathname={`/routes/${route.slug}`} />
  <FeaturedRoute
    section={featuredSection}
    pathname={`/routes/${route.slug}`}
    routeOverride={{ fromZone: route.fromZone, toZone: route.toZone, title: route.title }}
  />
  {faqItems.length ? <FaqList section={faqSection} pathname={`/routes/${route.slug}`} /> : null}
  <CtaPanel section={ctaSection} pathname={`/routes/${route.slug}`} />
</PublicLayout>
