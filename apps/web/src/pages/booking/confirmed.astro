---
export const prerender = false;

import ConfirmedBody from '../../components/v2/status/ConfirmedBody.astro';
import StatusHero from '../../components/v2/StatusHero.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getSiteSettings, loadUiStrings } from '../../lib/sanity/content';
import { confirmedView } from '../../lib/server/booking-service';
import { readVisitorKey } from '../../lib/server/visitor';
import { t, tAccent } from '../../lib/strings';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

await loadUiStrings();
const settings = await getSiteSettings();
const orderCode = Astro.url.searchParams.get('s')?.trim() || '';
const visitorKey = readVisitorKey(Astro.cookies);
const view = await confirmedView(orderCode, visitorKey);

const waiting = t('booking.confirmed.waiting');
const title = t('booking.confirmed.title');
const timeoutMsg = t('booking.confirmed.timeout');
const homeLabel = t('booking.confirmed.home');

const arrowRoute = (label: string) =>
  label.replace(' → ', ' <span class="sbbc0f">→</span> ');
---

<PublicLayout
  designPage="09-thank-you"
  title={`${title.replace(/\*/g, '')} - ${settings.companyName}`}
  description={view ? t('booking.confirmed.body') : waiting}
  robots="noindex,nofollow"
>
  <div
    id="confirmed-root"
    data-order-code={orderCode}
    data-pending={view ? '0' : '1'}
  >
    {
      view ? (
        <>
          <StatusHero
            heroClass="s96765"
            eyebrow={t('booking.confirmed.eyebrow')}
            titleHtml={tAccent('booking.confirmed.title')}
            lead={t('booking.confirmed.body')}
            pathname="/booking/confirmed"
          />
          <ConfirmedBody
            reference={view.card.reference}
            email={view.email}
            whenLabel={view.card.pickupLabel}
            routeLabel={arrowRoute(view.card.routeLabel)}
            vehicleLine={t('booking.confirmed.journeySub', {
              vehicle: view.card.className,
              passengers: view.card.passengers,
              luggage: view.card.luggage,
            })}
            photoUrl={view.card.photoUrl || '/images/v2/v-class-street.jpg'}
            photoAlt={view.card.className}
            manageHref="/booking/find"
            lines={view.lines.map((l) => ({
              label:
                view.bookingType === 'hourly'
                  ? l.label
                  : l.label.toLowerCase().includes('transfer')
                    ? l.label
                    : `${l.label} transfer`,
              cents: l.cents,
            }))}
            vatRateBp={view.vatRateBp}
            vatCents={view.vatCents}
            totalCents={view.totalCents}
            phone={settings.phone}
            emailContact={settings.email}
          />
        </>
      ) : (
        <>
          <StatusHero
            heroClass="s96765"
            eyebrow={t('booking.confirmed.eyebrow')}
            titleHtml={tAccent('booking.confirmed.title')}
            lead={waiting}
            pathname="/booking/confirmed"
          />
          <section data-block="appBody" class="sc16b1" id="confirmed-waiting" role="status" aria-live="polite">
            <div class="s8e90e">
              <p class="s97596">{waiting}</p>
              <div class="s4ba17">
                <a class="btn btn-line s95216" href="/">{homeLabel}</a>
              </div>
            </div>
          </section>
          <section data-block="appBody" class="sc16b1" id="confirmed-timeout" hidden>
            <div class="s8e90e">
              <h2 class="display s96d2b" id="confirmed-timeout-title" tabindex="-1">{title.replace(/\*/g, '')}</h2>
              <p class="s97596">{timeoutMsg}</p>
              <p>
                <a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}>{settings.phone}</a>
              </p>
              <div class="s4ba17">
                <a class="btn btn-line s95216" href="/">{homeLabel}</a>
              </div>
            </div>
          </section>
        </>
      )
    }
  </div>
</PublicLayout>

<script>
  import '../../scripts/confirmed-poll';
</script>
