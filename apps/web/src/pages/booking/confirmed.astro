---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteSettings, loadUiStrings } from '../../lib/sanity/content';
import { t } from '../../lib/strings';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

await loadUiStrings();
const settings = await getSiteSettings();
const orderCode = Astro.url.searchParams.get('s')?.trim() || '';

const waiting = t('booking.confirmed.waiting');
const title = t('booking.confirmed.title');
const bodyTemplate = t('booking.confirmed.body');
const timeoutMsg = t('booking.confirmed.timeout');
const homeLabel = t('booking.confirmed.home');
---

<BaseLayout
  title={`${title} - ${settings.companyName}`}
  description={waiting}
  robots="noindex,nofollow"
>
  <section class="notice-block notice-block--success" id="confirmed-root" data-order-code={orderCode} data-body-template={bodyTemplate}>
    <div class="narrow notice-block-inner stack">
      <div id="confirmed-waiting" class="notice" role="status" aria-live="polite">
        <div class="row">
          <div class="spinner" aria-hidden="true"></div>
          <p>{waiting}</p>
        </div>
      </div>

      <section id="confirmed-ok" class="stack" aria-labelledby="confirmed-title" hidden>
        <p class="eyebrow">Confirmed</p>
        <h1 class="display notice-block-title" id="confirmed-title" tabindex="-1">{title}</h1>
        <p id="confirmed-body" class="notice-block-lead"></p>
        <div class="notice-block-actions">
          <a class="btn btn-gold" href="/">{homeLabel}</a>
        </div>
      </section>

      <div id="confirmed-timeout" class="stack" role="status" hidden>
        <h1 class="display notice-block-title" id="confirmed-timeout-title" tabindex="-1">{title}</h1>
        <p class="notice-block-lead">{timeoutMsg}</p>
        <p>
          <a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a>
        </p>
        <div class="notice-block-actions">
          <a class="btn btn-line" href="/">{homeLabel}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/confirmed-poll';
</script>
