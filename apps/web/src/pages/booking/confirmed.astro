---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteSettings, loadUiStrings } from '../../lib/sanity/content';
import { t } from '../../lib/strings';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

await loadUiStrings();
const settings = await getSiteSettings();
const orderCode = Astro.url.searchParams.get('s')?.trim() || '';

const waiting = t('booking.confirmed.waiting');
const title = t('booking.confirmed.title');
const bodyTemplate = t('booking.confirmed.body');
const timeoutMsg = t('booking.confirmed.timeout');
const homeLabel = t('booking.confirmed.home');
---

<BaseLayout
  title={`${title} - ${settings.companyName}`}
  description={waiting}
  robots="noindex,nofollow"
>
  <section class="state-page">
    <div
      class="state-card stack"
      id="confirmed-root"
      data-order-code={orderCode}
      data-body-template={bodyTemplate}
    >
      <div id="confirmed-waiting" class="notice" role="status" aria-live="polite">
        <div class="row">
          <div class="spinner" aria-hidden="true"></div>
          <p>{waiting}</p>
        </div>
      </div>

      <section
        id="confirmed-ok"
        class="stack notice-success"
        aria-labelledby="confirmed-title"
        hidden
      >
        <p class="eyebrow">Confirmed</p>
        <h1 class="display" id="confirmed-title" tabindex="-1">{title}</h1>
        <p id="confirmed-body"></p>
        <a class="btn btn-gold" href="/">{homeLabel}</a>
      </section>

      <div id="confirmed-timeout" class="stack" role="status" hidden>
        <h1 class="display" id="confirmed-timeout-title" tabindex="-1">{title}</h1>
        <p>{timeoutMsg}</p>
        <p>
          <a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a>
        </p>
        <a class="btn btn-line" href="/">{homeLabel}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/confirmed-poll';
</script>
