---
/**
 * Viva payment source success URL: /booking/success.
 * Kit return page is /booking/confirmed (polls webhook; redirect never confirms).
 */
export const prerender = false;

const target = new URL('/booking/confirmed', Astro.url);
target.search = Astro.url.search;
return Astro.redirect(target.pathname + target.search, 302);
---
