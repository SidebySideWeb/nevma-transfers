---
export const prerender = false;

import ManageBody from '../../../components/v2/status/ManageBody.astro';
import StatusHero from '../../../components/v2/StatusHero.astro';
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { getSiteSettings, loadUiStrings } from '../../../lib/sanity/content';
import { managePageView } from '../../../lib/server/booking-manage';
import { escapeThenAccent } from '../../../lib/v2/accent';
import { t } from '../../../lib/strings';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

await loadUiStrings();
const settings = await getSiteSettings();
const token = Astro.params.token ?? '';
const view = await managePageView(token);

const pageTitle = t('manage.title');
const invalid = t('manage.linkInvalid');
const findTitle = t('lookup.title');

const pickupDisplay =
  view.kind === 'ok' ? view.pickupLabel.replace(/\s*\(Athens\)\s*$/, '') : '';
const comma = pickupDisplay.lastIndexOf(',');
const pickupLead = comma >= 0 ? pickupDisplay.slice(0, comma) : pickupDisplay;
const pickupTime = comma >= 0 ? pickupDisplay.slice(comma + 1).trim() : '';
const titleHtml =
  view.kind === 'ok'
    ? escapeThenAccent(
        pickupTime ? `${pickupLead}, *${pickupTime}*` : pickupLead || pageTitle,
      )
    : escapeThenAccent(invalid);

const routeHtml =
  view.kind === 'ok'
    ? view.routeOrHours.replace(' → ', ' <span class="sbbc0f">→</span> ')
    : '';

const addressLine =
  view.kind === 'ok'
    ? [
        view.pickupAddress,
        view.dropoffAddress ? `→ ${view.dropoffAddress}` : null,
        view.flightNumber
          ? `Flight ${view.flightNumber}${view.flightStatus ? ` (${view.flightStatus})` : ''}`
          : null,
      ]
        .filter(Boolean)
        .join(' · ')
    : '';
---

<PublicLayout
  designPage="15-manage-booking"
  title={`${pageTitle} - ${settings.companyName}`}
  description={pageTitle}
  robots="noindex,nofollow"
>
  {
    view.kind === 'invalid' ? (
      <>
        <StatusHero
          heroClass="sd750a"
          innerClass="s2d3f5"
          titleClass="display sc9e5e"
          eyebrow={pageTitle}
          titleHtml={titleHtml}
          pathname="/booking/find"
        />
        <section data-block="appBody" class="s03fba">
          <div class="s4ba17">
            <a class="btn btn-gold s95216" href="/booking/find">
              {findTitle.replace(/\*/g, '')}
            </a>
          </div>
        </section>
      </>
    ) : (
      <>
        <StatusHero
          heroClass="sd750a"
          innerClass="s2d3f5"
          titleClass="display sc9e5e"
          eyebrow={t('manage.eyebrow', { reference: view.reference })}
          titleHtml={titleHtml}
          badge={{ label: view.statusLabel.toUpperCase(), note: t('manage.chauffeurNote') }}
          pathname={`/booking/manage/${token}`}
        />
        {
          view.kind === 'ok' && view.sibling && (
            <section class="panel" style="margin:1rem 0;padding:1rem" aria-label="Return trip">
              <h2 class="display" style="font-size:1.1rem;margin:0 0 0.5rem">
                {view.leg === 2 ? 'Outbound leg' : 'Return leg'}
              </h2>
              <p style="margin:0">
                {view.sibling.reference} · {view.sibling.status} · {view.sibling.pickupLabel}
              </p>
              <p style="margin:0.25rem 0 0" class="muted">
                {view.sibling.routeOrHours} · {view.sibling.priceLabel}
              </p>
              <p style="margin:0.5rem 0 0" class="muted small">
                Each leg has its own cancel link when you open it from your confirmation email.
              </p>
            </section>
          )
        }
        <ManageBody
          routeLabel={routeHtml}
          addressLine={addressLine}
          className={view.className}
          passengers={view.passengers}
          luggage={view.luggage}
          leadName={view.leadName}
          timeline={view.timeline}
          photoUrl={view.photoUrl}
          typeLabel={view.typeLabel}
          baseCents={view.basePriceCents}
          vatRateBp={view.vatRateBp}
          vatCents={view.vatCents}
          totalCents={view.priceCents}
          reference={view.reference}
          officeEmail={view.officeEmail}
          officePhoneHref={view.officePhoneHref}
          calendarHref="./calendar.ics"
          cancelHref={view.canCancel ? `/booking/cancel/${token}` : null}
        />
      </>
    )
  }
</PublicLayout>
