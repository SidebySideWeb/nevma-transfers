---
export const prerender = false;

import FindBookingBody from '../../components/v2/status/FindBookingBody.astro';
import StatusHero from '../../components/v2/StatusHero.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getSiteSettings, loadUiStrings } from '../../lib/sanity/content';
import { t, tAccent } from '../../lib/strings';

await loadUiStrings();
const settings = await getSiteSettings();
const sent = Astro.url.searchParams.get('sent') === '1';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const dummyTurnstile = turnstileSiteKey.startsWith('1x0000000');
const sentMsg = t('lookup.sent');
const title = t('lookup.title');
---

<PublicLayout
  designPage="14-find-my-booking"
  title={`${title.replace(/\*/g, '')} - ${settings.companyName}`}
  description={t('lookup.intro')}
  robots="noindex,nofollow"
>
  <StatusHero
    heroClass="s68332"
    eyebrow={t('lookup.eyebrow')}
    titleHtml={tAccent('lookup.title')}
    lead={t('lookup.intro')}
    pathname="/booking/find"
  />
  <FindBookingBody
    phone={settings.phone}
    email={settings.email}
    turnstileSiteKey={turnstileSiteKey}
    dummyTurnstile={dummyTurnstile}
    sent={sent}
    sentMsg={sentMsg}
  />
</PublicLayout>

{
  !dummyTurnstile && turnstileSiteKey ? (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  ) : null
}

<script>
  import '../../scripts/lookup-page';
</script>
