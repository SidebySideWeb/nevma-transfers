---
export const prerender = false;

import HoldExpiredBody from '../../components/v2/status/HoldExpiredBody.astro';
import NotCompletedBody from '../../components/v2/status/NotCompletedBody.astro';
import StatusHero from '../../components/v2/StatusHero.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getSiteSettings, loadUiStrings } from '../../lib/sanity/content';
import { notCompletedView } from '../../lib/server/booking-service';
import { readVisitorKey } from '../../lib/server/visitor';
import { t, tAccent } from '../../lib/strings';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

await loadUiStrings();
const settings = await getSiteSettings();
const orderCode = Astro.url.searchParams.get('s')?.trim() || null;
const visitorKey = readVisitorKey(Astro.cookies);
const view = await notCompletedView(orderCode, visitorKey);

const live = view.kind === 'live';
const card = view.card;
const handoffTitle = t('booking.handoff.title');
const handoffBody = t('booking.handoff.body');
const handoffFallback = t('booking.handoff.fallback');
---

<PublicLayout
  designPage={live ? '10-payment-failed' : '11-hold-expired'}
  title={`${live ? t('booking.notCompleted.title') : t('booking.expired.title')}`.replace(/\*/g, '') + ` - ${settings.companyName}`}
  description={live ? t('booking.notCompleted.body') : t('booking.expired.body')}
  robots="noindex,nofollow"
>
  <div
    id="not-completed-root"
    data-mode={live ? 'live' : 'expired'}
    data-reference={live ? view.reference : ''}
    data-expires-at-ms={live ? String(view.holdExpiresAtMs) : ''}
    data-timer-template={t('booking.notCompleted.timer')}
  >
    {
      live && card ? (
        <>
          <div id="live-panel">
            <StatusHero
              heroClass="s68332"
              eyebrow={t('booking.notCompleted.eyebrow')}
              titleHtml={tAccent('booking.notCompleted.title')}
              lead={t('booking.notCompleted.body')}
              pathname="/booking/not-completed"
            />
            <NotCompletedBody
              reference={card.reference}
              className={card.className.toUpperCase()}
              whenLabel={card.pickupLabel}
              routeLabel={card.routeLabel}
              holdMmSs="--"
              phone={settings.phone}
            />
          </div>
          <div id="handoff" class="s3d21d" role="status" aria-live="polite" hidden>
            <div class="s0e022">
              <span aria-hidden="true" class="spin"></span>
              <div class="eyebrow">{t('booking.handoff.eyebrow')}</div>
              <h2 class="display se47a0" id="handoff-title" tabindex="-1">
                {handoffTitle.replace(/\*/g, '')}
              </h2>
              <p class="s97596">{handoffBody}</p>
              <p>
                <a class="btn btn-gold" id="handoff-link" href="#">{handoffFallback}</a>
              </p>
            </div>
          </div>
        </>
      ) : (
        <>
          <StatusHero
            heroClass="s68332"
            eyebrow={t('booking.expired.eyebrow')}
            titleHtml={tAccent('booking.expired.title')}
            lead={t('booking.expired.body')}
            pathname="/booking/not-completed"
          />
          <HoldExpiredBody
            reference={card?.reference}
            className={card?.className?.toUpperCase()}
            whenLabel={card?.pickupLabel}
            routeLabel={card?.routeLabel}
            phone={settings.phone}
          />
        </>
      )
    }
  </div>
</PublicLayout>

<script>
  import '../../scripts/not-completed';
</script>
