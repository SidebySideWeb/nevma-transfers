---
export const prerender = false;

import CancelBody from '../../../components/v2/status/CancelBody.astro';
import StatusHero from '../../../components/v2/StatusHero.astro';
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { getSiteSettings, loadUiStrings } from '../../../lib/sanity/content';
import { cancelPageView } from '../../../lib/server/booking-service';
import { t, tAccent } from '../../../lib/strings';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

await loadUiStrings();
const settings = await getSiteSettings();
const token = Astro.params.token ?? '';
const view = await cancelPageView(token);

const pageTitle = t('booking.cancel.title');
const tooLate = t('booking.cancel.tooLate');
const invalid = t('booking.cancel.invalid');
const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY || '';
---

<PublicLayout
  designPage="16-cancel-booking"
  title={`${pageTitle.replace(/\*/g, '')} - ${settings.companyName}`}
  description={pageTitle.replace(/\*/g, '')}
  robots="noindex,nofollow"
>
  {
    view.kind === 'invalid' && (
      <>
        <StatusHero
          heroClass="s68332"
          eyebrow={t('booking.cancel.eyebrow', { reference: '—' })}
          titleHtml={tAccent('booking.cancel.title')}
          lead={invalid}
          pathname="/booking/find"
        />
        <section data-block="appBody" class="s83f2d">
          <div class="s221fe">
            <a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}>{settings.phone}</a>
            {' · '}
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </div>
        </section>
      </>
    )
  }

  {
    view.kind === 'tooLate' && (
      <>
        <StatusHero
          heroClass="s68332"
          eyebrow={t('booking.cancel.eyebrow', { reference: '—' })}
          titleHtml={tAccent('booking.cancel.title')}
          lead={tooLate}
          pathname="/booking/find"
        />
        <section data-block="appBody" class="s83f2d">
          <div class="s221fe">
            <a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}>{settings.phone}</a>
            {' · '}
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </div>
        </section>
      </>
    )
  }

  {
    view.kind === 'ok' && (
      <>
        <StatusHero
          heroClass="s68332"
          eyebrow={t('booking.cancel.eyebrow', { reference: view.reference })}
          titleHtml={tAccent('booking.cancel.title')}
          pathname={`/booking/cancel/${token}`}
        />
        <CancelBody
          reference={view.card.reference}
          className={view.card.className.toUpperCase()}
          whenLabel={view.card.pickupLabel}
          routeLabel={view.card.routeLabel}
          refundLabel={view.refundLabel}
          keepHref={`/booking/manage/${token}`}
          token={token}
          turnstileSiteKey={turnstileSiteKey}
        />
      </>
    )
  }
</PublicLayout>

<script>
  import '../../../scripts/cancel-page';
</script>
