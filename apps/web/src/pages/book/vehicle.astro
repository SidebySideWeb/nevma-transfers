---
export const prerender = false;

import { features, publicFeatures } from '@tem/features';
import BookingApp from '../../components/booking/BookingApp';
import SiteHeader from '../../components/v2/SiteHeader.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { isBookingOpen } from '../../lib/booking-open';
import { getSiteSettings, loadUiStrings } from '../../lib/sanity/content';
import { t } from '../../lib/strings';
import type { UiStringKey } from '../../lib/strings';
import { uiStringDefaults } from '@studio-strings';

await loadUiStrings();
const settings = await getSiteSettings();
const bookingOpen = isBookingOpen();
const publicFlags = publicFeatures(features());
const whatsappHref =
  publicFlags.whatsapp && publicFlags.whatsappNumber
    ? `https://wa.me/${publicFlags.whatsappNumber}?text=${encodeURIComponent("Hello, I'd like information about a transfer")}`
    : null;
const quoteId = Astro.url.searchParams.get('q');
const signature = Astro.url.searchParams.get('s');
const initialVehicleQuery =
  quoteId && signature ? { quoteId, signature } : null;

const strings: Record<string, string> = {};
for (const entry of uiStringDefaults) {
  strings[entry.key] = t(entry.key as UiStringKey);
}

const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY || '';
const phoneHref = `tel:${settings.phone.replace(/[^\d+]/g, '')}`;

// Same links and words as SiteHeader.astro: the island draws the header inside `appHero` (08-book).
const header = {
  homeHref: '/',
  homeLabel: `${settings.companyName} home`,
  logoSrc: '/images/v2/logo-white.png',
  logoAlt: settings.companyName,
  navLabel: t('site.nav.main'),
  nav: [
    { href: '/fleet', label: t('nav.fleet') },
    { href: '/services', label: t('nav.services') },
    { href: '/vip-security', label: t('nav.vipSecurity') },
    { href: '/about', label: t('nav.about') },
    { href: '/contact', label: t('nav.contact') },
  ],
  phone: settings.phone,
  phoneHref,
  bookHref: '/book',
  bookLabel: t('nav.book'),
  menuLabel: t('nav.menu'),
};
---

<PublicLayout
  designPage="08-book"
  title={`Book - ${settings.companyName}`}
  description="Book a transfer or hourly hire with Elite Protection."
  robots="noindex,nofollow"
>
  {
    bookingOpen ? (
      <>
        {/* Menu panel and its script only: the header itself is part of the island's appHero. */}
        <SiteHeader settings={settings} pathname="/book/vehicle" menuOnly />
        <BookingApp
          client:load
          strings={strings}
          turnstileSiteKey={turnstileSiteKey}
          contact={{ phone: settings.phone, email: settings.email }}
          header={header}
          addressAutocomplete={import.meta.env.PUBLIC_ADDRESS_AUTOCOMPLETE === 'true'}
          distancePricing={publicFlags.distancePricing}
          whatsappHref={whatsappHref}
          initialVehicleQuery={initialVehicleQuery}
        />
      </>
    ) : (
      <>
        <section data-block="appHero" class="bgx1 s5e090">
          <SiteHeader settings={settings} pathname="/book" />
          <div class="sc68e2">
            <div class="s3a80d">
              <h1 class="display sd5a38" tabindex="-1">Online booking is not open yet</h1>
            </div>
          </div>
        </section>
        <section data-block="appBody" class="s39f3a">
          <div class="s8f7a6">
            <p class="s0a0a6">
              Please call <a href={phoneHref}>{settings.phone}</a> or email{' '}
              <a href={`mailto:${settings.email}`}>{settings.email}</a> to arrange a transfer.
            </p>
          </div>
        </section>
      </>
    )
  }
</PublicLayout>

<style is:global>
  /* Parts of the booking flow that v2.css (a copy of the design) does not have. */
  .js-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  [data-block='appBody'] .error {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    line-height: 1.35;
    color: #f0a0a0;
  }
  /* Light red highlight on invalid booking fields (inputs, date, zone dropdowns). */
  [data-block='appBody'] .f2.is-invalid input,
  [data-block='appBody'] .f2.is-invalid .ep-date-btn,
  [data-block='appBody'] .field.is-invalid .dd-btn,
  [data-block='appBody'] .f2 input[aria-invalid='true'],
  [data-block='appBody'] .ep-date-btn[aria-invalid='true'],
  [data-block='appBody'] .dd-btn[aria-invalid='true'] {
    border-bottom-color: rgba(220, 90, 90, 0.85);
    background: rgba(160, 40, 40, 0.14);
    box-shadow: inset 0 -1px 0 rgba(220, 90, 90, 0.45);
  }
  [data-block='appBody'] .f2.is-invalid textarea,
  [data-block='appBody'] .f2 textarea[aria-invalid='true'] {
    border-color: rgba(220, 90, 90, 0.85);
    background: rgba(160, 40, 40, 0.14);
  }
  [data-block='appBody'] .notice {
    padding: var(--space-4);
    border: 1px solid rgba(220, 90, 90, 0.55);
    background: rgba(160, 40, 40, 0.12);
    color: #f4f0e6;
  }
  [data-block='appBody'] .notice p {
    margin: 0;
  }
  [data-block='appBody'] .notice ul {
    margin: 0;
    padding-left: var(--space-4);
  }
  [data-block='appBody'] .notice a {
    color: inherit;
  }
  [data-block='appBody'] .js-hint {
    font-size: 12px;
    color: #8e887b;
  }
  /* Address autocomplete list (reuses .ddl; attribution under suggestions). */
  [data-block='appBody'] .ep-address { position: relative; }
  [data-block='appBody'] .ep-address-wrap { position: relative; display: flex; align-items: stretch; }
  [data-block='appBody'] .ep-address-wrap input { flex: 1; min-width: 0; padding-right: 2.5rem; }
  [data-block='appBody'] .ep-address-clear {
    position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
    border: 0; background: transparent; color: #c9a45c; cursor: pointer;
    font-size: 14px; line-height: 1; padding: 6px;
  }
  [data-block='appBody'] .ep-address-ddl {
    z-index: 40;
    width: max(100%, min(28rem, calc(100vw - 2rem)));
    min-width: 100%;
    left: 0;
    right: auto;
  }
  [data-block='appBody'] .ep-address-attr { padding: 8px 12px 10px; opacity: 0.85; }
  [data-block='appBody'] .ep-address-attr img { display: block; height: 14px; width: auto; }
  [data-block='appBody'] .ep-bar-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    align-items: end;
  }
  [data-block='appBody'] .ep-bar-cta-desktop { display: flex; align-items: end; }
  [data-block='appBody'] .ep-bar-cta-sticky {
    display: none;
    position: sticky; bottom: 0; z-index: 20;
    padding: 12px 0 calc(12px + env(safe-area-inset-bottom));
    background: linear-gradient(180deg, transparent, #0a0a0b 28%);
  }
  [data-block='appBody'] .ep-bar-cta-sticky .btn { width: 100%; }
  [data-block='appBody'] .ep-airport-hint {
    display: flex; gap: 12px; align-items: flex-start;
    padding: 12px 14px; border: 1px solid rgba(207, 164, 95, 0.35);
    color: #e8e2d6; font-size: 14px;
  }
  [data-block='appBody'] .ep-airport-hint p { margin: 0; }
  [data-block='appBody'] .ep-airport-icon { color: #c9a45c; font-size: 18px; }
  [data-block='appBody'] .ep-route-card {
    display: flex; justify-content: space-between; gap: 16px; align-items: flex-start;
    padding: 16px 18px; border: 1px solid rgba(207, 164, 95, 0.35);
  }
  [data-block='appBody'] .ep-route-when, [data-block='appBody'] .ep-route-meta {
    margin: 6px 0 0; color: #8e887b; font-size: 14px;
  }
  [data-block='appBody'] .ep-quote-timer { color: #e7c687; font-size: 14px; margin: 0; }
  [data-block='appBody'] .ep-return {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(207, 164, 95, 0.22);
  }
  [data-block='appBody'] .ep-return-switch {
    display: inline-flex; gap: 10px; align-items: center; font-size: 14px;
    margin-bottom: 12px;
  }
  [data-block='appBody'] .ep-return-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    align-items: start;
  }
  [data-block='appBody'] .ep-route-suggest {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 4px 0 12px;
  }
  [data-block='appBody'] .ep-route-suggest-label {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c9a45c;
  }
  [data-block='appBody'] .ep-route-suggest-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  [data-block='appBody'] .ep-route-chip {
    appearance: none;
    border: 1px solid rgba(207, 164, 95, 0.45);
    background: transparent;
    color: #f4f0e6;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    padding: 8px 12px;
    cursor: pointer;
  }
  [data-block='appBody'] .ep-route-chip[aria-pressed='true'],
  [data-block='appBody'] .ep-route-chip:hover {
    background: #e7c687;
    color: #0a0a0b;
  }
  [data-block='appBody'] .ep-time-field {
    min-width: 12rem;
  }
  [data-block='appBody'] .ep-time-row {
    display: grid;
    grid-template-columns: minmax(5.5rem, 1fr) minmax(4.25rem, 5rem);
    gap: 8px;
  }
  [data-block='appBody'] .ep-time-row .field {
    margin: 0;
    padding: 0;
    border: 0;
    gap: 0;
  }
  [data-block='appBody'] .ep-bar-field.ep-time-field .ep-time-row .dd-btn {
    height: 30px;
    min-height: 30px;
    border-bottom: 1px solid rgba(207, 164, 95, 0.55);
  }
  [data-block='appBody'] .ep-return-fields .ep-time-field .ep-time-row .dd-btn {
    height: 50px;
    min-height: 50px;
  }
  @media (max-width: 1023px) {
    [data-block='appBody'] .ep-bar-row { grid-template-columns: 1fr; }
    [data-block='appBody'] .ep-bar-cta-desktop { display: none; }
    [data-block='appBody'] .ep-bar-cta-sticky { display: block; }
  }
  /* Transfer / By the hour (extra/08b-book-hourly), drawn with the zone fields' `dd-btn`. */
  [data-block='appBody'] .js-trip[data-v2-extra] {
    display: flex;
    align-self: flex-start;
    border: 1px solid rgba(207, 164, 95, 0.45);
  }
  [data-block='appBody'] .js-trip .dd-btn {
    width: auto;
    height: 44px;
    padding: 0 24px;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  [data-block='appBody'] .js-trip .dd-btn[aria-pressed='true'] {
    background: #e7c687;
    color: #0a0a0b;
  }
  [data-block='appBody'] .s636a1[data-v2-extra] .stepper {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    justify-content: center;
  }
  [data-block='appBody'] .stepper button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  [data-block='appHero'] .stepbtn:disabled {
    cursor: default;
  }
</style>
