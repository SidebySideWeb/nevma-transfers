---
export const prerender = false;

import PublicLayout from '../layouts/PublicLayout.astro';
import Sections from '../components/sections/Sections.astro';
import { FORM_FLASH_COOKIE } from '../lib/forms/form-cookie';
import { getSiteSettings } from '../lib/sanity/content';
import {
  getPageBySlug,
  LEGAL_SLUGS,
  STANDARD_SLUGS,
  type StandardSlug,
} from '../lib/sanity/pages';
import { organizationJsonLd, resolveSeo, serviceJsonLd } from '../lib/seo';

const DESIGN_PAGE: Record<StandardSlug, string> = {
  'vip-security': '05-vip-security',
  about: '06-about',
  contact: '07-contact',
  'request-a-transfer': '12-request-transfer',
};

const standard = Astro.params.standard as string;
if (!(STANDARD_SLUGS as readonly string[]).includes(standard)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
if ((LEGAL_SLUGS as readonly string[]).includes(standard)) {
  throw new Error(`Standard slug "${standard}" collides with a legal page slug`);
}

const slug = standard as StandardSlug;
const page = await getPageBySlug(slug);
const settings = await getSiteSettings();
const siteUrl = (Astro.site?.href || import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321').replace(
  /\/$/,
  '',
);

const seo = resolveSeo({
  pageTitle: page.title,
  pageSeo: page.seo ?? null,
  settings,
  pathname: `/${slug}`,
  siteUrl,
});

const jsonLd: unknown[] = [];
if (slug === 'vip-security') {
  jsonLd.push(
    serviceJsonLd({
      name: page.title,
      description: seo.description || undefined,
      url: `${siteUrl}/vip-security`,
      providerName: settings.companyName,
      showPrice: false,
    }),
  );
} else if (slug === 'about' || slug === 'contact') {
  jsonLd.push(organizationJsonLd(settings, siteUrl, slug === 'contact' ? { contactPoint: true } : undefined));
}

const hasFlash = Boolean(Astro.cookies.get(FORM_FLASH_COOKIE)?.value);
Astro.response.headers.set(
  'Cache-Control',
  hasFlash ? 'private, no-store' : 'public, s-maxage=60, stale-while-revalidate=300',
);
---

<PublicLayout designPage={DESIGN_PAGE[slug]} seo={seo} jsonLd={jsonLd}>
  <Sections sections={page.sections} pathname={Astro.url.pathname} />
</PublicLayout>
