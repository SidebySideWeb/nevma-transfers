---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Sections from '../components/sections/Sections.astro';
import { FORM_FLASH_COOKIE } from '../lib/forms/form-cookie';
import { getSiteSettings } from '../lib/sanity/content';
import {
  getPageBySlug,
  LEGAL_SLUGS,
  STANDARD_SLUGS,
  type StandardSlug,
} from '../lib/sanity/pages';
import { organizationJsonLd, resolveSeo, serviceJsonLd } from '../lib/seo';

const standard = Astro.params.standard as string;
if (!(STANDARD_SLUGS as readonly string[]).includes(standard)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
if ((LEGAL_SLUGS as readonly string[]).includes(standard)) {
  throw new Error(`Standard slug "${standard}" collides with a legal page slug`);
}

const slug = standard as StandardSlug;
let page;
try {
  page = await getPageBySlug(slug);
} catch (e) {
  const msg = e instanceof Error ? e.message : String(e);
  throw new Error(
    `Missing standard page "${slug}" (expected Sanity document page-${slug}). ${msg}`,
  );
}

const settings = await getSiteSettings();
const siteUrl = (Astro.site?.href || import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321').replace(
  /\/$/,
  '',
);

const seo = resolveSeo({
  pageTitle: page.title,
  pageSeo: page.seo ?? null,
  settings,
  pathname: `/${slug}`,
  siteUrl,
});

const jsonLd: unknown[] = [];
if (slug === 'vip-security') {
  jsonLd.push(
    serviceJsonLd({
      name: page.title,
      description: seo.description || undefined,
      url: `${siteUrl}/vip-security`,
      providerName: settings.companyName,
      showPrice: false,
    }),
  );
} else if (slug === 'about') {
  jsonLd.push(organizationJsonLd(settings, siteUrl));
} else if (slug === 'contact') {
  jsonLd.push(organizationJsonLd(settings, siteUrl, { contactPoint: true }));
}

const formBlockId = slug === 'vip-security' ? 'enquiry' : undefined;

// Only bypass caches when a form flash is present (validation return).
const hasFlash = Boolean(Astro.cookies.get(FORM_FLASH_COOKIE)?.value);
Astro.response.headers.set(
  'Cache-Control',
  hasFlash ? 'no-store' : 'public, s-maxage=60, stale-while-revalidate=300',
);

const hero = page.sections.find((s) => s._type === 'hero');
const heroImage =
  hero && hero._type === 'hero' ? hero.image : undefined;
---

<BaseLayout seo={seo} jsonLd={jsonLd} preloadImage={heroImage}>
  <Sections sections={page.sections} formBlockId={formBlockId} />
</BaseLayout>
