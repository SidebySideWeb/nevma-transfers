---
export const prerender = false;

import { uiStringDefaults } from '@studio-strings';
import { features, notFoundUnless, publicFeatures } from '@tem/features';
import BusinessApp from '../../../components/business/BusinessApp';
import SiteHeader from '../../../components/v2/SiteHeader.astro';
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { getSiteSettings, loadUiStrings } from '../../../lib/sanity/content';
import { t } from '../../../lib/strings';
import type { UiStringKey } from '../../../lib/strings';

const off = notFoundUnless(features().corporate);
if (off) return off;

await loadUiStrings();
const settings = await getSiteSettings();
const publicFlags = publicFeatures(features());

const strings: Record<string, string> = {};
for (const entry of uiStringDefaults) {
  strings[entry.key] = t(entry.key as UiStringKey);
}

const phoneHref = `tel:${settings.phone.replace(/[^\d+]/g, '')}`;
const header = {
  homeHref: '/',
  homeLabel: `${settings.companyName} home`,
  logoSrc: '/images/v2/logo-white.png',
  logoAlt: settings.companyName,
  navLabel: t('site.nav.main'),
  nav: [
    { href: '/fleet', label: t('nav.fleet') },
    { href: '/services', label: t('nav.services') },
    { href: '/vip-security', label: t('nav.vipSecurity') },
    { href: '/about', label: t('nav.about') },
    { href: '/contact', label: t('nav.contact') },
  ],
  phone: settings.phone,
  phoneHref,
  bookHref: '/business/app',
  bookLabel: t('business.app.title'),
  menuLabel: t('nav.menu'),
};
---

<PublicLayout
  designPage="08-book"
  title={`${t('business.app.title')} - ${settings.companyName}`}
  description={t('business.lead')}
  robots="noindex,nofollow"
>
  <SiteHeader settings={settings} pathname="/business/app" menuOnly />
  <BusinessApp
    client:only="react"
    strings={strings}
    turnstileSiteKey={import.meta.env.TURNSTILE_SITE_KEY || ''}
    contact={{ phone: settings.phone, email: settings.email }}
    header={header}
    addressAutocomplete={import.meta.env.PUBLIC_ADDRESS_AUTOCOMPLETE === 'true'}
    distancePricing={publicFlags.distancePricing}
    whatsappHref={null}
  />
</PublicLayout>

<style is:global>
  /* data-v2-extra: business account chrome is not in the V2 design; built from tokens. */
  .biz-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-3) var(--gutter);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-deep);
  }
  .biz-who {
    margin: 0;
    flex: 1 1 16rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }
  .biz-tabs,
  .biz-range {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .biz-tab,
  .biz-link {
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-ui);
    text-transform: uppercase;
    cursor: pointer;
  }
  .biz-tab.is-on {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }
  .biz-link {
    border-color: transparent;
    color: var(--color-accent);
    text-decoration: underline;
    padding: 0 var(--space-2);
  }
  .biz-tab:focus-visible,
  .biz-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .biz-login {
    display: grid;
    gap: var(--space-4);
    max-width: 28rem;
    margin: var(--space-5) 0;
  }
  .biz-h {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
  }
  .biz-note {
    margin: 0;
    min-height: 1.5em;
    color: var(--color-muted);
  }
  .biz-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-4);
  }
  .biz-filters .f2 {
    flex: 1 1 16rem;
  }
  .biz-scroll {
    overflow-x: auto;
  }
  .biz-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .biz-table th,
  .biz-table td {
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }
  .biz-table th {
    color: var(--color-label);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    font-size: var(--text-xs);
  }
</style>
