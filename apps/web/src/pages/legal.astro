---
export const prerender = true;

import PublicLayout from '../layouts/PublicLayout.astro';
import Sections from '../components/sections/Sections.astro';
import LegalDocument from '../components/v2/blocks/LegalDocument.astro';
import { getSiteSettings } from '../lib/sanity/content';
import { getPageBySlug } from '../lib/sanity/pages';
import { resolveSeo } from '../lib/seo';

const settings = await getSiteSettings();
const page = await getPageBySlug('legal');
const siteUrl = (Astro.site?.href || import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321').replace(
  /\/$/,
  '',
);
const seo = resolveSeo({
  pageTitle: page.title,
  pageSeo: page.seo ?? null,
  settings,
  pathname: '/legal',
  siteUrl,
});

const heroSections = page.sections.filter((s) => s._type !== 'legalDocument');
---

<PublicLayout designPage="17-legal" seo={seo}>
  <Sections sections={heroSections} pathname={Astro.url.pathname} />
  <LegalDocument />
</PublicLayout>
