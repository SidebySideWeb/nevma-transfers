---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tDefault } from '../lib/strings';

const title = 'Page not found';
const body = tDefault('error.invalid_request');
---

<BaseLayout title={title} description={body} robots="noindex">
  <section class="state-page">
    <div class="state-card notice-danger">
      <p class="eyebrow">404</p>
      <h1 class="display" tabindex="-1">{title}</h1>
      <p class="muted">{body}</p>
      <a class="btn btn-gold" href="/">Back to home</a>
    </div>
  </section>
</BaseLayout>
