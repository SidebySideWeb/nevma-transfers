---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoticeBlock from '../components/v2/NoticeBlock.astro';
import { tDefault } from '../lib/strings';

const title = tDefault('error.404.title');
const lead = tDefault('error.404.lead');
---

<BaseLayout title={title} description={lead} robots="noindex">
  <NoticeBlock tone="danger" eyebrow="404" title={title} lead={lead}>
    <a class="btn btn-gold" slot="actions" href="/">{tDefault('error.home')}</a>
    <a class="btn btn-line" slot="actions" href="/book">{tDefault('nav.book')}</a>
  </NoticeBlock>
</BaseLayout>
