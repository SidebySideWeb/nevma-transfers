---
export const prerender = true;

import { LEGAL_SLUGS, type LegalSlug } from '../lib/sanity/pages';

export async function getStaticPaths() {
  return LEGAL_SLUGS.map((legal) => ({ params: { legal } }));
}

const legal = Astro.params.legal as LegalSlug;
return Astro.redirect(`/legal#${legal}`, 301);
---
