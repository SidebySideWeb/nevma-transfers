---
export const prerender = true;

import PublicLayout from '../layouts/PublicLayout.astro';
import Sections from '../components/sections/Sections.astro';
import { getSiteSettings } from '../lib/sanity/content';
import { getPageBySlug } from '../lib/sanity/pages';
import { organizationJsonLd, resolveSeo, faqPageJsonLd, type FaqItem } from '../lib/seo';

const settings = await getSiteSettings();
const page = await getPageBySlug('home');
const siteUrl = (Astro.site?.href || import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321').replace(
  /\/$/,
  '',
);

const seo = resolveSeo({
  pageTitle: page.title,
  pageSeo: page.seo ?? null,
  settings,
  pathname: '/',
  siteUrl,
});

const faqItems: FaqItem[] = page.sections
  .filter((s) => s._type === 'faq' || s._type === 'faqList')
  .flatMap((s) => {
    if (s._type === 'faq') return s.items;
    const items = (s as { items?: FaqItem[] }).items;
    return items ?? [];
  });

const jsonLd: unknown[] = [organizationJsonLd(settings, siteUrl)];
if (faqItems.length > 0) jsonLd.push(faqPageJsonLd(faqItems));

const hero = page.sections.find((s) => s._type === 'pageHero' || s._type === 'hero');
const preload =
  hero && typeof hero === 'object' && 'image' in hero
    ? (hero.image as import('../lib/sanity/image').SanityImage)
    : undefined;
---

<PublicLayout designPage="01-home" seo={seo} jsonLd={jsonLd} preloadImage={preload}>
  <Sections sections={page.sections} pathname={Astro.url.pathname} />
</PublicLayout>
