---
export const prerender = true;

import PublicLayout from '../../layouts/PublicLayout.astro';
import SiteHeader from '../../components/v2/SiteHeader.astro';
import VehicleTabs from '../../components/v2/VehicleTabs.astro';
import VehicleHero from '../../components/v2/VehicleHero.astro';
import Sections from '../../components/sections/Sections.astro';
import { getPublishableClasses, fleetVehiclePaths } from '../../lib/content/vehicles';
import { isBookingOpen } from '../../lib/booking-open';
import { getSiteSettings } from '../../lib/sanity/content';
import { getPageBySlug } from '../../lib/sanity/pages';
import { fromPriceForClass, getCatalog } from '../../lib/server/catalog';
import { breadcrumbJsonLd, resolveSeo, serviceJsonLd } from '../../lib/seo';
import { t } from '../../lib/strings';
import { buildFleetCards } from '../../lib/v2/fleet-cards';
import { portablePlain } from '../../lib/v2/portable';

export async function getStaticPaths() {
  let classes: Awaited<ReturnType<typeof getPublishableClasses>> = [];
  try {
    classes = await getPublishableClasses();
  } catch (e) {
    console.warn(
      '[fleet] getPublishableClasses failed during getStaticPaths:',
      e instanceof Error ? e.message : e,
    );
  }
  if (!classes.length) {
    console.warn('[fleet] no publishable classes — /fleet/[key] paths empty');
  }
  return fleetVehiclePaths(classes);
}

interface Props {
  cls: Awaited<ReturnType<typeof getPublishableClasses>>[number];
}

const { cls } = Astro.props;
const key = cls.key;
const settings = await getSiteSettings();
const [cat, allClasses, template] = await Promise.all([
  getCatalog(),
  getPublishableClasses().catch(() => [cls]),
  getPageBySlug('vehicle'),
]);
const show = settings.showFromPrices !== false;
const siteUrl = (Astro.site?.href || import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321').replace(
  /\/$/,
  '',
);
const bookingOpen = isBookingOpen();
const phoneHref = `tel:${settings.phone.replace(/[^\d+]/g, '')}`;

const cards = buildFleetCards([cls], cat, show);
const card = cards[0]!;
const hourlyRow = cat.hourly.find((h) => h.classKey === key);
const minHours = hourlyRow?.minHours ?? card.hourlyMin ?? 4;
const transferCents = fromPriceForClass(cat, key);

const photos = (cls.photos ?? [])
  .map((p) => ({
    src: p.url || p.asset?.url || '',
    alt: p.alt || cls.name,
  }))
  .filter((p) => p.src);
if (!photos.length) {
  photos.push({
    src: card.photoUrl || `/images/v2/${key}-street.jpg`,
    alt: cls.name,
  });
}

const preloadPhoto = cls.photos?.[0];
const preloadImage = preloadPhoto
  ? {
      alt: preloadPhoto.alt ?? cls.name,
      asset: preloadPhoto.asset
        ? { ...preloadPhoto.asset, url: preloadPhoto.asset.url ?? undefined }
        : preloadPhoto.url
          ? { url: preloadPhoto.url }
          : null,
    }
  : undefined;

const brand = t('fleet.brand');
const fullLabel = cls.fullName || `${brand} ${cls.name}`;
const blurb = portablePlain(cls.copy) || card.blurb;

const pageSeo = {
  title: cls.seo?.title || `${cls.name} · ${settings.companyName}`,
  description: cls.seo?.description || cls.tagline || undefined,
  noindex: cls.seo?.noindex ?? undefined,
};

const seo = resolveSeo({
  pageTitle: cls.name,
  pageSeo,
  settings,
  pathname: `/fleet/${key}`,
  siteUrl,
});
seo.title = `${cls.name} · ${settings.companyName}`;

const jsonLd = [
  serviceJsonLd({
    name: cls.name,
    description: pageSeo.description ?? undefined,
    url: `${siteUrl}/fleet/${key}`,
    providerName: settings.companyName,
    lowPriceCents: transferCents,
    showPrice: show && transferCents != null,
  }),
  breadcrumbJsonLd(
    [
      { name: t('site.breadcrumb.home'), item: '/' },
      { name: t('nav.fleet'), item: '/fleet' },
      { name: fullLabel },
    ],
    siteUrl,
  ),
];

const primaryHref = bookingOpen
  ? `/book?class=${encodeURIComponent(key)}`
  : `/request-a-transfer?class=${encodeURIComponent(key)}`;

// Escort CTA on the template may use /book?vip=1 — leave as seeded.
---

<PublicLayout designPage="03-vehicle" seo={seo} jsonLd={jsonLd} preloadImage={preloadImage}>
  <section data-block="siteHeader" class="sa5a9f">
    <SiteHeader settings={settings} pathname={`/fleet/${key}`} />
  </section>

  <VehicleTabs classes={allClasses} currentKey={key} currentLabel={fullLabel} />

  <VehicleHero
    name={cls.name}
    kind={cls.tagline || card.kind}
    brand={brand}
    blurb={blurb}
    seats={card.seats}
    luggage={card.luggage}
    airportLabel={t('site.vehicle.airport')}
    airportPrice={card.airportText}
    hourlyLabel={t('site.vehicle.hourly', { hours: minHours })}
    hourlyPrice={card.hourlyText}
    note={t('site.vehicle.note')}
    bookHref={primaryHref}
    bookLabel={t('site.vehicle.book', { name: cls.name })}
    callHref={phoneHref}
    callLabel={t('site.vehicle.call', { phone: settings.phone })}
    photos={photos}
  />

  <Sections sections={template.sections} pathname={`/fleet/${key}`} />
</PublicLayout>
