---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/v2/PageHero.astro';
import PriceTable from '../../components/v2/PriceTable.astro';
import { fleetGroup } from '../../lib/content/fleet-group';
import { getPublishableClasses } from '../../lib/content/vehicles';
import { isBookingOpen } from '../../lib/booking-open';
import { formatEuro } from '../../lib/booking/pricing';
import { getSiteSettings } from '../../lib/sanity/content';
import { getPageBySlug } from '../../lib/sanity/pages';
import {
  fromPriceForClass,
  getCatalog,
  hourlyFromForClass,
} from '../../lib/server/catalog';
import { resolveSeo } from '../../lib/seo';
import { t } from '../../lib/strings';

const settings = await getSiteSettings();
const page = await getPageBySlug('fleet');
const siteUrl = (Astro.site?.href || import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321').replace(
  /\/$/,
  '',
);
const bookingOpen = isBookingOpen();
const show = settings.showFromPrices !== false;

const [classes, cat] = await Promise.all([
  getPublishableClasses().catch(() => []),
  getCatalog().catch(() => null),
]);

const hero = page.sections.find((s) => s._type === 'hero');
const heroImage =
  hero && hero._type === 'hero' ? hero.image?.asset?.url : classes[0]?.photos?.[0]?.url;

const cards = classes.map((cls) => {
  const group = fleetGroup(cls.tagline, cls.name);
  const transfer = cat ? fromPriceForClass(cat, cls.key) : null;
  const hourly = cat ? hourlyFromForClass(cat, cls.key) : null;
  const hourlyRow = cat?.hourly.find((h) => h.classKey === cls.key);
  const minHours = hourlyRow?.minHours ?? 4;
  const photo = cls.photos?.[0];
  return {
    key: cls.key,
    name: cls.name,
    kind: cls.tagline || '',
    group,
    seats: cls.maxPassengers,
    bags: cls.maxLuggage,
    photoUrl: photo?.url ?? null,
    photoAlt: photo?.alt || cls.name,
    airport: show && transfer != null ? formatEuro(transfer) : t('site.noOnlinePrice'),
    hourly: show && hourly != null ? formatEuro(hourly) : t('site.noOnlinePrice'),
    minHours,
  };
});

const vanCount = cards.filter((c) => c.group === 'van').length;
const saloonCount = cards.filter((c) => c.group === 'saloon').length;

const mosaic = classes
  .flatMap((cls) =>
    (cls.photos ?? []).slice(0, 2).map((p, i) => ({
      href: `/fleet/${cls.key}`,
      label: `${cls.name}${i ? ' detail' : ''}`,
      url: p.url,
      wide: i === 0 && cls.key.includes('v-class'),
      tall: false,
    })),
  )
  .filter((m) => m.url)
  .slice(0, 8);

const tableRows = cards.map((c) => ({
  name: c.name,
  href: `/fleet/${c.key}`,
  type: c.kind,
  seats: String(c.seats),
  luggage: String(c.bags),
  airport: c.airport,
  hourly: c.hourly,
  minimum: `${c.minHours} h`,
}));

const bookHref = (key: string) =>
  bookingOpen ? `/book?class=${encodeURIComponent(key)}` : `/request-a-transfer?class=${encodeURIComponent(key)}`;

const accent = t('fleet.accent');
const titleParts = t('fleet.title', { accent }).split(accent);
const insideAccent = t('fleet.inside.accent');
const insideParts = t('fleet.inside.title', { accent: insideAccent }).split(insideAccent);
const compareAccent = t('fleet.compare.accent');
const compareParts = t('fleet.compare.title', { accent: compareAccent }).split(compareAccent);

const seo = resolveSeo({
  pageTitle: page.title,
  pageSeo: page.seo ?? null,
  settings,
  pathname: '/fleet',
  siteUrl,
});

const included = [
  t('fleet.included.chauffeur'),
  t('fleet.included.water'),
  t('fleet.included.ac'),
  t('fleet.included.charging'),
  t('fleet.included.wifi'),
  t('fleet.included.luggage'),
];
---

<BaseLayout seo={seo} heroHeader preloadImage={hero && hero._type === 'hero' ? hero.image : undefined}>
  <PageHero
    settings={settings}
    eyebrow={t('fleet.eyebrow')}
    titleBefore={titleParts[0]}
    titleAccent={accent}
    titleAfter={titleParts[1] ?? ''}
    lead={t('fleet.lead')}
    imageUrl={heroImage}
    class="page-hero--tall"
  />

  <section class="section">
    <div class="wrap stack">
      <div class="row between">
        <div class="fleet-filters" role="tablist" aria-label={t('fleet.filter.label')}>
          <button type="button" class="fleet-filter" role="tab" data-filter="all" aria-selected="true">
            {t('fleet.filter.all')} ({cards.length})
          </button>
          <button type="button" class="fleet-filter" role="tab" data-filter="van" aria-selected="false">
            {t('fleet.filter.vans')} ({vanCount})
          </button>
          <button type="button" class="fleet-filter" role="tab" data-filter="saloon" aria-selected="false">
            {t('fleet.filter.saloons')} ({saloonCount})
          </button>
        </div>
        <p class="muted" style="margin:0">{t('fleet.priceNote')}</p>
      </div>

      <div class="fleet-card-grid" id="fleet-cards">
        {
          cards.map((c) => (
            <article class="fleet-card" data-group={c.group}>
              <a class="fleet-card-media" href={`/fleet/${c.key}`} aria-label={`${c.name} details`}>
                {c.photoUrl ? (
                  <img src={c.photoUrl} alt="" loading="lazy" decoding="async" />
                ) : (
                  <div class="media" aria-hidden="true" />
                )}
                {c.kind ? <span class="fleet-card-kind">{c.kind}</span> : null}
              </a>
              <div class="fleet-card-body">
                <div>
                  <div class="muted">{t('fleet.brand')}</div>
                  <h2 class="display fleet-card-name">{c.name}</h2>
                </div>
                <div class="fleet-card-meta">
                  <span>{t('fleet.seats', { n: c.seats })}</span>
                  <span>{t('fleet.bags', { n: c.bags })}</span>
                </div>
                <div class="fleet-card-prices">
                  <div class="fleet-card-price">
                    <div class="fleet-card-price-label">{t('fleet.airportOneWay')}</div>
                    <div class="fleet-card-price-value">{c.airport}</div>
                  </div>
                  <div class="fleet-card-price">
                    <div class="fleet-card-price-label">{t('fleet.hourlyMin', { hours: c.minHours })}</div>
                    <div class="fleet-card-price-value">{c.hourly}</div>
                  </div>
                </div>
                <div class="fleet-card-actions">
                  <a class="btn btn-line" href={`/fleet/${c.key}`}>
                    {t('fleet.details')}
                  </a>
                  <a class="btn btn-gold" href={bookHref(c.key)}>
                    {bookingOpen ? t('fleet.book') : t('site.requestQuote')}
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    mosaic.length > 0 ? (
      <section class="section">
        <div class="wrap">
          <div class="row between" style="margin-bottom: var(--space-5)">
            <div>
              <p class="eyebrow">{t('fleet.inside.eyebrow')}</p>
              <h2 class="display">
                {insideParts[0]}
                <em>{insideAccent}</em>
                {insideParts[1] ?? ''}
              </h2>
            </div>
            <a class="link-arrow" href={cards[0] ? `/fleet/${cards[0].key}` : '/fleet'}>
              {t('fleet.inside.browse')} →
            </a>
          </div>
          <div class="fleet-mosaic">
            {mosaic.map((m, i) => (
              <a
                class:list={['fleet-mosaic-tile', i % 3 === 0 && 'is-wide', i % 5 === 1 && 'is-tall']}
                href={m.href}
                aria-label={m.label}
              >
                <img src={m.url!} alt="" loading="lazy" decoding="async" />
                <span>{m.label}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ) : null
  }

  <section class="section">
    <div class="wrap stack">
      <div class="row between">
        <div>
          <p class="eyebrow">{t('fleet.compare.eyebrow')}</p>
          <h2 class="display">
            {compareParts[0]}
            <em>{compareAccent}</em>
            {compareParts[1] ?? ''}
          </h2>
        </div>
        <a class="link-arrow" href={bookingOpen ? '/book' : '/request-a-transfer'}>
          {t('fleet.compare.check')} →
        </a>
      </div>
      <PriceTable
        columns={[
          { key: 'name', label: t('fleet.col.vehicle') },
          { key: 'type', label: t('fleet.col.type') },
          { key: 'seats', label: t('fleet.col.seats'), numeric: true },
          { key: 'luggage', label: t('fleet.col.luggage'), numeric: true },
          { key: 'airport', label: t('fleet.col.airport'), numeric: true },
          { key: 'hourly', label: t('fleet.col.hourly'), numeric: true },
          { key: 'minimum', label: t('fleet.col.minimum'), numeric: true },
        ]}
        rows={tableRows}
        footnotes={[
          t('fleet.note.vat'),
          t('fleet.note.airport'),
          t('fleet.note.hourly'),
          t('fleet.note.capacity'),
        ]}
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap band-split">
      <div class="card stack" style="flex: 1 1 28rem; padding: var(--space-6); border: 1px solid var(--color-border); background: var(--color-surface);">
        <p class="eyebrow">{t('fleet.included.eyebrow')}</p>
        <ul class="fleet-included" style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:var(--space-3) var(--space-6);">
          {included.map((item) => (
            <li style="flex: 1 1 12rem;">— {item}</li>
          ))}
        </ul>
      </div>
      <a
        href="/vip-security"
        class="card"
        style="flex: 1 1 22rem; min-height: 16rem; position: relative; display: flex; text-decoration: none; color: inherit; border: 1px solid var(--color-border-strong); overflow: hidden;"
      >
        <div
          style="position:absolute;inset:0;background: linear-gradient(135deg, #121416, #050505);"
          aria-hidden="true"
        />
        <div style="position:relative;margin-top:auto;padding:var(--space-6);display:flex;flex-direction:column;gap:var(--space-2);">
          <p class="eyebrow">{t('fleet.addon.eyebrow')}</p>
          <div class="display" style="font-size: var(--text-xl);">{t('fleet.addon.title')}</div>
          <p class="muted" style="margin:0">{t('fleet.addon.text')}</p>
          <span class="link-arrow">{t('fleet.addon.link')} →</span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.fleet-filter');
  const cards = document.querySelectorAll<HTMLElement>('#fleet-cards .fleet-card');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter || 'all';
      tabs.forEach((t) => t.setAttribute('aria-selected', t === tab ? 'true' : 'false'));
      cards.forEach((card) => {
        const group = card.dataset.group;
        card.hidden = filter !== 'all' && group !== filter;
      });
    });
  });
</script>
