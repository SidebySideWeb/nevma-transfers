---
export const prerender = true;

import RequestReceivedBody from '../../components/v2/status/RequestReceivedBody.astro';
import StatusHero from '../../components/v2/StatusHero.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { FORM_KEYS, isFormKey, type FormKey } from '../../lib/forms/schemas';
import { createSanityClient, sanityConfigured } from '../../lib/sanity/client';
import { getSiteSettings, loadUiStrings } from '../../lib/sanity/content';
import { FORM_BY_KEY_QUERY } from '../../lib/sanity/queries';
import { escapeThenAccent } from '../../lib/v2/accent';
import { t, tAccent } from '../../lib/strings';

export async function getStaticPaths() {
  return FORM_KEYS.map((form) => ({ params: { form } }));
}

const formParam = Astro.params.form || '';
if (!isFormKey(formParam)) {
  throw new Error(`Unknown thank-you form "${formParam}"`);
}
const formKey = formParam as FormKey;

await loadUiStrings();
const settings = await getSiteSettings();

let successTitle = t('form.received.title');
let successMessage = t('form.received.body');

if (sanityConfigured()) {
  try {
    const client = createSanityClient();
    const doc = await client.fetch<{
      successTitle?: string | null;
      successMessage?: string | null;
    } | null>(FORM_BY_KEY_QUERY, { key: formKey });
    if (doc?.successTitle) successTitle = doc.successTitle;
    if (doc?.successMessage) successMessage = doc.successMessage;
  } catch {
    /* keep defaults */
  }
}

const titleHtml =
  successTitle === t('form.received.title')
    ? tAccent('form.received.title')
    : escapeThenAccent(successTitle.includes('*') ? successTitle : successTitle);
---

<PublicLayout
  designPage="13-request-received"
  title={`${successTitle.replace(/\*/g, '')} - ${settings.companyName}`}
  description={successMessage}
  robots="noindex,nofollow"
>
  <StatusHero
    heroClass="s68332"
    eyebrow={t('form.received.eyebrow')}
    titleHtml={titleHtml}
    lead={successMessage}
    pathname={`/thank-you/${formKey}`}
  />
  <RequestReceivedBody phone={settings.phone} />
</PublicLayout>

<script is:inline>
  document.querySelector('[data-block="appHero"] h1')?.focus();
</script>
