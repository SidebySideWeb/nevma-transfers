---
import Heading from '../Heading.astro';
import CtaLink from '../CtaLink.astro';
import { v2ImageSrc } from '../../../lib/v2/image-src';
import type { CtaLinkData } from '../../../lib/v2/cta';
import type { SanityImage } from '../../../lib/sanity/image';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };
type Tile = {
  image?: SanityImage & { _sanityAsset?: string };
  caption?: string;
  size?: string;
  href?: string;
};

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const link = section.link as CtaLinkData | undefined;
const tiles = Array.isArray(section.tiles) ? (section.tiles as Tile[]) : [];

const SIZE_CLASS: Record<string, string> = {
  large: 's36f15',
  wide: 's186d7',
  tall: 'sdc918',
  normal: 'sdc918',
};

/** Design board span classes (02-fleet/03) — correct wrong seed/live sizes by caption. */
const DESIGN_SIZE: Record<string, keyof typeof SIZE_CLASS> = {
  'V-Class · VIP cabin': 'large',
  'S-Class · cabin': 'normal',
  'V-Class · on the road': 'normal',
  'V-Class · captain seats': 'normal',
  'E-Class · rear seats': 'normal',
  'V-Class · lounge': 'wide',
  'S-Class · cockpit': 'normal',
  'Sprinter · seating': 'normal',
};

function tileHref(tile: Tile) {
  const cap = (tile.caption || '').toLowerCase();
  if (/v-?class/i.test(cap)) return '/fleet/v-class';
  if (/vito/i.test(cap)) return '/fleet/vito';
  if (/e-?class/i.test(cap)) return '/fleet/e-class';
  if (/s-?class/i.test(cap)) return '/fleet/s-class';
  if (/sprinter/i.test(cap)) return '/fleet/sprinter';
  return '/fleet/v-class';
}
---

<section data-block="galleryMosaic" class="s0a82a">
  <div class="s3f7d7">
    <div class="sb2770">
      {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
      <Heading heading={heading} variant="inline" as="h2" class="display sd7c6c" />
    </div>
    <CtaLink link={link} class="link-arrow" />
  </div>
  <div class="mosaic">
    {
      tiles.map((tile) => {
        const caption = tile.caption || '';
        const sizeKey = DESIGN_SIZE[caption] || tile.size || 'normal';
        const sizeClass = SIZE_CLASS[sizeKey] || SIZE_CLASS.normal;
        const src = v2ImageSrc(tile.image, '/images/v2/v-class-cabin.jpg');
        const href = tile.href || tileHref(tile);
        return (
          <a href={href} class={`zoom mtile ${sizeClass}`} aria-label={caption}>
            <img class="ph sc22be" src={src} alt="" loading="lazy" decoding="async" />
            <div class="s973aa"></div>
            <span class="s52b1b">{caption}</span>
          </a>
        );
      })
    }
  </div>
</section>
