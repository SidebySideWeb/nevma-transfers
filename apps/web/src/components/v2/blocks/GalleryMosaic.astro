---
/**
 * V2 stub for GalleryMosaic — markup from design/v2/build/blocks/02-fleet/03-galleryMosaic.html.
 * Accepts Sanity `section` for later prompts; design copy kept for fidelity stubs.
 */
interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
void section;
---
<section data-block="galleryMosaic" class="s0a82a">
  <div class="s3f7d7">
    <div class="sb2770">
      <div class="eyebrow">In detail</div>
      <h2 class="display sd7c6c">Inside <em>the fleet</em></h2>
    </div>
    <a class="link-arrow" href="/fleet/v-class">Browse every vehicle →</a>
  </div>
  <div class="mosaic">

      <a href="/fleet/v-class" class="zoom mtile s36f15" aria-label="V-Class · VIP cabin">
        <img class="ph sc22be" src="/images/v2/v-class-cabin.jpg" alt="">
        <div class="s973aa"></div>
        <span class="s52b1b">V-Class · VIP cabin</span>
      </a>

      <a href="/fleet/v-class" class="zoom mtile sdc918" aria-label="S-Class · cabin">
        <img class="ph sc22be" src="/images/v2/s-class-front.jpg" alt="">
        <div class="s973aa"></div>
        <span class="s52b1b">S-Class · cabin</span>
      </a>

      <a href="/fleet/v-class" class="zoom mtile sdc918" aria-label="V-Class · on the road">
        <img class="ph sc22be" src="/images/v2/v-class-drive.jpg" alt="">
        <div class="s973aa"></div>
        <span class="s52b1b">V-Class · on the road</span>
      </a>

      <a href="/fleet/v-class" class="zoom mtile sdc918" aria-label="V-Class · captain seats">
        <img class="ph sc22be" src="/images/v2/v-class-9.jpg" alt="">
        <div class="s973aa"></div>
        <span class="s52b1b">V-Class · captain seats</span>
      </a>

      <a href="/fleet/v-class" class="zoom mtile sdc918" aria-label="E-Class · rear seats">
        <img class="ph sc22be" src="/images/v2/e-class-int.jpg" alt="">
        <div class="s973aa"></div>
        <span class="s52b1b">E-Class · rear seats</span>
      </a>

      <a href="/fleet/v-class" class="zoom mtile s186d7" aria-label="V-Class · lounge">
        <img class="ph sc22be" src="/images/v2/v-class-lounge.jpg" alt="">
        <div class="s973aa"></div>
        <span class="s52b1b">V-Class · lounge</span>
      </a>

      <a href="/fleet/v-class" class="zoom mtile sdc918" aria-label="S-Class · cockpit">
        <img class="ph sc22be" src="/images/v2/s-class-dash.jpg" alt="">
        <div class="s973aa"></div>
        <span class="s52b1b">S-Class · cockpit</span>
      </a>

      <a href="/fleet/v-class" class="zoom mtile sdc918" aria-label="Sprinter · seating">
        <img class="ph sc22be" src="/images/v2/sprinter-1.jpg" alt="">
        <div class="s973aa"></div>
        <span class="s52b1b">Sprinter · seating</span>
      </a>

  </div>
</section>
