---
import Heading from '../Heading.astro';
import { v2ImageSrc } from '../../../lib/v2/image-src';
import type { SanityImage } from '../../../lib/sanity/image';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };
type Card = {
  title?: string;
  text?: string;
  image?: SanityImage & { _sanityAsset?: string };
};

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const cards = Array.isArray(section.cards)
  ? (section.cards as Card[])
  : Array.isArray(section.items)
    ? (section.items as Card[])
    : [];
---

<section data-block="occasions" class="s1eb68">
  <div class="sd890e">
    <div class="s7483a">
      {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
      <Heading heading={heading} variant="inline" as="h2" class="display sd7c6c" />
    </div>
    <div class="sebfdc">
      {
        cards.map((card, i) => (
          <div class="card zoom s29e3f">
            <div class="s5d782">
              <img
                class="ph s58119"
                src={v2ImageSrc(card.image, '/images/v2/chauffeur-hotel.jpg')}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="sac29c">
              <span class="s096bd">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display s9e28e">{card.title ?? ''}</h3>
              <p class="se404f">{card.text ?? ''}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
