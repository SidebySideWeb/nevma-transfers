---
import { getSiteSettings } from '../../../lib/sanity/content';
import { siteWhatsappChrome } from '../../../lib/whatsapp-site';
import WhatsAppIcon from '../WhatsAppIcon.astro';

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const settings = await getSiteSettings();
const wa = siteWhatsappChrome(settings);
const callLabel = typeof section.callLabel === 'string' ? section.callLabel : 'Call · 24/7';
const emailLabel = typeof section.emailLabel === 'string' ? section.emailLabel : 'Email';
const emailNote = typeof section.emailNote === 'string' ? section.emailNote : '';
const officeLabel = typeof section.officeLabel === 'string' ? section.officeLabel : 'Office';
const officeNote = typeof section.officeNote === 'string' ? section.officeNote : '';
const phoneHref = `tel:${settings.phone.replace(/[^\d+]/g, '')}`;
---

<section data-block="contactCards" class="s6def7">
  {
    wa ? (
      <a href={wa.href} class="card s90b27 ep-wa-card" target="_blank" rel="noopener" data-v2-extra>
        <span class="eyebrow">{wa.label}</span>
        <span class="s1a9b3 ep-wa-link">
          <WhatsAppIcon size={18} />
          Message us on WhatsApp
        </span>
      </a>
    ) : null
  }
  <a href={phoneHref} class="card s90b27">
    <span class="eyebrow">{callLabel}</span>
    <span class="s1a9b3">{settings.phone}</span>
    {settings.mobilePhone ? <span class="s33268">{settings.mobilePhone}</span> : null}
  </a>
  <a href={`mailto:${settings.email}`} class="card s90b27">
    <span class="eyebrow">{emailLabel}</span>
    <span class="sdc5f1">{settings.email}</span>
    {emailNote ? <span class="sf0124">{emailNote}</span> : null}
  </a>
  <div class="sc6f3d">
    <span class="eyebrow">{officeLabel}</span>
    <span class="se23c6">{settings.address || ''}</span>
    {officeNote ? <span class="sf0124">{officeNote}</span> : null}
  </div>
</section>
