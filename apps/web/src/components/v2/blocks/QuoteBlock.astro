---
import { bgImage } from '../../../lib/v2/bg-image';
import type { SanityImage } from '../../../lib/sanity/image';

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const raw = typeof section.quote === 'string' ? section.quote.trim() : '';
const quote = raw.replace(/^[“”"']+|[“”"']+$/g, '');
const caption = typeof section.caption === 'string' ? section.caption : '';
const style = bgImage((section.image as SanityImage) ?? null);
---

<section data-block="quoteBlock" class="bgx5 s47064" style={style}>
  <div class="sf222b" aria-hidden="true"></div>
  <div class="sf8d84">
    <div class="s853d3"></div>
    {quote ? <p class="display s947b6">“{quote}”</p> : null}
    {caption ? <div class="eyebrow">{caption}</div> : null}
  </div>
</section>
