---
import Heading from '../Heading.astro';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };
type Col = {
  label?: string;
  eyebrow?: string;
  title?: string;
  items?: string[];
  bullets?: string[];
};

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const columns = Array.isArray(section.columns) ? (section.columns as Col[]) : [];
---

<section data-block="serviceColumns" class="s1eb68">
  <div class="sd890e">
    <div class="sc10bc">
      {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
      <Heading heading={heading} variant="inline" as="h2" class="display sd5a38" />
    </div>
    <div class="sebfdc">
      {
        columns.map((col) => {
          const label = col.eyebrow || col.label || '';
          const bullets = col.bullets ?? col.items ?? [];
          return (
            <div class="s54ac4">
              {label ? <div class="eyebrow sa0fcf">{label}</div> : null}
              <h3 class="display se7c87">{col.title ?? ''}</h3>
              {bullets.map((item) => (
                <div class="s5df80">
                  <span class="sbbc0f">—</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
