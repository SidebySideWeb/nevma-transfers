---
import Heading from '../Heading.astro';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };
type Item = { title?: string; text?: string };

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const layout = typeof section.layout === 'string' ? section.layout : 'band';
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const lead = typeof section.lead === 'string' ? section.lead : '';
const items = Array.isArray(section.items) ? (section.items as Item[]) : [];
const numerals = ['i.', 'ii.', 'iii.', 'iv.', 'v.'] as const;
---

{
  layout === 'section' ? (
    <section data-block="featureTrio" class="s1eb68">
      <div class="s4c22b">
        <div class="sd7476">
          {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
          <Heading heading={heading} variant="inline" as="h2" class="display sd7c6c" />
          {lead ? <p class="sec10d">{lead}</p> : null}
        </div>
        <div class="s19268">
          {items.map((item, i) => (
            <div class="s8f9c4">
              <span class="s8343a">{numerals[i] ?? `${i + 1}.`}</span>
              <div>
                <div class="display s715d2">{item.title ?? ''}</div>
                <div class="s6cb80">{item.text ?? ''}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section data-block="featureTrio" class="s3f7d6">
      {items.map((item, i) => (
        <div class="sf3927">
          <span class="s22fe0">{numerals[i] ?? `${i + 1}.`}</span>
          <h2 class="s0cf6c">{item.title ?? ''}</h2>
          <p class="sec10d">{item.text ?? ''}</p>
        </div>
      ))}
    </section>
  )
}
