---
/**
 * V2 stub for FeaturedRoute — markup from design/v2/build/blocks/04-services/03-featuredRoute.html.
 * Accepts Sanity `section` for later prompts; design copy kept for fidelity stubs.
 */
interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
void section;
---
<section data-block="featuredRoute" class="se6a8d">
  <div class="s95e76">
    <div class="bgx2 sc25c8" role="img" aria-label="S-Class at the airport terminal"></div>
    <div class="sa160b">
      <div class="eyebrow">Featured route · airport transfer</div>
      <h2 class="display sb3db9">Athens International <em>↔</em> Athens</h2>
      <p class="s0a0a6">One-way journeys between AIA and Athens, with luggage assistance and your chauffeur waiting on arrival.</p>
      <div class="sa0f5a">

          <div class="rate"><span class="sd2071">V-Class</span><span class="s1c943">€180</span></div>

          <div class="rate"><span class="sd2071">Vito</span><span class="s1c943">€150</span></div>

          <div class="rate"><span class="sd2071">E-Class</span><span class="s1c943">€150</span></div>

          <div class="rate"><span class="sd2071">S-Class</span><span class="s1c943">€180</span></div>

          <div class="rate"><span class="sd2071">Sprinter</span><span class="s1c943">€180</span></div>

      </div>
      <div class="s6c19a">Prices in euros, exclusive of 24% VAT. Other zones: <a href="/request-a-transfer">request a quote</a>.</div>
      <div class="s4ba17">
        <a class="btn btn-gold" href="/book">Book this route</a>
        <a class="btn btn-line" href="/fleet">Full price list</a>
      </div>
    </div>
  </div>
</section>
