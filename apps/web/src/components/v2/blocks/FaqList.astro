---
/**
 * V2 stub for FaqList — markup from design/v2/build/blocks/04-services/05-faqList.html.
 * Accepts Sanity `section` for later prompts; design copy kept for fidelity stubs.
 */
interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
void section;
---
<section data-block="faqList" class="sacd47">
  <div class="s2e6c9">
    <div class="eyebrow">Good to know</div>
    <h2 class="display sd7c6c">Questions, <em>answered</em></h2>
    <p class="sec10d">Anything else? Call us any time on <a href="tel:+302109706967">+30 210 970 6967</a>.</p>
  </div>
  <div class="sc0251">

      <div>
        <button type="button" class="faq-q" aria-expanded="true"><span>Are the prices final?</span><span class="s70818" aria-hidden="true">−</span></button>
        <p class="s96485">Prices are fixed per vehicle and route, quoted in euros and exclusive of 24% VAT. You see the total before you pay.</p>
      </div>

      <div>
        <button type="button" class="faq-q" aria-expanded="false"><span>Does the airport rate cover a return journey?</span><span class="s70818" aria-hidden="true">+</span></button>

      </div>

      <div>
        <button type="button" class="faq-q" aria-expanded="false"><span>What is the minimum for a chauffeur by the hour?</span><span class="s70818" aria-hidden="true">+</span></button>

      </div>

      <div>
        <button type="button" class="faq-q" aria-expanded="false"><span>How long is my vehicle held while I book?</span><span class="s70818" aria-hidden="true">+</span></button>

      </div>

      <div>
        <button type="button" class="faq-q" aria-expanded="false"><span>Can I add a security escort?</span><span class="s70818" aria-hidden="true">+</span></button>

      </div>

      <div>
        <button type="button" class="faq-q" aria-expanded="false"><span>How do I change or cancel a booking?</span><span class="s70818" aria-hidden="true">+</span></button>

      </div>

  </div>
</section>
