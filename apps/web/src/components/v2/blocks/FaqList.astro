---
import Heading from '../Heading.astro';
import { getSiteSettings } from '../../../lib/sanity/content';
import { faqExpandedAt, faqToggleSign } from '../../../lib/v2/faq-list';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };
type Item = { question?: string; answer?: string; _key?: string };

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const settings = await getSiteSettings();
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const lead = typeof section.lead === 'string' ? section.lead : '';
const showPhone = section.showPhone === true;
const items = Array.isArray(section.items) ? (section.items as Item[]) : [];
const phoneHref = `tel:${settings.phone.replace(/[^\d+]/g, '')}`;
const uid = Math.random().toString(36).slice(2, 8);
---

<section data-block="faqList" class="sacd47" data-faq-list>
  <div class="s2e6c9">
    {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
    <Heading heading={heading} variant="inline" as="h2" class="display sd7c6c" />
    {
      lead || showPhone ? (
        <p class="sec10d">
          {lead ? `${lead} ` : null}
          {showPhone ? <a href={phoneHref}>{settings.phone}</a> : null}
          {showPhone ? '.' : null}
        </p>
      ) : null
    }
  </div>
  <div class="sc0251">
    {
      items.map((item, i) => {
        const open = faqExpandedAt(i);
        const panelId = `faq-${uid}-${i}`;
        return (
          <div data-faq-item>
            <button
              type="button"
              class="faq-q"
              aria-expanded={open ? 'true' : 'false'}
              aria-controls={panelId}
              data-faq-btn
            >
              <span>{item.question ?? ''}</span>
              <span class="s70818" aria-hidden="true" data-faq-sign>
                {faqToggleSign(open)}
              </span>
            </button>
            <p class="s96485" id={panelId} hidden={!open} data-faq-panel>
              {item.answer ?? ''}
            </p>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq-list]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('[data-faq-item]')];
    const paint = (open: number | null) => {
      items.forEach((item, i) => {
        const btn = item.querySelector<HTMLButtonElement>('[data-faq-btn]');
        const panel = item.querySelector<HTMLElement>('[data-faq-panel]');
        const sign = item.querySelector<HTMLElement>('[data-faq-sign]');
        const on = open === i;
        btn?.setAttribute('aria-expanded', String(on));
        if (panel) panel.hidden = !on;
        if (sign) sign.textContent = on ? '−' : '+';
      });
    };
    items.forEach((item, i) => {
      item.querySelector('[data-faq-btn]')?.addEventListener('click', () => {
        const btn = item.querySelector<HTMLButtonElement>('[data-faq-btn]');
        const was = btn?.getAttribute('aria-expanded') === 'true';
        paint(was ? null : i);
      });
    });
  });
</script>
