---
/**
 * V2 stub for DivisionCards — markup from design/v2/build/blocks/01-home/03-divisionCards.html.
 * Accepts Sanity `section` for later prompts; design copy kept for fidelity stubs.
 */
interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
void section;
---
<section data-block="divisionCards" class="sd67c2">
  <div class="s9e1ac">
    <div class="s5e6cc">
      <div class="eyebrow">Two divisions, one standard</div>
      <h2 class="display sa7950">Travel in comfort. <em>Move with protection.</em></h2>
    </div>
    <p class="s94d1d">Luxury vehicles, professional chauffeurs and specialist security teams, coordinated by one office in Athens.</p>
  </div>
  <div class="sebfdc">
    <a href="/fleet" class="card zoom sd07e7">
      <div class="bgx2 ph s22cbe"></div>
      <div class="s40d0c"></div>
      <div class="sbbe77">
        <div class="eyebrow">01 / VIP Transfer</div>
        <div class="display se2257">Luxury travel with a private chauffeur</div>
        <div class="s62156">Mercedes-Benz vans and saloons for airports, hotels, business and private travel.</div>
        <span class="link-arrow seae9b">View the fleet →</span>
      </div>
    </a>
    <a href="/vip-security" class="card zoom sd07e7">
      <div class="bgx3 ph s22cbe"></div>
      <div class="sff762"></div>
      <div class="sbbe77">
        <div class="eyebrow">02 / VIP Security</div>
        <div class="display se2257">Close protection &amp; security escorts</div>
        <div class="s62156">Discreet protection for people, premises and property, on the move or on site.</div>
        <span class="link-arrow seae9b">Discover VIP Security →</span>
      </div>
    </a>
  </div>
</section>
