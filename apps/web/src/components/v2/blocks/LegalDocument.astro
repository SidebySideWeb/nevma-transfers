---
import Heading from '../Heading.astro';
import LegalBody from '../LegalBody.astro';
import { getPageBySlug } from '../../../lib/sanity/pages';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };

interface Props {
  section?: Record<string, unknown>;
  pathname?: string;
}
void Astro.props;

const numerals = ['i.', 'ii.', 'iii.', 'iv.'] as const;
/** Design board order (17-legal). */
const HUB_ORDER = ['terms', 'cancellation', 'privacy', 'cookies'] as const;
const navLabels: Record<string, string> = {
  terms: 'Terms & conditions',
  cancellation: 'Cancellation & refunds',
  privacy: 'Privacy policy',
  cookies: 'Cookies',
};

const docs = await Promise.all(
  HUB_ORDER.map(async (slug) => {
    try {
      const page = await getPageBySlug(slug);
      const doc = page.sections.find((s) => s._type === 'legalDocument') as
        | { heading?: DisplayHeading; body?: unknown }
        | undefined;
      return {
        slug,
        label: navLabels[slug] || page.title,
        heading: doc?.heading,
        body: doc?.body,
      };
    } catch {
      return { slug, label: navLabels[slug] || slug, heading: undefined, body: undefined };
    }
  }),
);
---

<script>
  import '../../../scripts/legal-hub';
</script>

<section data-block="legalDocument" class="s2e203" data-legal-hub>
  <nav class="s71cc6" aria-label="On this page">
    {
      docs.map((d, i) => (
        <a href={`#${d.slug}`} class="toc" data-legal-toc={d.slug}>
          <span class="s0ad5e">{numerals[i] ?? `${i + 1}.`}</span>
          {d.label}
        </a>
      ))
    }
  </nav>
  <div class="s4f684">
    {
      docs.map((d) => (
        <section id={d.slug} class="lsec" data-legal-sec={d.slug}>
          <Heading heading={d.heading} variant="inline" as="h2" class="display sde22b" />
          {d.body ? <LegalBody value={d.body} /> : null}
        </section>
      ))
    }
  </div>
</section>
