---
import { getPublishableClasses } from '../../../lib/content/vehicles';
import { getSiteSettings } from '../../../lib/sanity/content';
import { getCatalog } from '../../../lib/server/catalog';
import { t } from '../../../lib/strings';
import { buildFleetCards, filterCounts } from '../../../lib/v2/fleet-cards';

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const settings = await getSiteSettings();
const show = settings.showFromPrices !== false;
const brand = t('fleet.brand');
const allLabel = typeof section.allLabel === 'string' ? section.allLabel : 'All';
const vansLabel = typeof section.vansLabel === 'string' ? section.vansLabel : 'Vans';
const saloonsLabel = typeof section.saloonsLabel === 'string' ? section.saloonsLabel : 'Saloons';
const note = typeof section.note === 'string' ? section.note : '';
const airportLabel = (
  typeof section.airportLabel === 'string' ? section.airportLabel : 'Airport · one way'
).toUpperCase();
const hourlyLabelTpl =
  typeof section.hourlyLabel === 'string' ? section.hourlyLabel : 'Hourly · min {hours} hours';
const detailsLabel =
  typeof section.detailsLabel === 'string' ? section.detailsLabel : t('fleet.details');
const bookLabel = typeof section.bookLabel === 'string' ? section.bookLabel : t('fleet.book');

let cards: ReturnType<typeof buildFleetCards> = [];
try {
  const [classes, cat] = await Promise.all([getPublishableClasses(), getCatalog()]);
  cards = buildFleetCards(classes, cat, show);
} catch {
  cards = [];
}
const counts = filterCounts(cards);
---

<section data-block="fleetBrowser" class="s46271" data-fleet-browser>
  <div class="sb7c9b">
    <div class="s4ed5d" role="group" aria-label="Filter vehicles">
      <button type="button" class="chip sc6a85" aria-pressed="true" data-filter="all">
        {allLabel}{' '}<span class="s96884">({counts.all})</span>
      </button>
      <button type="button" class="chip s1bc7c" aria-pressed="false" data-filter="van">
        {vansLabel}{' '}<span class="s96884">({counts.vans})</span>
      </button>
      <button type="button" class="chip s1bc7c" aria-pressed="false" data-filter="saloon">
        {saloonsLabel}{' '}<span class="s96884">({counts.saloons})</span>
      </button>
    </div>
    {note ? <div class="s8ad2a">{note}</div> : null}
  </div>
  <div class="sebfdc" data-fleet-grid>
    {
      cards.map((c) => {
        const hourlyLabel = hourlyLabelTpl
          .replaceAll('{hours}', String(c.hourlyMin ?? ''))
          .replace(/^(.*)(hours?)\s*$/i, (_: string, a: string, h: string) => a.toUpperCase() + h.toLowerCase());
        const group = c.group === 'saloon' ? 'saloon' : 'van';
        return (
          <article class="card sd9345" data-group={group}>
            <a href={`/fleet/${c.key}`} class="zoom sfc2ca" aria-label={`${c.name} details`}>
              <img class="ph sc22be" src={c.photoUrl} alt="" loading="lazy" decoding="async" width="640" height="400" />
              <span class="s85b16" aria-hidden="true">{c.kind}</span>
            </a>
            <div class="s4c805">
              <div>
                <div class="sa1347">{brand}</div>
                <h2 class="display sec254">{c.name}</h2>
              </div>
              <div class="s70008">
                <span>
                  <span class="sbbc0f" aria-hidden="true">
                    ◦{' '}
                  </span>
                  {c.seats}
                  {/seat/i.test(c.seats) ? '' : ' seats'}
                </span>
                <span>
                  <span class="sbbc0f" aria-hidden="true">
                    ◦{' '}
                  </span>
                  {c.luggage}
                  {/bag/i.test(c.luggage) ? '' : ' bags'}
                </span>
              </div>
              <div class="s94fe9">
                <div class="s07643">
                  <div class="s8248f">{airportLabel}</div>
                  <div class="s1329b">{c.airportText}</div>
                </div>
                <div class="s2767f">
                  <div class="s8248f">{hourlyLabel}</div>
                  <div class="s1329b">{c.hourlyText}</div>
                </div>
              </div>
              <div class="s6affc">
                <a class="btn btn-line s24f7c" href={`/fleet/${c.key}`}>
                  {detailsLabel}
                </a>
                <a class="btn btn-gold s24f7c" href={`/book?class=${encodeURIComponent(c.key)}`}>
                  {bookLabel}
                </a>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-fleet-browser]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    const paint = (filter: string) => {
      buttons.forEach((btn) => {
        const on = btn.dataset.filter === filter;
        btn.setAttribute('aria-pressed', String(on));
        btn.classList.toggle('sc6a85', on);
        btn.classList.toggle('s1bc7c', !on);
      });
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.group === filter;
        card.hidden = !show;
      });
    };
    buttons.forEach((btn) => btn.addEventListener('click', () => paint(btn.dataset.filter || 'all')));
  });
</script>
