---
/**
 * V2 stub for FleetBrowser — markup from design/v2/build/blocks/02-fleet/02-fleetBrowser.html.
 * Accepts Sanity `section` for later prompts; design copy kept for fidelity stubs.
 */
interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
void section;
---
<section data-block="fleetBrowser" class="s46271">
  <div class="sb7c9b">
    <div class="s4ed5d" role="tablist" aria-label="Filter vehicles">

        <button type="button" role="tab" aria-selected="true" class="chip sc6a85">All <span class="s96884">(5)</span></button>

        <button type="button" role="tab" aria-selected="false" class="chip s1bc7c">Vans <span class="s96884">(3)</span></button>

        <button type="button" role="tab" aria-selected="false" class="chip s1bc7c">Saloons <span class="s96884">(2)</span></button>

    </div>
    <div class="s8ad2a">Prices in euros, exclusive of 24% VAT · Capacity indicative, to be confirmed</div>
  </div>
  <div class="sebfdc">

      <article class="card sd9345">
        <a href="/fleet/v-class" class="zoom sfc2ca" aria-label="V-Class details">
          <img class="ph sc22be" src="/images/v2/v-class-street.jpg" alt="">
          <span class="s85b16">Luxury van</span>
        </a>
        <div class="s4c805">
          <div>
            <div class="sa1347">Mercedes-Benz</div>
            <h2 class="display sec254">V-Class</h2>
          </div>
          <div class="s70008">
            <span><span class="sbbc0f" aria-hidden="true">◦ </span>Up to 7 seats</span>
            <span><span class="sbbc0f" aria-hidden="true">◦ </span>Up to 6 bags</span>
          </div>
          <div class="s94fe9">
            <div class="s07643"><div class="s8248f">AIRPORT · ONE WAY</div><div class="s1329b">€180</div></div>
            <div class="s2767f"><div class="s8248f">HOURLY · MIN 4 hours</div><div class="s1329b">€90</div></div>
          </div>
          <div class="s6affc">
            <a class="btn btn-line s24f7c" href="/fleet/v-class">Details</a>
            <a class="btn btn-gold s24f7c" href="/book">Book</a>
          </div>
        </div>
      </article>

      <article class="card sd9345">
        <a href="/fleet/v-class" class="zoom sfc2ca" aria-label="Vito details">
