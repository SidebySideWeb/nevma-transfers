---
import Heading from '../Heading.astro';
import CtaLink from '../CtaLink.astro';
import { bgImageLazy } from '../../../lib/v2/bg-image';
import { getSiteSettings } from '../../../lib/sanity/content';
import type { CtaLinkData } from '../../../lib/v2/cta';
import type { SanityImage } from '../../../lib/sanity/image';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const settings = await getSiteSettings();
const layout = typeof section.layout === 'string' ? section.layout : 'large';
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const lead = typeof section.lead === 'string' ? section.lead : '';
const primary = section.primary as CtaLinkData | undefined;
const secondary = section.secondary as CtaLinkData | undefined;
const lazy = bgImageLazy(
  (section.image as SanityImage) ?? null,
  960,
  layout === 'compact' ? '/images/v2/brand-facets.jpg' : '/images/v2/chauffeur-hotel.jpg',
);
---

{
  layout === 'escort' ? (
    <section data-block="ctaPanel" class="s3da4c">
      <div class="scf6b4">
        {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
        <Heading heading={heading} variant="inline" as="h2" class="display sb3db9" />
        {lead ? <p class="s0b4ef">{lead}</p> : null}
      </div>
      <div class="s4ba17">
        <CtaLink link={primary} class="btn btn-line" phone={settings.phone} />
        <CtaLink link={secondary} class="btn btn-gold" phone={settings.phone} />
      </div>
    </section>
  ) : layout === 'compact' ? (
    <section data-block="ctaPanel" class="bgx3 s6f967" style={lazy?.style} data-bg-image={lazy?.['data-bg-image']}>
      <div class="sb1820">
        <Heading heading={heading} variant="inline" as="h2" class="display sbbbfc" />
        {(primary || secondary) && (
          <div class="s4ba17">
            <CtaLink link={primary} class="btn btn-line" phone={settings.phone} />
            <CtaLink link={secondary} class="btn btn-gold" phone={settings.phone} />
          </div>
        )}
      </div>
    </section>
  ) : (
    <section data-block="ctaPanel" class="bgx6 s019b3" style={lazy?.style} data-bg-image={lazy?.['data-bg-image']}>
      <div class="sc7e49">
        <div class="sbd96c">
          {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
          <Heading heading={heading} variant="inline" as="h2" class="display sc9e5e" />
          {lead ? <p class="se68f0">{lead}</p> : null}
        </div>
        {(primary || secondary) && (
          <div class="s4ba17">
            <CtaLink link={primary} class="btn btn-gold" phone={settings.phone} />
            <CtaLink link={secondary} class="btn btn-line" phone={settings.phone} />
          </div>
        )}
      </div>
    </section>
  )
}
