---
import SiteHeader from '../SiteHeader.astro';
import Heading from '../Heading.astro';
import CtaLink from '../CtaLink.astro';
import { QuickBooking } from '../QuickBooking';
import { bgImage } from '../../../lib/v2/bg-image';
import { getSiteSettings } from '../../../lib/sanity/content';
import { getCatalog } from '../../../lib/server/catalog';
import { t } from '../../../lib/strings';
import type { CtaLinkData } from '../../../lib/v2/cta';
import type { SanityImage } from '../../../lib/sanity/image';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section, pathname = '/' } = Astro.props;
const settings = await getSiteSettings();
const style = bgImage((section.image as SanityImage) ?? null);
const layout = typeof section.layout === 'string' ? section.layout : 'page';
const isHome = layout === 'home';
const isStatus = layout === 'status';
const headingVariant = isHome ? 'break' : 'inline';
const heading = section.heading as DisplayHeading | undefined;
const primary = section.primary as CtaLinkData | undefined;
const secondary = section.secondary as CtaLinkData | undefined;
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const lead = typeof section.lead === 'string' ? section.lead : '';
const widgetNote = typeof section.widgetNote === 'string' ? section.widgetNote : '';
const showQuick = isHome && section.showQuickBooking === true;

let zones: { code: string; name: string }[] = [];
let hourlyBounds = { minHours: 3, maxHours: 12 };
if (showQuick) {
  try {
    const cat = await getCatalog();
    zones = cat.zones.map((z) => ({ code: z.code, name: z.name }));
    if (cat.hourly.length) {
      hourlyBounds = {
        minHours: Math.min(...cat.hourly.map((h) => h.minHours)),
        maxHours: Math.max(...cat.hourly.map((h) => h.maxHours)),
      };
    }
  } catch {
    zones = [];
  }
}

const quickLabels = {
  form: t('site.quick.label'),
  from: t('site.quick.from'),
  to: t('site.quick.to'),
  hours: t('site.quick.hours'),
  date: t('site.quick.date'),
  time: t('site.quick.time'),
  passengers: t('site.quick.passengers'),
  submit: t('site.quick.submit'),
  swap: t('site.quick.swap'),
  transfer: t('booking.toggle.transfer'),
  hourly: t('booking.toggle.hourly'),
  fewerHours: t('site.quick.fewerHours'),
  moreHours: t('site.quick.moreHours'),
};

// Exact section shell classes from design/v2/build/blocks/*/01-pageHero.html
const pageShell =
  pathname.startsWith('/fleet')
    ? { section: 'bgx1 sc9e46', body: 's7dc06', title: 'display xl s5e154', lead: 's136bc' }
    : pathname.startsWith('/services')
      ? { section: 'bgx1 s8143b', body: 's5a27c', title: 'display xl sec8ab', lead: 's623d6' }
      : pathname.startsWith('/vip-security')
        ? { section: 'bgx1 sd72ff', body: 's5a27c', title: 'display xl sec8ab', lead: 's623d6' }
        : pathname.startsWith('/about')
          ? { section: 'bgx1 s8143b', body: 's5a27c', title: 'display xl sec8ab', lead: 's623d6' }
          : pathname.startsWith('/contact')
            ? { section: 'bgx1 s62dcf', body: 's5a27c', title: 'display xl sec8ab', lead: 's623d6' }
            : pathname.startsWith('/request')
              ? { section: 'bgx1 sebbae', body: 's5a27c', title: 'display xl sec8ab', lead: 's623d6' }
              : isStatus
                ? { section: 'bgx1 s3e822', body: 's5a27c', title: 'display xl sec8ab', lead: 's623d6' }
                : { section: 'bgx1 sc9e46', body: 's7dc06', title: 'display xl s5e154', lead: 's136bc' };
---

{
  isHome ? (
    <section data-block="pageHero" class="bgx1 s17762" style={style}>
      <div class="s01dbe" aria-hidden="true"></div>
      <SiteHeader settings={settings} pathname={pathname} />
      <div class="s94251">
        {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
        <Heading heading={heading} variant={headingVariant} as="h1" class="display xl s680b0" />
        {lead ? <p class="se017e">{lead}</p> : null}
        {(primary || secondary) && (
          <div class="s4ba17">
            <CtaLink link={primary} class="btn btn-gold" phone={settings.phone} arrow />
            <CtaLink link={secondary} class="btn btn-line" phone={settings.phone} />
          </div>
        )}
        {showQuick ? (
          <QuickBooking client:load zones={zones} hourlyBounds={hourlyBounds} labels={quickLabels} />
        ) : null}
        {widgetNote ? <div class="s8ad2a">{widgetNote}</div> : null}
      </div>
    </section>
  ) : (
    <section data-block="pageHero" class={pageShell.section} style={style}>
      <SiteHeader settings={settings} pathname={pathname} />
      <div class={pageShell.body}>
        {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
        <Heading heading={heading} variant="inline" as="h1" class={pageShell.title} />
        {lead ? <p class={pageShell.lead}>{lead}</p> : null}
        {(primary || secondary) && (
          <div class="s4ba17">
            <CtaLink link={primary} class="btn btn-gold" phone={settings.phone} />
            <CtaLink link={secondary} class="btn btn-line" phone={settings.phone} />
          </div>
        )}
      </div>
    </section>
  )
}
