---
import SiteHeader from '../SiteHeader.astro';
import Heading from '../Heading.astro';
import CtaLink from '../CtaLink.astro';
import { SearchWidget } from '../../booking/SearchWidget';
import { bgImage } from '../../../lib/v2/bg-image';
import { getSiteSettings } from '../../../lib/sanity/content';
import { getCatalog } from '../../../lib/server/catalog';
import { getSettings } from '../../../lib/server/settings';
import { t } from '../../../lib/strings';
import type { CtaLinkData } from '../../../lib/v2/cta';
import type { SanityImage } from '../../../lib/sanity/image';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section, pathname = '/' } = Astro.props;
const settings = await getSiteSettings();
const style = bgImage((section.image as SanityImage) ?? null);
const layout = typeof section.layout === 'string' ? section.layout : 'page';
const isHome = layout === 'home';
const heading = section.heading as DisplayHeading | undefined;
const primary = section.primary as CtaLinkData | undefined;
const secondary = section.secondary as CtaLinkData | undefined;
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const lead = typeof section.lead === 'string' ? section.lead : '';
const widgetNote = typeof section.widgetNote === 'string' ? section.widgetNote : '';
const showQuick = isHome && section.showQuickBooking === true;
const path = pathname.replace(/\/$/, '') || '/';

// Build-time values for the home search widget; the widget falls back to its own defaults.
let hourBounds = { min: 3, max: 12 };
let minLeadMinutes: number | undefined;
let timezone: string | undefined;
if (showQuick) {
  try {
    const cat = await getCatalog();
    if (cat.hourly.length) {
      hourBounds = {
        min: Math.min(...cat.hourly.map((h) => h.minHours)),
        max: Math.max(...cat.hourly.map((h) => h.maxHours)),
      };
    }
  } catch {
    /* defaults */
  }
  try {
    const settings = await getSettings();
    minLeadMinutes = settings.minLeadMinutes;
    timezone = settings.timezone;
  } catch {
    /* defaults */
  }
}

// Popular routes are fetched by the widget from /api/routes/featured on first focus.
const widgetStrings = {
  tabRoute: t('booking.toggle.oneWay'),
  tabHour: t('booking.toggle.hourly'),
  pickup: t('booking.pickup.address'),
  dropoff: t('booking.dropoff.address'),
  date: t('booking.date'),
  time: t('booking.time'),
  duration: t('booking.hours.duration'),
  flight: t('booking.flight'),
  flightPlaceholder: t('form.placeholder.flight'),
  viewOptions: t('booking.search.viewOptions'),
  popularRoutes: t('booking.routes.suggest'),
};

type Shell = {
  section: string;
  body: string;
  title: string;
  lead: string;
  overlay?: boolean;
  wrap?: boolean;
  badge24?: boolean;
};
const shell: Shell =
  path === '/fleet' || path.startsWith('/fleet/')
    ? { section: 'bgx1 sc9e46', body: 's7dc06', title: 'display xl s5e154', lead: 's136bc' }
    : path === '/services' || path.startsWith('/routes/')
      ? { section: 'bgx1 s8143b', body: 's5a27c', title: 'display xl sec8ab', lead: 's623d6' }
      : path === '/vip-security'
        ? {
            section: 'bgx1 sd72ff',
            body: 's3c3b2',
            title: 'display xl sc91ee',
            lead: 's97892',
            overlay: true,
            wrap: true,
          }
        : path === '/about'
          ? { section: 'bgx1 s8143b', body: 's5a27c', title: 'display xl sec8ab', lead: 's97596' }
          : path === '/contact'
            ? {
                section: 'bgx1 s62dcf',
                body: 's04068',
                title: 'display xl s4c1b2',
                lead: '',
                badge24: true,
              }
            : path === '/request-a-transfer' || path === '/legal' || layout === 'status'
              ? { section: 'bgx1 sebbae', body: 'sd5030', title: 'display sc0a7a', lead: 's97596' }
              : { section: 'bgx1 sc9e46', body: 's7dc06', title: 'display xl s5e154', lead: 's136bc' };

if (path === '/legal') {
  shell.section = 'bgx1 s3e822';
}
---

{
  isHome ? (
    <section data-block="pageHero" class="bgx1 s17762" style={style}>
      <div class="s01dbe" aria-hidden="true"></div>
      <SiteHeader settings={settings} pathname={pathname} />
      <div class="s94251">
        {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
        <Heading heading={heading} variant="break" as="h1" class="display xl s680b0" />
        {lead ? <p class="se017e">{lead}</p> : null}
        {(primary || secondary) && (
          <div class="s4ba17">
            <CtaLink link={primary} class="btn btn-gold" phone={settings.phone} arrow />
            <CtaLink link={secondary} class="btn btn-line" phone={settings.phone} />
          </div>
        )}
        {showQuick ? (
          <SearchWidget
            client:load
            mode="home"
            strings={widgetStrings}
            hourBounds={hourBounds}
            minLeadMinutes={minLeadMinutes}
            timezone={timezone}
            addressAutocomplete={import.meta.env.PUBLIC_ADDRESS_AUTOCOMPLETE === 'true'}
          />
        ) : null}
        {widgetNote ? <div class="s8ad2a">{widgetNote}</div> : null}
      </div>
    </section>
  ) : path === '/contact' ? (
    <section data-block="pageHero" class={shell.section} style={style}>
      <SiteHeader settings={settings} pathname={pathname} />
      <div class={shell.body}>
        <div class="s78dd1">
          {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
          <Heading heading={heading} variant="inline" as="h1" class={shell.title} />
        </div>
        <div class="sf4c12">24/7</div>
      </div>
    </section>
  ) : path === '/vip-security' ? (
    <section data-block="pageHero" class={shell.section} style={style}>
      <div class="s33db2" aria-hidden="true"></div>
      <SiteHeader settings={settings} pathname={pathname} />
      <div class={shell.body}>
        <div class="s482c6">
          {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
          <Heading heading={heading} variant="inline" as="h1" class={shell.title} />
          {lead ? <p class={shell.lead}>{lead}</p> : null}
          {(primary || secondary) && (
            <div class="s4ba17">
              <CtaLink link={primary} class="btn btn-gold" phone={settings.phone} />
              <CtaLink link={secondary} class="btn btn-line" phone={settings.phone} />
            </div>
          )}
        </div>
      </div>
    </section>
  ) : (
    <section data-block="pageHero" class={shell.section} style={style}>
      <SiteHeader settings={settings} pathname={pathname} />
      <div class={shell.body}>
        {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
        <Heading heading={heading} variant="inline" as="h1" class={shell.title} />
        {lead && shell.lead ? <p class={shell.lead}>{lead}</p> : null}
        {(primary || secondary) && (
          <div class="s4ba17">
            <CtaLink link={primary} class="btn btn-gold" phone={settings.phone} />
            <CtaLink link={secondary} class="btn btn-line" phone={settings.phone} />
          </div>
        )}
      </div>
    </section>
  )
}
