---
import SiteHeader from '../SiteHeader.astro';
import Heading from '../Heading.astro';
import CtaLink from '../CtaLink.astro';
import { bgImage } from '../../../lib/v2/bg-image';
import { getSiteSettings } from '../../../lib/sanity/content';
import type { CtaLinkData } from '../../../lib/v2/cta';
import type { SanityImage } from '../../../lib/sanity/image';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section, pathname = '/' } = Astro.props;
const settings = await getSiteSettings();
const style = bgImage((section.image as SanityImage) ?? null);
const isHome = section.layout === 'home';
const headingVariant = isHome ? 'break' : 'inline';
const heading = section.heading as DisplayHeading | undefined;
const primary = section.primary as CtaLinkData | undefined;
const secondary = section.secondary as CtaLinkData | undefined;
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const lead = typeof section.lead === 'string' ? section.lead : '';
const widgetNote = typeof section.widgetNote === 'string' ? section.widgetNote : '';
---

<section data-block="pageHero" class="bgx1 s17762" style={style}>
  <div class="s01dbe" aria-hidden="true"></div>
  <SiteHeader settings={settings} pathname={pathname} />
  <div class="s94251">
    {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
    <Heading
      heading={heading}
      variant={headingVariant}
      as="h1"
      class="display xl s680b0"
    />
    {lead ? <p class="se017e">{lead}</p> : null}
    {(primary || secondary) && (
      <div class="s4ba17">
        <CtaLink link={primary} class="btn btn-gold" phone={settings.phone} arrow={isHome} />
        <CtaLink link={secondary} class="btn btn-line" phone={settings.phone} />
      </div>
    )}
    {
      section.showQuickBooking ? (
        <form class="s70eaa" aria-label="Quick booking" action="/book" method="get">
          <div class="field s2f216">
            <label for="q-from">From</label>
            <input id="q-from" name="from" type="text" />
          </div>
          <div class="sc5f4a" data-v2-extra>
            <button type="button" class="swap" aria-label="Swap pick-up and drop-off">⇄</button>
          </div>
          <div class="field s2f216">
            <label for="q-to">To</label>
            <input id="q-to" name="to" type="text" />
          </div>
          <div class="field s984cb">
            <label for="q-date">Date</label>
            <input id="q-date" name="date" type="date" />
          </div>
          <div class="field s10827">
            <label for="q-time">Time</label>
            <input id="q-time" name="time" type="time" value="14:30" />
          </div>
          <div class="field s87a0c">
            <label for="q-pax">Passengers</label>
            <input id="q-pax" name="passengers" type="number" min="1" value="2" />
          </div>
          <button class="btn btn-gold sc27fa" type="submit">See prices</button>
        </form>
      ) : null
    }
    {widgetNote ? <div class="s8ad2a">{widgetNote}</div> : null}
  </div>
</section>
