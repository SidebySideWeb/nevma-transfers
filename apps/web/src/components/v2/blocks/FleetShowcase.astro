---
import Heading from '../Heading.astro';
import { getPublishableClasses } from '../../../lib/content/vehicles';
import { getSiteSettings } from '../../../lib/sanity/content';
import { getCatalog } from '../../../lib/server/catalog';
import { t } from '../../../lib/strings';
import { buildFleetShowcaseCards } from '../../../lib/v2/fleet-showcase';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const settings = await getSiteSettings();
const show = settings.showFromPrices !== false;
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const lead = typeof section.lead === 'string' ? section.lead : '';
const compareLabel = typeof section.compareLabel === 'string' ? section.compareLabel : '';
const bookLabelTpl =
  typeof section.bookLabel === 'string' ? section.bookLabel : t('site.vehicle.book');
const detailsLabel =
  typeof section.detailsLabel === 'string' ? section.detailsLabel : t('site.viewVehicle');
const footnote = typeof section.footnote === 'string' ? section.footnote : '';

let cards: ReturnType<typeof buildFleetShowcaseCards> = [];
try {
  const [classes, cat] = await Promise.all([getPublishableClasses(), getCatalog()]);
  cards = buildFleetShowcaseCards(classes, cat, show);
} catch {
  cards = [];
}

const active = cards[0];
const brand = t('fleet.brand');
const seatsLabel = t('site.vehicle.seats');
const luggageLabel = t('site.vehicle.luggage');
const bookLabel = active ? bookLabelTpl.replaceAll('{name}', active.name) : bookLabelTpl;
const payload = {
  brand,
  seatsLabel,
  luggageLabel,
  bookLabelTpl,
  detailsLabel,
  footnote,
  cards,
};
---

<section data-block="fleetShowcase" class="s82488" data-fleet-showcase>
  <div class="s248d4">
    <div class="sc9439">
      {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
      <Heading heading={heading} variant="inline" as="h2" class="display sd7c6c" />
      {lead ? <p class="sdd144">{lead}</p> : null}
      <div class="sd1014" role="tablist" aria-label="Vehicles">
        {
          cards.map((c, i) => (
            <button
              type="button"
              role="tab"
              class:list={['tab', i === 0 ? 's832a0' : 's0a350']}
              aria-selected={i === 0 ? 'true' : 'false'}
              id={`fleet-tab-${c.key}`}
              tabindex={i === 0 ? 0 : -1}
            >
              <span>{c.name}</span>
              <span class:list={[i === 0 ? 's153f6' : 's1f839']}>{c.kind}</span>
            </button>
          ))
        }
      </div>
      {
        compareLabel ? (
          <a class="link-arrow s51a69" href="/fleet">
            {compareLabel}
          </a>
        ) : null
      }
    </div>
    {
      active ? (
        <div class="s5353d">
          <div class="sd154e" role="tabpanel" aria-label={active.name} data-fleet-panel>
            <img
              class="sc22be"
              data-fleet-photo
              src={active.photoUrl}
              alt={active.photoAlt}
              loading="lazy"
              decoding="async"
            />
            <div class="s097ed"></div>
            <div class="se7ae6">
              <div class="s7e901">{brand}</div>
              <div class="display sc2da6" data-fleet-name>
                {active.name}
              </div>
            </div>
            {active.kind ? (
              <span class="seaf9a" data-fleet-kind>
                {active.kind}
              </span>
            ) : null}
          </div>
          <div class="s11d2b">
            {active.blurb ? (
              <p class="s0a0a6" data-fleet-blurb>
                {active.blurb}
              </p>
            ) : (
              <p class="s0a0a6" data-fleet-blurb hidden></p>
            )}
            <div class="se7b68">
              <div class="s19e3e">
                <div class="s36738">{seatsLabel.toUpperCase()}</div>
                <div class="sda08d" data-fleet-seats>
                  {active.seats}
                </div>
              </div>
              <div class="s19e3e">
                <div class="s36738">{luggageLabel.toUpperCase()}</div>
                <div class="sda08d" data-fleet-luggage>
                  {active.luggage}
                </div>
              </div>
              <div class="s19e3e">
                <div class="s36738">AIRPORT</div>
                <div class="sfd829" data-fleet-airport>
                  {active.airportText}
                </div>
              </div>
              <div class="s19e3e">
                <div class="s36738">HOURLY</div>
                <div class="sfd829" data-fleet-hourly>
                  {active.hourlyText}
                  {active.hourlyMin != null ? (
                    <span class="sd26cd">{` /h · min ${active.hourlyMin}h`}</span>
                  ) : null}
                </div>
              </div>
            </div>
            <div class="s8dac8">
              <a
                class="btn btn-gold"
                data-fleet-book
                href={`/book?class=${encodeURIComponent(active.key)}`}
              >
                {bookLabel}
              </a>
              <a class="btn btn-line" data-fleet-details href={`/fleet/${active.key}`}>
                {detailsLabel}
              </a>
              {footnote ? <span class="s6c19a">{footnote}</span> : null}
            </div>
          </div>
        </div>
      ) : null
    }
  </div>
</section>
<script type="application/json" data-fleet-json id="fleet-showcase-json" set:html={JSON.stringify(payload)} />

<script>
  type Card = {
    key: string;
    name: string;
    kind: string;
    blurb: string;
    seats: string;
    luggage: string;
    airportText: string;
    hourlyText: string;
    hourlyMin: number | null;
    photoUrl: string;
    photoAlt: string;
  };

  document.querySelectorAll<HTMLElement>('[data-fleet-showcase]').forEach((root) => {
    const raw =
      document.getElementById('fleet-showcase-json')?.textContent ||
      root.parentElement?.querySelector('[data-fleet-json]')?.textContent;
    if (!raw) return;
    const data = JSON.parse(raw) as {
      brand: string;
      bookLabelTpl: string;
      cards: Card[];
    };
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = root.querySelector<HTMLElement>('[data-fleet-panel]');
    const photo = root.querySelector<HTMLImageElement>('[data-fleet-photo]');
    const nameEl = root.querySelector<HTMLElement>('[data-fleet-name]');
    const kindEl = root.querySelector<HTMLElement>('[data-fleet-kind]');
    const blurbEl = root.querySelector<HTMLElement>('[data-fleet-blurb]');
    const seatsEl = root.querySelector<HTMLElement>('[data-fleet-seats]');
    const luggageEl = root.querySelector<HTMLElement>('[data-fleet-luggage]');
    const airportEl = root.querySelector<HTMLElement>('[data-fleet-airport]');
    const hourlyEl = root.querySelector<HTMLElement>('[data-fleet-hourly]');
    const bookEl = root.querySelector<HTMLAnchorElement>('[data-fleet-book]');
    const detailsEl = root.querySelector<HTMLAnchorElement>('[data-fleet-details]');

    const paint = (i: number) => {
      const card = data.cards[i];
      if (!card) return;
      tabs.forEach((tab, n) => {
        const on = n === i;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        tab.classList.toggle('s832a0', on);
        tab.classList.toggle('s0a350', !on);
        const kind = tab.querySelector('span:last-child');
        if (kind) {
          kind.classList.toggle('s153f6', on);
          kind.classList.toggle('s1f839', !on);
        }
      });
      if (panel) panel.setAttribute('aria-label', card.name);
      if (photo) {
        photo.src = card.photoUrl;
        photo.alt = card.photoAlt;
      }
      if (nameEl) nameEl.textContent = card.name;
      if (kindEl) kindEl.textContent = card.kind;
      if (blurbEl) {
        blurbEl.textContent = card.blurb;
        blurbEl.hidden = !card.blurb;
      }
      if (seatsEl) seatsEl.textContent = card.seats;
      if (luggageEl) luggageEl.textContent = card.luggage;
      if (airportEl) airportEl.textContent = card.airportText;
      if (hourlyEl) {
        hourlyEl.replaceChildren(document.createTextNode(card.hourlyText));
        if (card.hourlyMin != null) {
          const span = document.createElement('span');
          span.className = 'sd26cd';
          span.textContent = ` /h · min ${card.hourlyMin}h`;
          hourlyEl.appendChild(span);
        }
      }
      if (bookEl) {
        bookEl.href = `/book?class=${encodeURIComponent(card.key)}`;
        bookEl.textContent = data.bookLabelTpl.replaceAll('{name}', card.name);
      }
      if (detailsEl) detailsEl.href = `/fleet/${card.key}`;
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => paint(i));
      tab.addEventListener('keydown', (e) => {
        let next = i;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = Math.min(tabs.length - 1, i + 1);
        else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = Math.max(0, i - 1);
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        else return;
        e.preventDefault();
        paint(next);
        tabs[next]?.focus();
      });
    });
  });
</script>
