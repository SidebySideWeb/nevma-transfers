---
interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const items = Array.isArray(section.items)
  ? (section.items as { value?: string; label?: string }[])
  : [];
---

<section data-block="statsBar" class="sec1a0">
  <div class="s68fe7">
    {
      items.map((item) => (
        <div class="s74f77">
          <span class="sa8f1c">{item.value ?? ''}</span>
          <span class="scf940">{item.label ?? ''}</span>
        </div>
      ))
    }
  </div>
</section>
