---
/**
 * V2 stub for PriceTable — markup from design/v2/build/blocks/02-fleet/04-priceTable.html.
 * Accepts Sanity `section` for later prompts; design copy kept for fidelity stubs.
 */
interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
void section;
---
<section data-block="priceTable" class="se45c2">
  <div class="s3f7d7">
    <div class="sb2770">
      <div class="eyebrow">Price list 2026</div>
      <h2 class="display sd7c6c">Compare <em>at a glance</em></h2>
    </div>
    <a class="link-arrow" href="/book">Check availability →</a>
  </div>
  <div class="s7dde3">
    <table class="s2124b">
      <thead>
        <tr class="s36792">
          <th scope="col" class="th s6599c">Vehicle</th>
          <th scope="col" class="th s6599c">Type</th>
          <th scope="col" class="th">Seats*</th>
          <th scope="col" class="th">Luggage*</th>
          <th scope="col" class="th">Airport (AIA – Athens)</th>
          <th scope="col" class="th">Hourly</th>
          <th scope="col" class="th">Minimum</th>
        </tr>
      </thead>
      <tbody>

          <tr class="tr">
            <th class="s5b02e" scope="row"><span class="sd7eda">V-Class</span></th>
            <td class="scbd5b">Luxury van</td>
            <td class="s6f570">Up to 7</td>
            <td class="s6f570">Up to 6</td>
            <td class="s9f31a">€180</td>
            <td class="s9f31a">€90</td>
            <td class="sf5000">4 hours</td>
          </tr>

          <tr class="tr">
            <th class="s5b02e" scope="row"><span class="sd7eda">Vito</span></th>
            <td class="scbd5b">Van</td>
            <td class="s6f570">Up to 8</td>
            <td class="s6f570">Up to 6</td>
            <td class="s9f31a">€150</td>
            <td class="s9f31a">€70</td>
            <td class="sf5000">4 hours</td>
          </tr>

          <tr class="tr">
            <th class="s5b02e" scope="row"><span class="sd7eda">E-Class</span></th>
            <td class="scbd5b">Saloon</td>
            <td class="s6f570">Up to 3</td>
            <td class="s6f570">Up to 2</td>
            <td class="s9f31a">€150</td>
            <td class="s9f31a">€60</td>
            <td class="sf5000">3 hours</td>
          </tr>

          <tr class="tr">
            <th class="s5b02e" scope="row"><span class="sd7eda">S-Class</span></th>
            <td class="scbd5b">Executive saloon</td>
            <td class="s6f570">Up to 3</td>
            <td class="s6f570">Up to 2</td>
            <td class="s9f31a">€180</td>
            <td class="s9f31a">€90</td>
            <td class="sf5000">4 hours</td>
          </tr>

          <tr class="tr">
            <th class="s5b02e" scope="row"><span class="sd7eda">Sprinter</span></th>
            <td class="scbd5b">VIP van</td>
            <td class="s6f570">Up to 12</td>
            <td class="s6f570">Up to 10</td>
            <td class="s9f31a">€180</td>
            <td class="s9f31a">€90</td>
            <td class="sf5000">4 hours</td>
          </tr>

      </tbody>
    </table>
  </div>
  <div class="s182f1">
    <span>All prices in euros, <strong class="sd01f5">exclusive of 24% VAT</strong></span>
    <span>Airport rates are <strong class="sd01f5">one-way</strong> between AIA and Athens</span>
    <span>Minimum hours apply to <strong class="sd01f5">hourly chauffeur services</strong></span>
    <span>*Capacity indicative, to be confirmed</span>
  </div>
</section>
