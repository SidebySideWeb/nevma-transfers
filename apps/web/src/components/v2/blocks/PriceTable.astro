---
import Heading from '../Heading.astro';
import CtaLink from '../CtaLink.astro';
import { getPublishableClasses } from '../../../lib/content/vehicles';
import { getSiteSettings } from '../../../lib/sanity/content';
import { getCatalog } from '../../../lib/server/catalog';
import { buildFleetCards } from '../../../lib/v2/fleet-cards';
import { portableNotesHtml } from '../../../lib/v2/portable';
import type { CtaLinkData } from '../../../lib/v2/cta';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const settings = await getSiteSettings();
const show = settings.showFromPrices !== false;
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const link = section.link as CtaLinkData | undefined;
const columns = (section.columns || {}) as Record<string, string>;
const notesHtml = portableNotesHtml(section.notes);

let cards: ReturnType<typeof buildFleetCards> = [];
try {
  const [classes, cat] = await Promise.all([getPublishableClasses(), getCatalog()]);
  cards = buildFleetCards(classes, cat, show);
} catch {
  cards = [];
}
---

<section data-block="priceTable" class="se45c2">
  <div class="s3f7d7">
    <div class="sb2770">
      {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
      <Heading heading={heading} variant="inline" as="h2" class="display sd7c6c" />
    </div>
    <CtaLink link={link} class="link-arrow" />
  </div>
  <div class="s7dde3" tabindex="0" role="region" aria-label="Price comparison table">
    <table class="s2124b">
      <thead>
        <tr class="s36792">
          <th scope="col" class="th s6599c">{columns.vehicle || 'Vehicle'}</th>
          <th scope="col" class="th s6599c">{columns.type || 'Type'}</th>
          <th scope="col" class="th">{columns.seats || 'Seats*'}</th>
          <th scope="col" class="th">{columns.luggage || 'Luggage*'}</th>
          <th scope="col" class="th">{columns.airport || 'Airport'}</th>
          <th scope="col" class="th">{columns.hourly || 'Hourly'}</th>
          <th scope="col" class="th">{columns.minimum || 'Minimum'}</th>
        </tr>
      </thead>
      <tbody>
        {
          cards.map((c) => (
            <tr class="tr">
              <th class="s5b02e" scope="row">
                <span class="sd7eda">{c.name}</span>
              </th>
              <td class="scbd5b">{c.kind}</td>
              <td class="s6f570">{c.seats}</td>
              <td class="s6f570">{c.luggage}</td>
              <td class="s9f31a">{c.airportText}</td>
              <td class="s9f31a">{c.hourlyText}</td>
              <td class="sf5000">{c.hourlyMin != null ? `${c.hourlyMin} hours` : ''}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="s182f1">
    {notesHtml.map((html) => <span set:html={html} />)}
  </div>
</section>
