---
import Heading from '../Heading.astro';
import CtaLink from '../CtaLink.astro';
import { bgImageLazy } from '../../../lib/v2/bg-image';
import { getSiteSettings } from '../../../lib/sanity/content';
import type { CtaLinkData } from '../../../lib/v2/cta';
import type { SanityImage } from '../../../lib/sanity/image';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const settings = await getSiteSettings();
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const lead = typeof section.lead === 'string' ? section.lead : '';
const body = typeof section.body === 'string' ? section.body : '';
const primary = section.primary as CtaLinkData | undefined;
const secondary = section.secondary as CtaLinkData | undefined;
const image = section.image as SanityImage | undefined;
const lazy = bgImageLazy(image ?? null);
const alt = image?.alt?.trim() || '';
---

<section data-block="clientsBlock" class="s3a297">
  <div class="zoom se477e">
    <div class="bgx2 ph s22cbe" role="img" aria-label={alt} style={lazy?.style} data-bg-image={lazy?.['data-bg-image']}></div>
  </div>
  <div class="sed1a9">
    {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
    <Heading heading={heading} variant="inline" as="h2" class="display sd7c6c" />
    {lead ? <p class="s0a0a6">{lead}</p> : null}
    {body ? <p class="s0a0a6">{body}</p> : null}
    <div class="s9e984">
      <CtaLink link={primary} class="btn btn-gold" phone={settings.phone} />
      <CtaLink link={secondary} class="btn btn-line" phone={settings.phone} />
    </div>
  </div>
</section>
