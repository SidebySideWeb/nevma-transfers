---
import Heading from '../Heading.astro';
import { getSiteSettings } from '../../../lib/sanity/content';
import { getCatalog } from '../../../lib/server/catalog';
import {
  bookingOptionPriceLabels,
  fillBookingOptionNote,
} from '../../../lib/v2/booking-options';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };
type Option = { title?: string; text?: string; priceNote?: string };

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const settings = await getSiteSettings();
const show = settings.showFromPrices !== false;
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const options = Array.isArray(section.options) ? (section.options as Option[]) : [];
const indexMark = (i: number) => String(i + 1).padStart(2, '0');

let labels = { fromTransfer: '—', fromHourly: '—' };
try {
  const cat = await getCatalog();
  labels = bookingOptionPriceLabels(cat, show);
} catch {
  /* leave em dash */
}
---

<section data-block="bookingOptions" class="s12ef3">
  <div class="s177b7">
    {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
    <Heading heading={heading} variant="inline" as="h2" class="display sd5a38" />
  </div>
  <div class="s061fa">
    {
      options.map((opt, i) => (
        <div class="card s3a1c8">
          <span class="sbfcc8">{indexMark(i)}</span>
          <h3 class="s0f85e">{opt.title ?? ''}</h3>
          <p class="se404f">{opt.text ?? ''}</p>
          <span class="s7e51b">{fillBookingOptionNote(opt.priceNote || '', labels)}</span>
        </div>
      ))
    }
  </div>
</section>
