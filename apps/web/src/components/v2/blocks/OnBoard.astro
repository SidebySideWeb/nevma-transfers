---
import Heading from '../Heading.astro';
import { bgImageLazy } from '../../../lib/v2/bg-image';
import type { SanityImage } from '../../../lib/sanity/image';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const layout = typeof section.layout === 'string' ? section.layout : 'feature';
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const lead = typeof section.lead === 'string' ? section.lead : '';
const badgeValue = typeof section.badgeValue === 'string' ? section.badgeValue : '';
const badgeLabel = typeof section.badgeLabel === 'string' ? section.badgeLabel : '';
const image = section.image as SanityImage | undefined;
const lazy = bgImageLazy(image ?? null);
const alt = image?.alt?.trim() || '';
const items = Array.isArray(section.items)
  ? (section.items as { title?: string; text?: string }[])
  : [];
---

{
  layout === 'grid' ? (
    <section data-block="onBoard" class="s1eb68">
      <div class="s34860">
        <div class="s7de52">
          {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
          <Heading heading={heading} variant="inline" as="h2" class="display scf6e9" />
        </div>
        <div class="se5eaa">
          {items.map((item) => (
            <div class="se204f">
              <div class="s5e37e">{item.title ?? ''}</div>
              <div class="s63bcf">{item.text ?? ''}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : layout === 'feature' ? (
    <section data-block="onBoard" class="s3a297">
      <div class="zoom s3dc7c">
        <div class="bgx4 ph s22cbe" role="img" aria-label={alt} style={lazy?.style} data-bg-image={lazy?.['data-bg-image']}></div>
        {(badgeValue || badgeLabel) && (
          <div class="s08b2e">
            {badgeValue ? <div class="sc9672">{badgeValue}</div> : null}
            {badgeLabel ? <div class="s65fce">{badgeLabel.toUpperCase()}</div> : null}
          </div>
        )}
      </div>
      <div class="s0720f">
        {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
        <Heading heading={heading} variant="inline" as="h2" class="display sd7c6c" />
        {lead ? <p class="s0a0a6">{lead}</p> : null}
        <div class="se2175">
          {items.map((item, i) => (
            <div class="sf6d2c">
              <span class="sca7d9">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <div class="scf594">{item.title ?? ''}</div>
                <div class="sf0124">{item.text ?? ''}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section data-block="onBoard" class="s3a297">
      <div class="s0720f">
        {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
        <Heading heading={heading} variant="inline" as="h2" class="display sd7c6c" />
        {lead ? <p class="s0a0a6">{lead}</p> : null}
        <div class="se2175">
          {items.map((item, i) => (
            <div class="sf6d2c">
              <span class="sca7d9">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <div class="scf594">{item.title ?? ''}</div>
                <div class="sf0124">{item.text ?? ''}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
