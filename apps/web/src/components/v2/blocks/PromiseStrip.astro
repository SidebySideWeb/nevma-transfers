---
interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const items = Array.isArray(section.items)
  ? (section.items as { mark?: string; title?: string; text?: string }[])
  : [];
---

<section data-block="promiseStrip" class="s719f1">
  <div class="s7fcf3">
    {
      items.map((item) => (
        <div class="sb1dd8">
          <span class="s41d3e" aria-hidden="true">
            {item.mark ?? ''}
          </span>
          <div>
            <div class="s5cd0d">{item.title ?? ''}</div>
            <div class="s8ad2a">{item.text ?? ''}</div>
          </div>
        </div>
      ))
    }
  </div>
</section>
