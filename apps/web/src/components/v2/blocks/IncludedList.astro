---
import { bgImageLazy } from '../../../lib/v2/bg-image';
import { resolveCtaHref, resolveCtaLabel, type CtaLinkData } from '../../../lib/v2/cta';
import type { SanityImage } from '../../../lib/sanity/image';

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const items = Array.isArray(section.items) ? (section.items as string[]) : [];
const addOnLabel = typeof section.addOnLabel === 'string' ? section.addOnLabel : '';
const addOnTitle = typeof section.addOnTitle === 'string' ? section.addOnTitle : '';
const addOnText = typeof section.addOnText === 'string' ? section.addOnText : '';
const addOnLink = section.addOnLink as CtaLinkData | undefined;
const image = section.image as SanityImage | undefined;
const lazy = bgImageLazy(image ?? null);
const href = resolveCtaHref(addOnLink);
const linkLabel = resolveCtaLabel(addOnLink);
---

<section data-block="includedList" class="s82488">
  <div class="sebfdc">
    <div class="s52f59">
      {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
      <div class="se8466">
        {
          items.map((item) => (
            <div class="s53e3f">
              <span class="sbbc0f">—</span>
              <span>{item}</span>
            </div>
          ))
        }
      </div>
    </div>
    <a href={href} class="card zoom s3078d">
      <div class="bgx2 ph s22cbe" style={lazy?.style} data-bg-image={lazy?.['data-bg-image']}></div>
      <div class="s5bfdd"></div>
      <div class="s4f9a1">
        {addOnLabel ? <div class="eyebrow">{addOnLabel}</div> : null}
        {addOnTitle ? <div class="display se47a0">{addOnTitle}</div> : null}
        {addOnText ? <div class="s331e6">{addOnText}</div> : null}
        {linkLabel ? <span class="link-arrow s147c5">{linkLabel}</span> : null}
      </div>
    </a>
  </div>
</section>
