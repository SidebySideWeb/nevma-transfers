---
import Heading from '../Heading.astro';

type DisplayHeading = { before?: string | null; accent?: string | null; after?: string | null };
const NUMERALS = ['i.', 'ii.', 'iii.', 'iv.'] as const;

interface Props {
  section: Record<string, unknown>;
  pathname?: string;
}
const { section } = Astro.props;
const eyebrow = typeof section.eyebrow === 'string' ? section.eyebrow : '';
const heading = section.heading as DisplayHeading | undefined;
const steps = Array.isArray(section.steps)
  ? (section.steps as { title?: string; text?: string }[])
  : [];
const typography = (s: string) => s.replace(/'/g, '\u2019');
---

<section data-block="howItWorks" class="s1eb68">
  <div class="sd890e">
    <div class="s9cad5">
      {eyebrow ? <div class="eyebrow">{eyebrow}</div> : null}
      <Heading heading={heading} variant="inline" as="h2" class="display sd7c6c" />
    </div>
    <ol class="s5bce6">
      {
        steps.map((step, i) => (
          <li class="s0b704">
            <span class="s2a2be">{NUMERALS[i] ?? `${i + 1}.`}</span>
            <span class="s6a7cc">{typography(step.title ?? '')}</span>
            <span class="s63bcf">{typography(step.text ?? '')}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
