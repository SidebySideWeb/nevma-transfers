---
/**
 * Legal portable text with design `ph` class on placeholder paragraphs ([…to be supplied]).
 */
interface Props {
  value: unknown;
}

type Span = { text?: string; marks?: string[]; _key?: string };
type MarkDef = { _key?: string; _type?: string; href?: string };
type Block = {
  _type?: string;
  style?: string;
  children?: Span[];
  markDefs?: MarkDef[];
};

const { value } = Astro.props;
const blocks = (Array.isArray(value) ? value : []) as Block[];

function linkHref(span: Span, defs: MarkDef[]): string | null {
  const linkMark = (span.marks ?? []).find((m) => defs.some((d) => d._key === m && d._type === 'link'));
  if (!linkMark) return null;
  return defs.find((d) => d._key === linkMark)?.href || null;
}
---

{
  blocks.map((block) => {
    if (block._type !== 'block') return null;
    const defs = block.markDefs ?? [];
    const plain = (block.children ?? []).map((c) => c?.text ?? '').join('');
    const ph = /^\s*\[/.test(plain);
    const parts = (block.children ?? []).map((span) => {
      const text = span.text ?? '';
      const href = linkHref(span, defs);
      const strong = (span.marks ?? []).includes('strong');
      let node: unknown = text;
      if (strong) node = <strong>{text}</strong>;
      if (href) node = <a href={href}>{node}</a>;
      return node;
    });
    if (block.style === 'h3') return <h3>{parts}</h3>;
    return ph ? <p class="ph">{parts}</p> : <p>{parts}</p>;
  })
}
