---
interface Props {
  items: Array<{ label: string; detail?: string; done?: boolean; current?: boolean }>;
}

const { items } = Astro.props;
---

<ol class="v2-timeline">
  {
    items.map((item) => (
      <li
        class:list={[
          'v2-timeline-item',
          item.done && 'is-done',
          item.current && 'is-current',
        ]}
      >
        <span class="v2-timeline-dot" aria-hidden="true" />
        <div>
          <div class="v2-timeline-label">{item.label}</div>
          {item.detail ? <div class="muted">{item.detail}</div> : null}
        </div>
      </li>
    ))
  }
</ol>
