---
import type { SiteSettings } from '../lib/sanity/content';
import { t } from '../lib/strings';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const phoneHref = `tel:${settings.phone.replace(/[^\d+]/g, '')}`;
const mobile = settings.mobilePhone;
const mobileHref = mobile ? `tel:${mobile.replace(/[^\d+]/g, '')}` : null;
const year = new Date().getFullYear();
const nav = [
  { href: '/fleet', label: t('nav.fleet') },
  { href: '/services', label: t('nav.services') },
  { href: '/vip-security', label: t('nav.vipSecurity') },
  { href: '/about', label: t('nav.about') },
  { href: '/contact', label: t('nav.contact') },
];
---

<footer class="site-footer">
  <div class="wrap site-footer-grid">
    <div class="site-footer-brand">
      <img src="/logo-white.png" alt="" width="180" height="64" />
      {settings.tagline ? <p class="muted">{settings.tagline}</p> : null}
    </div>
    <div class="site-footer-col">
      <div class="eyebrow">{t('site.footer.transfers')}</div>
      <a href="/fleet">{t('nav.fleet')}</a>
      <a href="/services">{t('nav.services')}</a>
      <a href="/book">{t('nav.book')}</a>
      <a href="/booking/find">{t('lookup.title')}</a>
    </div>
    <div class="site-footer-col">
      <div class="eyebrow">{t('site.footer.company')}</div>
      <a href="/vip-security">{t('nav.vipSecurity')}</a>
      <a href="/about">{t('nav.about')}</a>
      <a href="/contact">{t('nav.contact')}</a>
    </div>
    <div class="site-footer-col site-footer-contact">
      <div class="eyebrow">{t('site.footer.247')}</div>
      <a href={phoneHref}>{settings.phone}</a>
      {mobile && mobileHref ? <a href={mobileHref}>{mobile}</a> : null}
      <a class="accent" href={`mailto:${settings.email}`}>{settings.email}</a>
    </div>
  </div>
  <div class="wrap site-footer-bar">
    <nav aria-label={t('site.nav.footer')}>
      {
        nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>
    <div>{`© ${year} ${settings.companyName} · ${t('site.pricesIncludeVat')}`}</div>
    <nav aria-label={t('site.nav.legal')}>
      <a href="/legal#terms">{t('site.legal.terms')}</a>
      <a href="/legal#privacy">{t('site.legal.privacy')}</a>
      <a href="/legal#cookies">{t('site.legal.cookies')}</a>
      <a href="/legal#cancellation">{t('site.legal.cancellation')}</a>
      <button type="button" class="btn-text">{t('site.cookieSettings')}</button>
    </nav>
  </div>
</footer>
