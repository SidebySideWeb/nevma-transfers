---
import type { SiteSettings } from '../lib/sanity/content';
import { isBookingOpen } from '../lib/booking-open';
import { t } from '../lib/strings';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const phoneHref = `tel:${settings.phone.replace(/[^\d+]/g, '')}`;
const bookingOpen = isBookingOpen();
const path = Astro.url.pathname;
const nav = [
  { href: '/fleet', label: t('nav.fleet'), match: '/fleet' },
  { href: '/services', label: t('nav.services'), match: '/services' },
  { href: '/vip-security', label: t('nav.vipSecurity'), match: '/vip-security' },
  { href: '/about', label: t('nav.about'), match: '/about' },
  { href: '/contact', label: t('nav.contact'), match: '/contact' },
];
---

<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="logo" href="/" aria-label={`${settings.companyName} home`}>
      <img src="/logo-white.png" alt="Elite Protection" width="160" height="52" />
    </a>
    <nav class="main-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.match) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <a class="header-phone hide-m" href={phoneHref}>{settings.phone}</a>
      {bookingOpen ? (
        <a class="btn btn-gold hide-m" href="/book">{t('nav.book')}</a>
      ) : null}
      <details class="mobile-menu">
        <summary aria-label={t('nav.menu')}>☰</summary>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path.startsWith(item.match) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          {bookingOpen ? (
            <li>
              <a class="btn btn-gold" href="/book">{t('nav.book')}</a>
            </li>
          ) : null}
        </ul>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menu) {
    const summary = menu.querySelector('summary');
    menu.addEventListener('toggle', () => {
      if (menu.open) {
        const first = menu.querySelector<HTMLElement>('ul a');
        first?.focus();
      } else {
        summary?.focus();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
  }
</script>
