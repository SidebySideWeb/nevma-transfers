---
import type { SiteSettings } from '../lib/sanity/content';
import { isBookingOpen } from '../lib/booking-open';
import { t } from '../lib/strings';

interface Props {
  settings: SiteSettings;
  /** Soft border over a photo hero. */
  overlay?: boolean;
}

const { settings, overlay = false } = Astro.props;
const phoneHref = `tel:${settings.phone.replace(/[^\d+]/g, '')}`;
const bookingOpen = isBookingOpen();
const path = Astro.url.pathname;

function isActive(match: string): boolean {
  if (match === '/fleet') return path === '/fleet' || path.startsWith('/fleet/');
  if (match === '/services') return path === '/services' || path.startsWith('/routes/');
  return path === match || path.startsWith(`${match}/`);
}

const nav = [
  { href: '/fleet', label: t('nav.fleet'), match: '/fleet' },
  { href: '/services', label: t('nav.services'), match: '/services' },
  { href: '/vip-security', label: t('nav.vipSecurity'), match: '/vip-security' },
  { href: '/about', label: t('nav.about'), match: '/about' },
  { href: '/contact', label: t('nav.contact'), match: '/contact' },
];

const primaryCta = bookingOpen
  ? { href: '/book', label: t('nav.book') }
  : { href: '/request-a-transfer', label: t('site.requestQuote') };
---

<header class:list={['site-header', overlay && 'site-header--overlay']}>
  <div class="wrap site-header-inner">
    <a class="logo" href="/" aria-label={`${settings.companyName} home`}>
      <img src="/logo-white.png" alt="" width="160" height="52" />
    </a>
    <nav class="main-nav" aria-label={t('site.nav.main')}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.match) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <a class="header-phone hide-m" href={phoneHref}>{settings.phone}</a>
      <a class="btn btn-gold hide-m" href={primaryCta.href}>{primaryCta.label}</a>
      <details class="mobile-menu">
        <summary>{t('nav.menu')}</summary>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.match) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="btn btn-gold" href={primaryCta.href}>{primaryCta.label}</a>
          </li>
        </ul>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menu) {
    const summary = menu.querySelector('summary');
    menu.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('a') && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
  }
</script>
