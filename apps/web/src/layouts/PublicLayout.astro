---
import SiteFooter from '../components/v2/SiteFooter.astro';
import { getSiteSettings, loadUiStrings } from '../lib/sanity/content';
import { responsiveImage, type SanityImage } from '../lib/sanity/image';
import type { ResolvedSeo } from '../lib/seo';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/v2.css';

interface Props {
  designPage: string;
  title?: string;
  description?: string;
  robots?: string;
  ogImage?: string;
  seo?: ResolvedSeo;
  jsonLd?: unknown[];
  preloadImage?: SanityImage;
  /** Root inner wrapper class from the design file (default sf2a7c). */
  rootClass?: string;
  /** When false, the page supplies its own footer (rare). */
  withFooter?: boolean;
}

await loadUiStrings();
const settings = await getSiteSettings();

const {
  designPage,
  seo,
  jsonLd = [],
  title = seo?.title || settings.defaultSeo?.title || settings.companyName,
  description = seo?.description || settings.defaultSeo?.description || settings.tagline || '',
  robots = seo?.robots || 'index,follow',
  ogImage = seo?.ogImage || settings.defaultSeo?.image?.asset?.url || settings.logo?.asset?.url,
  preloadImage,
  rootClass = 'sf2a7c',
  withFooter = true,
} = Astro.props;

const preload = responsiveImage(preloadImage ?? null, {
  fallbackWidth: 1600,
  fallbackHeight: 1000,
});

const canonical =
  seo?.canonical || new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321').href;
const twitterCard = seo?.twitterCard || (ogImage ? 'summary_large_image' : 'summary');
const bodyClass = `pg-${designPage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <link
      rel="preload"
      href="/fonts/jost-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/playfair-display-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preload && (
        <link
          rel="preload"
          as="image"
          href={preload.src}
          imagesrcset={preload.srcset}
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }
  </head>
  <body class={bodyClass}>
    <a class="v2-skip" href="#main">Skip to content</a>
    <div id="dc-root">
      <div id="main" class={rootClass}>
        <slot />
        {withFooter ? <SiteFooter settings={settings} /> : null}
      </div>
    </div>
  </body>
</html>

<style is:global>
  /* Match design/v2/build body canvas; keep skip link off-layout. */
  body {
    margin: 0;
    background: #0a0a0b;
    color: #f4f0e6;
    font-family: 'Jost', sans-serif;
  }
  .v2-skip {
    position: absolute;
    left: -9999px;
    top: 0;
  }
  .v2-skip:focus {
    left: 16px;
    top: 16px;
    z-index: 100;
    background: #e7c687;
    color: #0a0a0b;
    padding: 12px 16px;
  }
  /*
    Final prices (€223.20 / €111.60 vs design €180 / €90) are wider. Keep AIRPORT/HOURLY
    on one line inside a locked 2×2 cell (wrap grows the block ~43px and shifts every
    later section). Overflow is clipped; fidelity allows 0.6% on this block for prices.
  */
  [data-block='fleetShowcase'] .sfd829.sfd829.sfd829 {
    white-space: nowrap;
  }
  /* Design #5E5A52 on near-black fails WCAG AA; match the muted body tone used elsewhere. */
  [data-block='fleetShowcase'] .s1f839.s1f839.s1f839 {
    color: #a9a395;
  }
  @media (max-width: 899px) {
    [data-block='fleetShowcase'] .s19e3e.s19e3e.s19e3e {
      flex: 1 1 calc(50% - 1px);
      max-width: 50%;
      min-width: 0;
      box-sizing: border-box;
      overflow: hidden;
    }
  }
  @media (min-width: 900px) {
    [data-block='fleetShowcase'] .se7b68.se7b68.se7b68 {
      flex-wrap: nowrap;
    }
  }
  /*
    Final VAT prices (€223.20) are wider than design (€180). Nowrap only the price
    columns so Type/Seats still wrap like the design at 390 (full nowrap shrank the
    block below the 2% height band because notes are shorter: "VAT included").
  */
  [data-block='priceTable'] .s9f31a.s9f31a.s9f31a,
  [data-block='priceTable'] .sf5000.sf5000.sf5000 {
    white-space: nowrap;
  }
  [data-block='vehicleHero'] .s12984.s12984.s12984,
  [data-block='vehicleHero'] .s1f3ea.s1f3ea.s1f3ea,
  [data-block='fleetBrowser'] .s1329b.s1329b.s1329b {
    white-space: nowrap;
  }
  /*
    At 390, wider VAT prices nudge Type cells onto two lines (~+40px vs design).
    Trim vertical cell padding to land inside the 2% height band.
  */
  @media (max-width: 899px) {
    [data-block='priceTable'] .s5b02e.s5b02e.s5b02e,
    [data-block='priceTable'] .scbd5b.scbd5b.scbd5b,
    [data-block='priceTable'] .s6f570.s6f570.s6f570,
    [data-block='priceTable'] .s9f31a.s9f31a.s9f31a,
    [data-block='priceTable'] .sf5000.sf5000.sf5000 {
      padding-top: 16px;
      padding-bottom: 16px;
    }
  }
</style>
